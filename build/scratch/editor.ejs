<!doctype html>
<html lang="zh-cn"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>OneByOne Scratch 编辑器</title>
<style>
html,body,#app{height:100%;width:100%;margin:0;overflow:hidden}
/* Keep Scratch's native file/edit/title controls; account and cloud belong to OneByOne. */
[class*="menu-bar_menu-bar_"]{height:48px!important;padding-right:264px;background:#4c97ff!important;background-image:none!important}
[class*="menu-bar_menu-bar-item_"]{height:48px!important}
[class*="menu-bar_menu-bar-menu_"]{margin-top:48px!important}
[class*="menu-bar_main-menu_"]{min-width:0;gap:8px!important}
[class*="menu-bar_file-group_"]{gap:0!important}
[class*="menu-bar_growable_"]{min-width:40px;max-width:360px!important}
[class*="menu-bar_account-info-group_"],[class*="menu-bar_community-button-wrapper_"],[class*="menu-bar_feedback-link_"]{display:none!important}
[class*="menu-bar_collapsible-label_"]{display:inline!important}
[class*="menu-bar_menu-bar_"] a[href^="http"]{display:none!important}
[data-onebyone-mode="thumbnail"] [class*="stage-header_stage-menu-wrapper_"]{visibility:hidden}
.onebyone-import-confirm{max-width:430px;width:calc(100% - 48px);box-sizing:border-box;padding:24px;border:1px solid #cbdcf5;border-radius:18px;color:#243752;background:#fff;font-family:"PingFang SC","Microsoft YaHei",sans-serif;box-shadow:0 15px 60px #17345633}
.onebyone-import-confirm::backdrop{background:#142d4b66}
.onebyone-import-confirm h2{font-size:20px;margin:0 0 16px}
.onebyone-import-confirm p{font-size:15px;line-height:1.65;margin:0 0 12px}
.onebyone-import-confirm>div{display:flex;gap:12px;justify-content:flex-end;margin-top:20px}
.onebyone-import-confirm button{min-height:44px;padding:9px 16px;border:1px solid #cbdcf5;border-radius:11px;background:#edf4ff;color:#2868c5;font-size:15px;font-weight:600;cursor:pointer}
.onebyone-import-confirm button[data-confirm]{background:#2563eb;color:white;border-color:#2563eb}
.onebyone-import-confirm button:focus-visible{outline:3px solid #8cb8fa;outline-offset:3px}
@media(max-width:600px){[class*="menu-bar_menu-bar_"]{width:100vw!important;max-width:100vw;padding-right:150px}[class*="menu-bar_menu-bar-item_"]{padding-left:5px!important;padding-right:5px!important}[class*="menu-bar_file-group_"] img{display:none}[class*="menu-bar_main-menu_"]{gap:3px!important}[class*="menu-bar_divider_"]{display:none}}
</style>
</head><body><div id="app">正在加载 Scratch 编辑器…</div></body></html>
