# Admit two submissions while keeping the total sandbox execution budget at two.
# One submission uses one execution slot so another learner can keep judging.
concurrency: 2
singleTaskParallelism: 1
hosts:
  localhost:
    type: hydro
    server_url: ${HYDRO_JUDGE_SERVER_URL}
    uname: ${HYDRO_JUDGE_USERNAME}
    password: ${HYDRO_JUDGE_PASSWORD}
    concurrency: 2
    detail: full
