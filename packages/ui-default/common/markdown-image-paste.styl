.markdown-image-paste
  color: #8895a7
  font-size: 12px
  font-weight: 400
  line-height: 1.7
  margin-top: 8px
  min-width: 0

  &__hint
    margin: 0
    font-size: 12px
    color: inherit

    &.is-notice
      color: #a65d30

  &__row
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 8px 12px
    background: #f5f7fc
    border: 1px solid #e6e9f3
    border-radius: 9px
    padding: 9px 12px
    margin-top: 8px
    color: #6e65a2

    > span
      flex: 1 1 150px
      overflow-wrap: anywhere

    progress
      width: 90px
      height: 5px
      accent-color: #8967d2

    button
      border: 0
      background: transparent
      padding: 4px
      font: inherit
      color: #7560ad
      cursor: pointer

      &:focus-visible
        outline: 2px solid #b69cdf
        outline-offset: 2px

    &.is-error
      background: #fff8f1
      border-color: #efddcc
      color: #ab713d

  &__previews
    display: flex
    align-items: center
    gap: 10px
    flex-wrap: wrap
    margin-top: 9px

    img
      display: block
      width: 72px
      height: 54px
      object-fit: contain
      border-radius: 7px
      border: 1px solid #e8e3f0
      background: #faf9fc
