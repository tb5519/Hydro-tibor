    cursor: default
  .teacher-broadcast-student__state
    font-size: 11px
    color: #95a0ad
    flex-shrink: 0
    &.is-online
      color: #4a8a72

.teacher-broadcast-overlay
  position: fixed
  inset: 0
  z-index: 2147481000
  display: grid
  grid-template-rows: minmax(0, 1fr) auto
  overflow: hidden
  isolation: isolate
  background: #e9edf2
  overscroll-behavior: none

.teacher-broadcast-viewport
  position: relative
  min-width: 0
  min-height: 0
  overflow: hidden
  touch-action: none

.teacher-broadcast-stage
  position: absolute
  transform-origin: top left
  overflow: hidden
  background: #fff
  box-shadow: 0 0 30px #273a4910

.teacher-broadcast-loading
  position: absolute
  inset: 0
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  gap: 12px
  padding: 24px
