    color: #329578

.live-share-overlay, .live-share-picker, .live-share-notice
  font-family: var(--font-family, "PingFang SC", "Microsoft YaHei", sans-serif)
  color: #263c54
  &, *
    box-sizing: border-box
  [hidden]
    display: none !important
  button, input
    font: inherit
  button
    cursor: pointer
  button:focus-visible, input:focus-visible
    outline: 3px solid #a6c2df
    outline-offset: 3px

.live-share-overlay
  position: fixed
  inset: 0
  z-index: 950
  background: #e9edf2
  overflow: hidden
  isolation: isolate

.live-share-viewport
  position: absolute
  inset: 0
  overflow: auto
  overscroll-behavior: contain
  outline: 0
  &.is-pan-ready
    cursor: grab
  &.is-panning
    cursor: grabbing
    user-select: none

.live-share-surface
  position: relative
  // Contain the unscaled layout box; only the scaled surface should scroll.
  overflow: hidden

.live-share-stage
  position: absolute
  transform-origin: top left
  background: #fff
  overflow: hidden
  box-shadow: 0 0 40px #23394f15

.live-share-zoom
  position: absolute
  z-index: 6
  left: calc(16px + env(safe-area-inset-left, 0px))
  bottom: calc(16px + env(safe-area-inset-bottom, 0px))
  display: flex
  flex-direction: column-reverse
  align-items: flex-start
  gap: 7px
  &__bar
    display: flex
    align-items: center
    padding: 4px
    border: 1px solid #d8e1ea
    border-radius: 13px
    background: #fffffff2
    box-shadow: 0 3px 16px #23394f17
    backdrop-filter: blur(12px)
    button
      height: 32px
      border: 0
      border-radius: 8px
      background: transparent
      color: #50677b
      line-height: 1
      &:hover
        background: #edf2f6
      &:disabled
        opacity: .35
        cursor: default
  &__step
    width: 32px
    font-size: 21px !important
  &__value
    min-width: 54px
    padding: 0 6px
    font-size: 12px !important
    font-variant-numeric: tabular-nums
  &__fit
    margin-left: 5px
    padding: 0 10px
    font-size: 12px !important
    &[aria-pressed="true"]
      color: #34765f
      background: #edf7f1
  &__hint
    padding: 4px 9px
    border-radius: 7px
    color: #647a8e
    background: #ffffffe6
    font-size: 11px
    pointer-events: none

.live-share-mirror, .live-share-editors
  position: absolute
  inset: 0
  width: 100%
  height: 100%

.live-share-editors
  pointer-events: none
  z-index: 2
  > *
    pointer-events: auto

.live-share-mirror
  .replayer-wrapper, .replayer-wrapper > iframe
    border: 0
    display: block
  .replayer-mouse
    display: none

.live-share-remote-pointer
  width: 12px
  height: 12px
  border: 1.5px solid #ffffffed
  border-radius: 50%
  box-sizing: border-box
  background: #4a91ebbb
  box-shadow: 0 0 0 3px #77b5ff28, 0 1px 5px #15457632
  transform: translate(-50%, -50%)
  transition: left 65ms linear, top 65ms linear
  pointer-events: none !important
  user-select: none

.live-share-overlay.is-disconnected
  .live-share-mirror, .live-share-editors
    pointer-events: none

.live-share-status
  position: absolute
  z-index: 5
  left: 50%
  bottom: calc(12px + env(safe-area-inset-bottom, 0px))
  transform: translateX(-50%)
  max-width: calc(100% - 32px)
  padding: 10px 18px
  border: 1px solid #dce6ef
  border-radius: 12px
  background: #fffffff5
  color: #546d85
  font-size: 13px
  box-shadow: 0 4px 22px #243b5312
  pointer-events: none
  &.is-blocking
    top: 45%
    bottom: auto
    padding: 20px 28px
    font-size: 15px

.teacher-share-controls
  position: fixed
  z-index: 2147482400
  right: unquote('max(14px, env(safe-area-inset-right))')
  top: 50%
  transform: translateY(-50%)
  width: 184px
  max-width: calc(100vw - 24px)
  padding: 14px
  border: 1px solid #dce8e4
  border-radius: 18px
  background: #fffffff5
  box-shadow: 0 8px 32px #253f4520, 0 2px 8px #253f450a
  color: #304c50
  font-family: var(--font-family, "PingFang SC", "Microsoft YaHei", sans-serif)
  font-size: 13px
  line-height: 1.5
  text-align: left
  &, *
    box-sizing: border-box
  &[hidden], [hidden]
    display: none !important
  svg
    width: 18px
    height: 18px
    flex: 0 0 18px
    fill: none
    stroke: currentColor
    stroke-width: 1.6
    stroke-linecap: round
    stroke-linejoin: round
  button
    appearance: none
    font: inherit
    cursor: pointer
    transition: background .15s, border-color .15s
    &:focus-visible
      outline: 3px solid #9ecfbe
      outline-offset: 3px
    &:disabled
      cursor: default
      opacity: .48
  &__heading
    display: flex
    align-items: center
    justify-content: space-between
    min-height: 24px
  &__mode
    display: flex
    align-items: center
    gap: 6px
    font-size: 11px
    color: #75918b
    &:before
      content: ''
      width: 6px
      height: 6px
      border-radius: 50%
      background: #5ba78e
  &__name.live-share-controls__name
    display: block
    overflow: hidden
    white-space: nowrap
    text-overflow: ellipsis
    margin: 3px 0 0
    color: #2b4547
    font-size: 15px
    font-weight: 600
    line-height: 1.6
  &__status
    display: block
    margin-top: 2px
    color: #829692
    font-size: 11px
    line-height: 1.6
    overflow-wrap: anywhere
  &__choose
    display: grid
    place-items: center
    width: 28px
    height: 26px
    margin: -2px -6px -2px 0
    border: 0
    border-radius: 7px
    background: transparent
    color: #78988d
    &:hover
      background: #eef6f2
  &__switch, &__end
    display: flex
    align-items: center
    justify-content: center
    gap: 7px
    width: 100%
    min-height: 38px
    padding: 8px 4px
    border-radius: 10px
    font-weight: 500 !important
  &__switch
    margin-top: 12px
    border: 1px solid #cfe2da
    background: #eef7f3
    color: #397b65
    &:hover:not(:disabled)
      border-color: #a9cdbd
      background: #e5f3eb
  &__end
    margin-top: 6px
    border: 1px solid transparent
    color: #a57979
    background: transparent
    &:hover:not(:disabled)
      background: #fff2f1
      color: #a85e5e
  &__picker
    position: absolute
    right: calc(100% + 10px)
    top: 0
    width: 216px
    padding: 10px
    border: 1px solid #dce8e4
    border-radius: 16px
    background: #fff
    box-shadow: 0 8px 28px #253f4520
  &__picker-heading
    padding: 4px 7px 8px
    font-size: 11px
    color: #829692
  &__students
    max-height: unquote('min(320px, 45vh)')
    overflow: auto
    overscroll-behavior: contain
  &__student
    display: flex
    align-items: center
    gap: 8px
    width: 100%
    min-height: 40px
    padding: 8px
    border: 0
    border-radius: 9px
    background: transparent
    color: #375750
    text-align: left
    &:hover:not(:disabled)
      background: #edf6f2
    > span
      flex: 1
      min-width: 0
      overflow: hidden
      text-overflow: ellipsis
      white-space: nowrap
    > i
      width: 6px
      height: 6px
      flex: 0 0 6px
      border-radius: 50%
      background: #5ba78e
      &.is-offline
        background: #b5c1bd
    > small
      color: #879b95
      font-size: 10px
  &.is-busy .teacher-share-controls__mode:before
    background: #c7a36d

@media (max-width: 480px)
  .teacher-share-controls
    right: unquote('max(10px, env(safe-area-inset-right))')
    width: 166px
    padding: 11px
    &__picker
      right: 0
      top: auto
      bottom: calc(100% + 8px)
      width: unquote('min(216px, calc(100vw - 24px))')
      .teacher-share-controls__students
        max-height: unquote('min(180px, 24vh)')

@media (max-height: 480px)
  .teacher-share-controls
    top: 12px
    transform: none
    &__status
      max-height: 36px
      overflow: auto
    &__picker
      top: 0
      bottom: auto

.live-share-button
  flex: 1
