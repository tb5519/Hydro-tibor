.live-share-empty
  padding: 40px 12px
  margin: 0
  text-align: center
  color: #8a9dad
  font-size: 13px
  line-height: 1.8

.live-share-notice
  position: fixed
  bottom: calc(12px + env(safe-area-inset-bottom, 0px))
  left: 50%
  transform: translateX(-50%)
  z-index: 1002
  display: flex
  align-items: center
  gap: 8px
  max-width: calc(100% - 32px)
  padding: 8px 15px
  border: 1px solid #cee3d9
  border-radius: 20px
  background: #f7fffbf2
  color: #4a7c68
  font-size: 12px
  box-shadow: 0 3px 15px #294e3f0a
  pointer-events: none

.live-share-dot
  display: block
  width: 6px
  height: 6px
  border-radius: 50%
  background: #61a98b

.live-share-annotation
  position: absolute
  inset: 0
  z-index: 1003
  overflow: hidden
  pointer-events: none
  color: #364460
  font: 14px/1.6 var(--font-family, "PingFang SC", "Microsoft YaHei", sans-serif)
  &, *
    box-sizing: border-box
  &[hidden], [hidden]
    display: none !important
  &__selection
    position: absolute
    pointer-events: none
  &__outline
    position: absolute
    inset: 0
    overflow: visible
    pointer-events: none
  &__box
    fill: #a891ee0d
    stroke: #8b74da
    stroke-width: 3.5px
    stroke-linejoin: round
    filter: drop-shadow(0 1px 1px #ffffffb3)
    pointer-events: none
  &__arrow, &__connector
    position: absolute
    top: 0
    left: 0
    overflow: visible
    stroke: #7764c4
    stroke-width: 1.5px
    stroke-linecap: round
    stroke-linejoin: round
    filter: drop-shadow(0 2px 0 #ffffffcc) drop-shadow(0 3px 3px #7461ba26)
    pointer-events: none
  &__connector
    stroke: #a39bc9
    stroke-width: 1.5px
    filter: none
  &__bubble
    position: absolute
    display: block
    padding: 0
    margin: 0
    border: 1px solid #c8bcea
    border-radius: 10px
    background: #fffefe
    box-shadow: 0 4px 16px #5141761c, 0 1px 3px #5141760a
    overflow: visible
    pointer-events: none
  &__header
    position: absolute
    top: -11px
    left: 1px
    right: 1px
    height: 18px
    border: 1px solid #c8bcea
    border-bottom: 0
    border-radius: 10px 10px 4px 4px
    background: #f0ebfb
    user-select: none
    &::after
      content: ''
      position: absolute
      left: 50%
      top: 6px
      width: 16px
      height: 3px
      border-radius: 3px
      background: #c4b5e6
      transform: translateX(-50%)
    &:focus-visible
      outline: 2px solid #a99ae9
      outline-offset: 1px
  &__close
    position: absolute
    top: -9px
    right: -9px
    display: block
    width: 18px
    height: 18px
    margin: 0
    padding: 0
    border: 1px solid #ded5ef
    border-radius: 50%
    background: #fff
    color: #8e7ca8
    font: 15px/16px var(--font-family, "PingFang SC", "Microsoft YaHei", sans-serif) !important
    opacity: 0
    pointer-events: none
    cursor: pointer
    &:hover
      background: #f1edf9
      color: #6f5e98
    &:focus-visible
      outline: 2px solid #a99ae9
      outline-offset: 1px
  &__resize
    position: absolute
    right: -6px
    bottom: -6px
    width: 14px
    height: 14px
    margin: 0
    padding: 0
    border: 0
    border-radius: 4px
    background: transparent
    opacity: 0
    pointer-events: none
    cursor: nwse-resize
    touch-action: none
    &::after
      content: ''
      position: absolute
      right: 2px
      bottom: 2px
      width: 9px
      height: 9px
      clip-path: polygon(100% 0, 100% 100%, 0 100%)
      background: repeating-linear-gradient(135deg, transparent 0 2px, #9d8bbf 2px 3px)
    &:hover
      background: #eee8fa
    &:focus-visible
      outline: 2px solid #a99ae9
      outline-offset: 0
  &__input, &__text, &__measure
    display: block
    width: 100%
    margin: 0
    padding: 7px 9px
    color: #364460
    // The site gives every textarea an !important code font. Notes must use
    // the same typography for input, learner copy and size measurement, even
    // when the two accounts choose different page/code fonts.
    font: normal 400 14px/20px Arial, "PingFang SC", "Microsoft YaHei", sans-serif !important
    letter-spacing: normal
    word-spacing: normal
    word-break: normal
    text-transform: none
    text-indent: 0
    text-align: left
    overflow-wrap: anywhere
    white-space: pre-wrap
    tab-size: 4
  &__input, &__text
    height: 100%
    min-height: 0
    min-width: 0
    max-height: none
    border: 0 !important
    border-radius: 9px
    background: transparent
    overflow-x: hidden
    overflow-y: auto
    overscroll-behavior: contain
    // Native scrollbar widths vary by operating system. They must not steal
    // text width on just one peer and change the shared note's line breaks.
    scrollbar-width: none
    &::-webkit-scrollbar
      display: none
  &__input
    outline: none !important
    box-shadow: none !important
    resize: none
    &::placeholder
      color: #a49db5
  &__text
    pointer-events: auto
    touch-action: pan-y
    cursor: text
    user-select: text
    &.is-placeholder
      color: #a49db5
    &:focus-visible
      outline: 2px solid #b8aaeb
      outline-offset: -3px
  &__measure
    position: absolute
    top: 0
    left: -10000px
    width: max-content
    height: auto
    visibility: hidden
    pointer-events: none
  &.is-teacher &__bubble
    pointer-events: auto
    &:hover, &:focus-within
      .live-share-annotation__close, .live-share-annotation__resize
        opacity: 1
        pointer-events: auto
  &.is-teacher &__header
    cursor: grab
    touch-action: none
  &.is-dragging &__header
    cursor: grabbing
  &.is-resizing
    cursor: nwse-resize

@media (hover: none)
  .live-share-annotation.is-teacher
    .live-share-annotation__close, .live-share-annotation__resize
      opacity: 1
      pointer-events: auto

.live-share-overlay.is-disconnected .live-share-annotation
  display: none

.live-share-backup
  position: fixed
  z-index: 1012
  left: 24px
  bottom: 24px
  display: flex
  align-items: center
  gap: 12px
  max-width: calc(100% - 48px)
  padding: 14px 18px
  border: 1px solid #e7dac5
  border-radius: 14px
  background: #fffaf1
  color: #85693f
  font-size: 13px
  box-shadow: 0 5px 24px #483b2412

@media (max-width: 600px)
  .live-share-picker
    padding: 12px
    &__card
      padding: 24px 18px 14px
      max-height: calc(100dvh - 24px)
      border-radius: 20px
    &__header h2
      font-size: 23px
