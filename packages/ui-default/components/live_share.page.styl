.teacher-assistant__share
  width: 100%
  text-align: left
  border: 0
  background: transparent

.live-share-viewing .teacher-assistant
  z-index: 1001
  .teacher-assistant__links, .teacher-assistant__footer
    display: none
  .teacher-assistant__toggle
    border-color: #8cbaa9
    color: #287661
    background: #f8fffc
  .teacher-assistant__mark
    color: #329578

.live-share-overlay, .live-share-picker, .live-share-notice, .live-share-controls
  font-family: var(--font-family, "PingFang SC", "Microsoft YaHei", sans-serif)
  color: #263c54
  &, *
    box-sizing: border-box
  [hidden]
    display: none !important
  button, input
    font: inherit
  button
    cursor: pointer
  button:focus-visible, input:focus-visible
    outline: 3px solid #a6c2df
    outline-offset: 3px

.live-share-overlay
  position: fixed
  inset: 0
  z-index: 950
  background: #e9edf2
  overflow: hidden
  isolation: isolate

.live-share-viewport
  position: absolute
  inset: 0
  overflow: hidden

.live-share-stage
  position: absolute
  transform-origin: top left
  background: #fff
  overflow: hidden
  box-shadow: 0 0 40px #23394f15

.live-share-mirror, .live-share-editors
  position: absolute
  inset: 0
  width: 100%
  height: 100%

.live-share-editors
  pointer-events: none
  z-index: 2
  > *
    pointer-events: auto

.live-share-mirror
  .replayer-wrapper, .replayer-wrapper > iframe
    border: 0
    display: block
  .replayer-mouse
    display: none

.live-share-overlay.is-disconnected
  .live-share-mirror, .live-share-editors
    pointer-events: none

.live-share-status
  position: absolute
  z-index: 5
  left: 50%
  bottom: calc(12px + env(safe-area-inset-bottom, 0px))
  transform: translateX(-50%)
  max-width: calc(100% - 32px)
  padding: 10px 18px
  border: 1px solid #dce6ef
  border-radius: 12px
  background: #fffffff5
  color: #546d85
  font-size: 13px
  box-shadow: 0 4px 22px #243b5312
  pointer-events: none
  &.is-blocking
    top: 45%
    bottom: auto
    padding: 20px 28px
    font-size: 15px

.live-share-controls
  padding: 0 8px 10px
  &__eyebrow, &__name, &__status
    display: block
  &__eyebrow
    font-size: 11px
    color: #78928b
    margin-bottom: 8px
  &__name
    font-size: 20px
    line-height: 1.5
    color: #243c51
  &__status
    color: #719082
    font-size: 12px
    line-height: 1.7
    margin: 5px 0 18px
  &__actions
    display: flex
    gap: 8px

.live-share-button
  flex: 1
  padding: 10px 8px
  border: 1px solid #dce6ee
  border-radius: 10px
  background: #f8fafc
  color: #4b6881
  font-size: 12px
  &:hover
    background: #edf3f8
  &--end
    color: #a45959
    border-color: #f0dedd
    background: #fff8f7
    &:hover
      background: #fbeeed

.live-share-fallback
  position: fixed
  bottom: 24px
  right: 24px
  width: 280px
  padding: 20px 12px 10px
  border: 1px solid #dce6ee
  border-radius: 18px
  background: white

.live-share-picker
  position: fixed
  inset: 0
  z-index: 1010
  display: flex
  align-items: center
  justify-content: center
  padding: 24px
  background: #182f4533
  backdrop-filter: blur(5px)
  &__card
    display: flex
    flex-direction: column
    width: 520px
    max-width: 100%
    max-height: unquote('min(720px, calc(100dvh - 48px))')
    padding: 30px 26px 20px
    border: 1px solid #ffffffa8
    border-radius: 24px
    background: #fff
    box-shadow: 0 28px 90px #102b4729
  &__header
    display: flex
    align-items: flex-start
    justify-content: space-between
    h2
      margin: 8px 0 0
      font-size: 26px
      line-height: 1.4
      font-weight: 700
      color: #243c54
  &__eyebrow
    color: #7f98ad
    font-size: 11px
    letter-spacing: .08em
  &__close
    flex: 0 0 32px
    border: 0
    width: 32px
    height: 32px
    border-radius: 50%
    background: #f3f6fa
    color: #8095a8
    font-size: 24px !important
    line-height: 30px
  &__intro
    margin: 12px 0 22px
    font-size: 13px
    line-height: 1.7
    color: #8395a5
  &__search
    flex: 0 0 auto
    width: 100% !important
    height: 46px !important
    padding: 0 15px !important
    margin: 0 0 16px !important
    border: 1px solid #dfe7ef !important
    border-radius: 12px !important
    background: #f7f9fc !important
    color: #36526c !important
    font-size: 14px !important
    &::placeholder
      color: #9baab9
  &__list
    overflow-y: auto
    min-height: 140px
    overscroll-behavior: contain

.live-share-student
  display: flex
  align-items: center
  gap: 13px
  width: 100%
  min-height: 80px
  padding: 12px 10px
  text-align: left
  border: 1px solid transparent
  border-radius: 13px
  background: transparent
  &:not(:disabled):hover
    border-color: #dcebe5
    background: #f4faf7
  &:disabled
    cursor: default
  &__avatar
    display: grid
    flex: 0 0 44px
    place-items: center
    height: 44px
    background: #edf3f8
    color: #6a8da9
    border-radius: 14px
    font-size: 19px
    font-weight: 600
  &__copy
    min-width: 0
    flex: 1
    strong, span
      display: block
      overflow: hidden
      text-overflow: ellipsis
      white-space: nowrap
    strong
      font-size: 15px
      font-weight: 650
      color: #34516a
    span
      margin-top: 7px
      font-size: 11px
      color: #8b9bab
  &__state
    color: #b1bdc8
    font-size: 12px
    white-space: nowrap
    &.is-online
      color: #49856d

.live-share-empty
  padding: 40px 12px
  margin: 0
  text-align: center
  color: #8a9dad
  font-size: 13px
  line-height: 1.8

.live-share-notice
  position: fixed
  bottom: calc(12px + env(safe-area-inset-bottom, 0px))
  left: 50%
  transform: translateX(-50%)
  z-index: 1002
  display: flex
  align-items: center
  gap: 8px
  max-width: calc(100% - 32px)
  padding: 8px 15px
  border: 1px solid #cee3d9
  border-radius: 20px
  background: #f7fffbf2
  color: #4a7c68
  font-size: 12px
  box-shadow: 0 3px 15px #294e3f0a
  pointer-events: none

.live-share-dot
  display: block
  width: 6px
  height: 6px
  border-radius: 50%
  background: #61a98b

.live-share-backup
  position: fixed
  z-index: 1012
  left: 24px
  bottom: 24px
  display: flex
  align-items: center
  gap: 12px
  max-width: calc(100% - 48px)
  padding: 14px 18px
  border: 1px solid #e7dac5
  border-radius: 14px
  background: #fffaf1
  color: #85693f
  font-size: 13px
  box-shadow: 0 5px 24px #483b2412

@media (max-width: 600px)
  .live-share-picker
    padding: 12px
    &__card
      padding: 24px 18px 14px
      max-height: calc(100dvh - 24px)
      border-radius: 20px
    &__header h2
      font-size: 23px
