.teacher-broadcast-flash
  position: fixed
  z-index: 2147482200
  bottom: 22px
  left: 50%
  transform: translateX(-50%)
  max-width: calc(100vw - 32px)
  padding: 10px 16px
  border: 1px solid #dce7e2
  border-radius: 12px
  color: #536f64
  background: #fcfffef5
