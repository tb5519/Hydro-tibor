.badge-ac-theme-effect[hidden]
  display: none

.badge-ac-theme-effect
  position: fixed
  inset: 0
  z-index: 100003
  display: grid
  place-items: center
  overflow: hidden
  pointer-events: none

.badge-ac-theme-effect::before
  content: ''
  position: absolute
  inset: 0
  background: radial-gradient(circle at center, rgba(67, 112, 255, .34), transparent 63%)
  opacity: 0
  transition: opacity .24s ease

.badge-ac-theme-effect.is-visible::before
  opacity: 1

.badge-ac-theme-effect__frame
  position: relative
  display: grid
  place-items: center
  width: unquote('min(48vw, 520px, calc(100vh - 88px))')
  height: unquote('min(48vw, 520px, calc(100vh - 88px))')
  opacity: 0
  transform: translateY(24px) scale(.68) rotate(-3deg)
  transition: opacity .28s ease, transform .5s cubic-bezier(.16, 1, .3, 1)

.badge-ac-theme-effect.is-visible .badge-ac-theme-effect__frame
  opacity: 1
  transform: translateY(0) scale(1) rotate(0)

.badge-ac-theme-effect.is-leaving .badge-ac-theme-effect__frame
  opacity: 0
  transform: translateY(-18px) scale(1.08)
  transition: opacity .32s ease, transform .32s ease

.badge-ac-theme-effect__burst
  position: absolute
  width: 128%
  height: 128%
  border-radius: 50%
  background: radial-gradient(circle, rgba(255, 255, 255, .88) 0 8%, rgba(107, 150, 255, .25) 30%, rgba(74, 99, 255, 0) 70%)
  filter: blur(1px)
  transform: scale(.35)
  transition: transform .62s cubic-bezier(.16, 1, .3, 1)

.badge-ac-theme-effect.is-visible .badge-ac-theme-effect__burst
  transform: scale(1)

.badge-ac-theme-effect__image
  position: relative
  z-index: 1
  display: block
  width: 100%
  height: 100%
  object-fit: contain
  filter: drop-shadow(0 18px 34px rgba(15, 23, 42, .34))

.badge-ac-theme-effect__label
  position: relative
  z-index: 1
  padding: 18px 28px
  border: 1px solid rgba(255, 255, 255, .68)
  border-radius: 14px
  background: rgba(20, 64, 180, .78)
  box-shadow: 0 18px 34px rgba(16, 44, 120, .3)
  color: #fff
  font-size: 26px
  font-weight: 800

@media (max-width: 40em)
  .badge-ac-theme-effect__frame
    width: unquote('min(78vw, calc(100vh - 128px))')
    height: unquote('min(78vw, calc(100vh - 128px))')

@media (prefers-reduced-motion: reduce)
  .badge-ac-theme-effect__frame,
  .badge-ac-theme-effect__burst
    transition: none
