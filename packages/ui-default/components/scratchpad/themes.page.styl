#scratchpad .scratchpad__coding-area
  position: relative
  height: 100%
  min-width: 0
  min-height: 0
  color: var(--ui-v2-text)
  background: var(--ui-v2-surface)
  color-scheme: var(--scratchpad-color-scheme)

  .loader-container
    background: var(--ui-v2-surface)

  .scratchpad__toolbar .scratchpad__toolbar__submit,
  .scratchpad__toolbar .scratchpad__toolbar__submit.enabled:hover
    color: var(--scratchpad-on-accent)

.scratchpad__theme-picker
  flex: 0 0 auto
  color-scheme: var(--scratchpad-color-scheme)

.scratchpad__theme-trigger
  display: inline-flex
  align-items: center
  justify-content: center
  gap: rem(6px)
  box-sizing: border-box
  min-height: rem(34px)
  padding: rem(0 9px)
  border: 1px solid var(--ui-v2-border)
  border-radius: rem(8px)
  background: var(--ui-v2-surface)
  color: var(--ui-v2-text-muted)
  font: inherit
  font-size: rem(12px)
  font-weight: 500
  cursor: pointer
  transition: background-color .15s ease, color .15s ease

  &:hover,
  &[aria-expanded='true']
    background: var(--ui-v2-accent-soft)
    color: var(--ui-v2-accent)

  &:focus-visible
    outline: 2px solid var(--ui-v2-accent)
    outline-offset: 2px

.scratchpad__theme-picker--expanded .scratchpad__theme-trigger
  min-width: rem(150px)
  justify-content: space-between

// Portalled outside the split pane so the menu remains visible in short editors.
.scratchpad__theme-menu
  position: fixed
  z-index: 10050
  box-sizing: border-box
  width: 360px
  max-width: calc(100vw - 24px)
  max-height: calc(100vh - 24px)
  overflow-y: auto
  padding: rem(8px)
  border: 1px solid var(--ui-v2-border)
  border-radius: rem(12px)
  background: var(--ui-v2-surface)
  color: var(--ui-v2-text)
  box-shadow: 0 12px 40px rgba(15, 23, 42, .16), 0 2px 8px rgba(15, 23, 42, .04)
  font-family: $primary-font-family
  color-scheme: var(--scratchpad-color-scheme)

  .scratchpad__theme-menu-heading
    padding: rem(5px 8px 9px)
    color: var(--ui-v2-text-muted)
    font-size: rem(11px)
    font-weight: 500
    letter-spacing: .04em

  .scratchpad__theme-menu-heading--badges
    display: flex
    align-items: center
    justify-content: space-between
    margin-top: rem(9px)
    padding-top: rem(13px)
    border-top: 1px solid var(--ui-v2-border)

    small
      font-size: rem(10px)
      letter-spacing: 0

  .scratchpad__theme-builtins
    display: grid
    grid-template-columns: 1fr 1fr
    gap: rem(3px)

    button
      gap: rem(7px)
      padding: rem(8px 6px)

    .scratchpad__theme-check
      width: rem(12px)

  .scratchpad__theme-thumbnail
    display: grid
    place-items: center
    flex: 0 0 auto
    overflow: hidden
    width: rem(80px)
    height: rem(52px)
    border: 1px solid var(--ui-v2-border)
    border-radius: rem(8px)
    font-size: rem(25px)

    img
      width: 100%
      height: 100%
      object-fit: cover

  button.scratchpad__theme-badge-option
    padding-top: rem(10px)
    padding-bottom: rem(10px)

  .scratchpad__theme-validity
    color: var(--ui-v2-accent)

  .scratchpad__theme-empty
    margin: rem(2px 8px 12px)
    color: var(--ui-v2-text-muted)
    font-size: rem(12px)
    line-height: 1.7

  .scratchpad__theme-menu-footer
    margin: rem(6px 4px 0)
    padding: rem(10px 5px 4px)
    border-top: 1px solid var(--ui-v2-border)
    color: var(--ui-v2-text-muted)
    font-size: rem(10px)
    text-align: center

  button
    display: flex
    align-items: center
    gap: rem(10px)
    width: 100%
    margin: 0
    padding: rem(9px 8px)
    border: 0
    border-radius: rem(8px)
    background: transparent
    color: var(--ui-v2-text)
    text-align: left
    cursor: pointer
    font: inherit

    &:disabled
      cursor: wait
      opacity: .7

    &:hover,
    &:focus-visible
      background: var(--ui-v2-surface-muted)
      outline: 0

    &[aria-checked='true']
      background: var(--ui-v2-accent-soft)

  .scratchpad__theme-option-label
    display: flex
    flex: 1
    flex-direction: column
    gap: rem(3px)

    strong
      font-size: rem(13px)
      font-weight: 600
      line-height: 1.3

    small
      color: var(--ui-v2-text-muted)
      font-size: rem(11px)
      line-height: 1.3

  .scratchpad__theme-check
    width: rem(16px)
    color: var(--ui-v2-accent)
    font-size: rem(15px)

  .scratchpad__theme-detail-top
    display: flex
    align-items: center
    justify-content: space-between
    gap: rem(8px)
    padding: rem(0 4px 8px)

  button.scratchpad__theme-back
    width: auto
    gap: rem(5px)
    padding: rem(5px 7px)
    color: var(--ui-v2-text-muted)
    font-size: rem(12px)

    > span
      font-size: rem(23px)
      line-height: 1

  .scratchpad__theme-personal
    color: var(--ui-v2-text-muted)
    font-size: rem(10px)
    letter-spacing: .04em

  .scratchpad__theme-detail-title
    display: flex
    align-items: center
    gap: rem(12px)
    padding: rem(4px 8px 17px)

    .scratchpad__theme-thumbnail
      width: rem(60px)
      height: rem(48px)

    > div
      min-width: 0

    strong
      display: block
      font-size: rem(15px)
      line-height: 1.5
      overflow-wrap: anywhere

    p
      margin: rem(5px 0 0)
      font-size: rem(11px)
      color: var(--ui-v2-text-muted)
      line-height: 1.5

  .scratchpad__theme-palettes
    display: grid
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr)
    gap: rem(9px)
    padding: rem(0 7px)

  button.scratchpad__theme-palette
    display: block
    padding: rem(6px)
    border: 1px solid var(--ui-v2-border)
    border-radius: rem(11px)
    transition: border-color .15s ease, background-color .15s ease

    &:hover
      border-color: var(--ui-v2-border-strong, var(--ui-v2-accent))

    &[aria-checked='true']
      border-color: var(--ui-v2-accent)
      box-shadow: 0 0 0 1px var(--ui-v2-accent)

    &:focus-visible
      outline: 2px solid var(--ui-v2-accent)
      outline-offset: 3px

  .scratchpad__theme-palette-preview
    display: flex
    position: relative
    flex-direction: column
    gap: rem(5px)
    height: rem(78px)
    box-sizing: border-box
    padding: rem(8px 10px)
    border: 1px solid
    border-radius: rem(7px)
    overflow: hidden

  .scratchpad__theme-palette-dots
    display: flex
    gap: rem(3px)
    margin-bottom: rem(3px)

    i
      width: rem(3px)
      height: rem(3px)
      border-radius: 50%
      background: #91a0b3
      opacity: .55

  .scratchpad__theme-palette-line
    display: block
    height: rem(3px)
    flex-shrink: 0
    border-radius: rem(2px)
    opacity: .85

  .scratchpad__theme-palette-accent
    position: absolute
    bottom: rem(9px)
    right: rem(10px)
    width: rem(20px)
    height: rem(7px)
    border-radius: rem(3px)

  .scratchpad__theme-palette-label
    display: flex
    align-items: center
    gap: rem(5px)
    padding: rem(9px 4px 3px)

    strong
      font-size: rem(12px)
      font-weight: 600

    small
      font-size: rem(10px)
      color: var(--ui-v2-text-muted)

  .scratchpad__theme-palette-check
    margin-left: auto
    color: var(--ui-v2-accent)
    font-size: rem(12px)
    line-height: 1

  button.scratchpad__theme-original
    grid-column: 1 / -1
    gap: rem(9px)
    margin-top: rem(2px)
    padding: rem(10px)
    border: 1px solid var(--ui-v2-border)
    border-radius: rem(9px)

    > svg
      color: var(--ui-v2-text-muted)
      flex-shrink: 0

    > span:nth-child(2)
      display: flex
      flex: 1
      flex-direction: column
      gap: rem(4px)

    strong
      font-size: rem(12px)
      font-weight: 500

    small
      font-size: rem(10px)
      color: var(--ui-v2-text-muted)

    &[aria-checked='true']
      border-color: var(--ui-v2-accent)

    &:focus-visible
      outline: 2px solid var(--ui-v2-accent)
      outline-offset: 2px

  .scratchpad__theme-palette-hint
    margin: rem(13px 10px 5px)
    font-size: rem(10px)
    line-height: 1.6
    color: var(--ui-v2-text-muted)
    text-align: center

  .scratchpad__theme-menu-footer--error
    color: #b85440


.scratchpad__theme-swatch
  display: flex
  flex-direction: column
  justify-content: center
  gap: rem(3px)
  box-sizing: border-box
  width: rem(34px)
  height: rem(34px)
  padding: rem(7px)
  border: 1px solid
  border-radius: rem(8px)

  i
    display: block
    height: 2px
    border-radius: 2px

    &:nth-child(2)
      width: 65%

    &:nth-child(3)
      width: 80%

// The artwork and controls are separate layers. This preserves split panes,
// Monaco models and hit targets while the complete workspace changes skin.
#scratchpad .scratchpad__coding-area[data-scratchpad-skin='true']
  isolation: isolate

  > .split-view
    z-index: 1

  .scratchpad__workspace,
  .scratchpad__data-input,
  .scratchpad__records-scroll,
  .scratchpad__records__table tbody tr
    background: transparent

  // Input and output are working surfaces, not part of the illustration.
  // Keep them quiet even when an uploaded panel has bright, detailed artwork.
  .scratchpad__data-pane
    background: var(--scratchpad-reading-surface)
    color: var(--scratchpad-reading-text)

  .scratchpad__data-label,
  .scratchpad__data-metadata,
  .scratchpad__data-input::placeholder,
  .scratchpad__data-placeholder
    color: var(--scratchpad-reading-muted)
    opacity: 1

  .scratchpad__data-input
    color: var(--scratchpad-reading-text)

  .scratchpad__records-empty small
    opacity: 1

  .ScratchpadMonacoEditor
    background-image: linear-gradient(var(--scratchpad-skin-veil), var(--scratchpad-skin-veil)), var(--scratchpad-skin-editor-image)
    background-size: 100% 100%, var(--scratchpad-skin-editor-size)
    background-position: center, var(--scratchpad-skin-editor-position)
    background-repeat: no-repeat, var(--scratchpad-skin-editor-repeat)

  .scratchpad__toolbar
    background-image: linear-gradient(var(--scratchpad-skin-toolbar-veil), var(--scratchpad-skin-toolbar-veil)), var(--scratchpad-skin-toolbar-image)
    background-color: transparent
    background-size: 100% 100%, var(--scratchpad-skin-toolbar-size)
    background-position: center, var(--scratchpad-skin-toolbar-position)
    background-repeat: no-repeat, var(--scratchpad-skin-toolbar-repeat)

    .scratchpad__toolbar__pretest,
    .scratchpad__toolbar__pretest.enabled:hover
      background-image: linear-gradient(var(--scratchpad-skin-toolbar-veil), var(--scratchpad-skin-toolbar-veil)), var(--scratchpad-skin-runButton-image)
      background-color: transparent
      background-size: 100% 100%, var(--scratchpad-skin-runButton-size)
      background-position: center, var(--scratchpad-skin-runButton-position)
      background-repeat: no-repeat, var(--scratchpad-skin-runButton-repeat)

    .scratchpad__toolbar__submit,
    .scratchpad__toolbar__submit.enabled:hover
      background-image: linear-gradient(var(--scratchpad-skin-button-veil), var(--scratchpad-skin-button-veil)), var(--scratchpad-skin-submitButton-image)
      background-color: var(--ui-v2-accent)
      background-size: 100% 100%, var(--scratchpad-skin-submitButton-size)
      background-position: center, var(--scratchpad-skin-submitButton-position)
      background-repeat: no-repeat, var(--scratchpad-skin-submitButton-repeat)
      color: var(--ui-v2-text)
      border-color: var(--ui-v2-accent)

  .scratchpad__panel
    background-image: linear-gradient(var(--scratchpad-skin-panel-veil), var(--scratchpad-skin-panel-veil)), var(--scratchpad-skin-panel-image)
    background-color: transparent
    background-size: 100% 100%, var(--scratchpad-skin-panel-size)
    background-position: center, var(--scratchpad-skin-panel-position)
    background-repeat: no-repeat, var(--scratchpad-skin-panel-repeat)

  .scratchpad__panel-title,
  .scratchpad__records__table th,
  .scratchpad__record-source
    background: var(--scratchpad-skin-panel-veil)

.scratchpad__skin-background
  position: absolute
  z-index: 0
  inset: 0
  overflow: hidden
  pointer-events: none

  video
    display: block
    width: 100%
    height: 100%
    opacity: 0

    &.is-ready
      opacity: 1

.scratchpad__skin-corner
  position: absolute
  z-index: 3
  top: 0
  right: 0
  width: clamp(52px, 9%, 112px)
  height: clamp(52px, 9vw, 112px)
  max-height: 20%
  background-image: var(--scratchpad-skin-corner-image)
  background-size: var(--scratchpad-skin-corner-size)
  background-position: var(--scratchpad-skin-corner-position)
  background-repeat: var(--scratchpad-skin-corner-repeat)
  pointer-events: none

@media (prefers-reduced-motion: reduce)
  .scratchpad__theme-menu button.scratchpad__theme-palette
    transition: none

  .scratchpad__theme-trigger
    transition: none
