#scratchpad .scratchpad__coding-area
  position: relative
  height: 100%
  min-width: 0
  min-height: 0
  color: var(--ui-v2-text)
  background: var(--ui-v2-surface)
  color-scheme: var(--scratchpad-color-scheme)

  .loader-container
    background: var(--ui-v2-surface)

  .scratchpad__toolbar .scratchpad__toolbar__submit,
  .scratchpad__toolbar .scratchpad__toolbar__submit.enabled:hover
    color: var(--scratchpad-on-accent)

.scratchpad__theme-picker
  flex: 0 0 auto
  color-scheme: var(--scratchpad-color-scheme)

.scratchpad__theme-trigger
  display: inline-flex
  align-items: center
  justify-content: center
  gap: rem(6px)
  box-sizing: border-box
  min-height: rem(34px)
  padding: rem(0 9px)
  border: 1px solid var(--ui-v2-border)
  border-radius: rem(8px)
  background: var(--ui-v2-surface)
  color: var(--ui-v2-text-muted)
  font: inherit
  font-size: rem(12px)
  font-weight: 500
  cursor: pointer
  transition: background-color .15s ease, color .15s ease

  &:hover,
  &[aria-expanded='true']
    background: var(--ui-v2-accent-soft)
    color: var(--ui-v2-accent)

  &:focus-visible
    outline: 2px solid var(--ui-v2-accent)
    outline-offset: 2px

.scratchpad__theme-picker--expanded .scratchpad__theme-trigger
  min-width: rem(150px)
  justify-content: space-between

// Portalled outside the split pane so the menu remains visible in short editors.
.scratchpad__theme-menu
  position: fixed
  z-index: 10050
  box-sizing: border-box
  width: 230px
  max-height: calc(100vh - 24px)
  overflow-y: auto
  padding: rem(8px)
  border: 1px solid var(--ui-v2-border)
  border-radius: rem(12px)
  background: var(--ui-v2-surface)
  color: var(--ui-v2-text)
  box-shadow: 0 12px 40px rgba(15, 23, 42, .16), 0 2px 8px rgba(15, 23, 42, .04)
  font-family: $primary-font-family
  color-scheme: var(--scratchpad-color-scheme)

  .scratchpad__theme-menu-heading
    padding: rem(5px 8px 9px)
    color: var(--ui-v2-text-muted)
    font-size: rem(11px)
    font-weight: 500
    letter-spacing: .04em

  button
    display: flex
    align-items: center
    gap: rem(10px)
    width: 100%
    margin: 0
    padding: rem(9px 8px)
    border: 0
    border-radius: rem(8px)
    background: transparent
    color: var(--ui-v2-text)
    text-align: left
    cursor: pointer
    font: inherit

    &:hover,
    &:focus-visible
      background: var(--ui-v2-surface-muted)
      outline: 0

    &[aria-checked='true']
      background: var(--ui-v2-accent-soft)

  .scratchpad__theme-option-label
    display: flex
    flex: 1
    flex-direction: column
    gap: rem(3px)

    strong
      font-size: rem(13px)
      font-weight: 600
      line-height: 1.3

    small
      color: var(--ui-v2-text-muted)
      font-size: rem(11px)
      line-height: 1.3

  .scratchpad__theme-check
    width: rem(16px)
    color: var(--ui-v2-accent)
    font-size: rem(15px)

.scratchpad__theme-swatch
  display: flex
  flex-direction: column
  justify-content: center
  gap: rem(3px)
  box-sizing: border-box
  width: rem(34px)
  height: rem(34px)
  padding: rem(7px)
  border: 1px solid
  border-radius: rem(8px)

  i
    display: block
    height: 2px
    border-radius: 2px

    &:nth-child(2)
      width: 65%

    &:nth-child(3)
      width: 80%

@media (prefers-reduced-motion: reduce)
  .scratchpad__theme-trigger
    transition: none
