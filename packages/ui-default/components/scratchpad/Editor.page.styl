.ScratchpadMonacoEditor
  flex: 1 1 0
  min-height: 0
  min-width: 0
  position: relative

  &[data-editor-ready='true'] > .loader-container
    display: none

  // Monaco draws its outline inside the code layer. The first line's
  // highlight can paint over it, so keep the frame above the editing layers.
  &[data-editor-ready='true']::after
    content: ''
    position: absolute
    inset: 0
    z-index: 10
    box-sizing: border-box
    border: 1px solid var(--focus-border, var(--ui-v2-accent))
    pointer-events: none

  > .monaco-editor
    outline: none

.cm-s-vjcm
  position: absolute
  left: 0
  top: 0
  width: 100%
  height: 100%
  font-family: $code-font-family
  font-size: rem($font-size-secondary)
  line-height: 1.2
