.ide-runtime
  position absolute
  inset 64px 16px 16px
  z-index 55
  pointer-events none
  font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif
  color #34475b
  line-height 1.5
  [hidden]
    display none !important
  *, *:before, *:after
    box-sizing border-box

.ide-window
  position absolute
  display flex
  flex-direction column
  pointer-events auto
  overflow hidden
  border 1px solid #d8e2ec
  border-radius 15px
  background #fff
  box-shadow 0 12px 40px #20385228, 0 2px 6px #2038520d
  z-index 1
  &.is-front
    z-index 2
  &.is-maximized
    border-radius 10px
  &__titlebar
    display flex
    flex-shrink 0
    align-items center
    height 43px
    gap 9px
    padding 0 10px 0 15px
    background #f5f8fb
    border-bottom 1px solid #e5ebf0
    cursor grab
    user-select none
    touch-action none
    &:active
      cursor grabbing
  &__icon
    color #42796e
    font-size 18px
    font-weight 700
  &__title
    font-size 13px
    font-weight 650
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    max-width 45%
  &__status
    font-size 11px
    color #8193a3
    white-space nowrap
  &__controls
    display flex
    gap 3px
    margin-left auto
  &__button
    appearance none
    background transparent
    color #6b7d8e
    border 0
    border-radius 7px
    width 28px
    height 28px
    padding 0
    cursor pointer
    font-size 19px
    line-height 1
    &:hover
      background #e5edf4
      color #294a63
    &:focus-visible
      outline 2px solid #448c80
      outline-offset 2px
  &__body
    position relative
    min-height 0
    flex 1
    display flex
    flex-direction column
    overflow hidden
  &__resize
    position absolute
    right 0
    bottom 0
    width 18px
    height 18px
    cursor nwse-resize
    touch-action none
    z-index 4
    &:after
      content ''
      position absolute
      width 7px
      height 7px
      right 4px
      bottom 4px
      border-right 2px solid #9aaeba
      border-bottom 2px solid #9aaeba
      opacity .65
  &.is-maximized &__resize
    display none

.ide-terminal
  &__output
    flex 1
    min-height 0
    overflow auto
    overscroll-behavior contain
    padding 15px 18px
    margin 0
    background #172430
    color #e7eef3
    font 14px/1.65 ui-monospace, 'SFMono-Regular', Consolas, monospace
    white-space pre-wrap
    overflow-wrap anywhere
    tab-size 4
    border 0
    border-radius 0
  &__stderr
    color #ffb3a9
  &__stdin
    color #91ddc1
  &__notice
    color #a4b5c5
  &__input-form
    display flex
    align-items center
    min-height 45px
    margin 0
    padding 0 12px 0 18px
    background #1d2e3d
    border-top 1px solid #31404e
    gap 10px
  &__input
    width 100%
    min-width 0
    border 0 !important
    box-shadow none !important
    outline none
    color #e7eef3
    background transparent !important
    padding 10px 0 !important
    height auto !important
    font 14px/1.6 ui-monospace, 'SFMono-Regular', Consolas, monospace
    &::placeholder
      color #899dab
      font-size 12px
  &__prompt
    color #91ddc1
    font-size 21px
  &__send
    border 1px solid #485c6b
    background #2f4656
    color #d7eae5
    border-radius 6px
    padding 2px 9px
    font-size 18px
    cursor pointer

.ide-graphics
  min-height 0
  flex 1
  display flex
  background #edf1f4
  overflow hidden
  &__canvas
    width 100%
    height 100%
    min-height 0
    outline none
    touch-action none
  &__dialog
    position absolute
    left 50%
    top 50%
    transform translate(-50%, -50%)
    width min(340px, 92%)
    padding 20px
    margin 0
    border-radius 14px
    background #fffffff5
    border 1px solid #d7e4de
    box-shadow 0 12px 40px #20385230
  &__dialog--standalone
    pointer-events auto
    z-index 8
  &__dialog-title
    display block
    font-size 15px
    margin-bottom 10px
  &__dialog-prompt
    display block
    font-size 13px
    white-space pre-wrap
  &__dialog-input
    display block
    width 100%
    margin-top 10px
    border 1px solid #bfd3cb
    border-radius 7px
    padding 8px 10px
    background #fff
    outline none
    &:focus
      border-color #378877
  &__dialog-buttons
    display flex
    gap 10px
    justify-content flex-end
    margin-top 15px
    button
      width auto
      min-width 54px
      padding 6px 12px
      height auto
      font-size 13px
      border-radius 7px
  &__dialog-accept
    border 0
    background #378877
    color white
    cursor pointer

.ide-runtime__dock
  position absolute
  bottom 0
  left 50%
  transform translateX(-50%)
  display flex
  gap 8px
  pointer-events auto
  z-index 5
.ide-runtime__dock-button
  width auto
  height 36px
  padding 0 15px
  border 1px solid #d7e4de
  background #fffffff5
  color #3b7066
  box-shadow 0 3px 14px #243f4d14
  border-radius 11px
  font-size 12px

.scratchpad__toolbar__ide-status
  font-size 12px
  color #748b87
  margin-left 8px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  max-width 260px

@media (max-width: 600px)
  .ide-runtime
    inset 62px 6px 6px
  .ide-window__status
    display none
  .scratchpad__toolbar__ide-status
    display none
