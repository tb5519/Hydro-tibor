.class-chat
  position: fixed
  z-index: 2147482300
  width: 52px
  height: 52px
  color: #24394b
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif
  font-size: 14px
  line-height: 1.5
  text-align: left

  &, *, *::before, *::after
    box-sizing: border-box

  [hidden]
    display: none !important

  svg
    display: block
    width: 20px
    height: 20px
    flex-shrink: 0

  button, input, textarea
    font: inherit
    letter-spacing: normal

  button
    cursor: pointer
    -webkit-tap-highlight-color: transparent

  button:disabled
    opacity: .45
    cursor: default

  button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible
    outline: 3px solid rgba(73, 143, 193, .42)
    outline-offset: 3px

  h2, p, pre
    margin: 0

.class-chat__launcher
  display: grid
  place-items: center
  width: 52px
  height: 52px
  padding: 3px
  border: 1px solid #d4e0e6
  border-radius: 50%
  background: #fff
  color: #40776e
  box-shadow: 0 4px 16px rgba(38, 61, 74, .12)
  touch-action: none
  user-select: none
  -webkit-user-select: none
  cursor: grab !important
  transition: box-shadow .18s, border-color .18s

  *
    pointer-events: none
    -webkit-user-drag: none

  &:hover, &:focus-visible
    border-color: #93b9b5
    box-shadow: 0 5px 20px rgba(38, 81, 94, .2)

  &.has-unread
    border-color: #70a89e

.class-chat.is-dragging .class-chat__launcher
  cursor: grabbing !important
  box-shadow: 0 10px 28px rgba(38, 81, 94, .25)

.class-chat.is-open .class-chat__launcher
  visibility: hidden

.class-chat__launcher-hint
  position: absolute
  bottom: calc(100% + 8px)
  left: 50%
  transform: translateX(-50%)
  padding: 3px 9px
  border: 1px solid rgba(202, 219, 218, .85)
  border-radius: 9px
  background: rgba(255, 255, 255, .96)
  box-shadow: 0 2px 8px rgba(38, 61, 74, .05)
  color: #50766f
  font-size: 11px
  font-weight: 500
  line-height: 18px
  white-space: nowrap

.class-chat__launcher-avatar
  display: grid
  place-items: center
  width: 44px
  height: 44px
  border-radius: 50%
  overflow: hidden
  background: #e9f2f0
  font-size: 20px
  font-weight: 650

  img
    width: 100%
    height: 100%
    object-fit: cover

.class-chat__launcher-mark
  position: absolute
  right: -1px
  bottom: -1px
  display: grid
  place-items: center
  width: 23px
  height: 23px
  background: #477f75
  border: 2px solid #fff
  border-radius: 50%
  color: #fff

  svg
    width: 13px
    height: 13px
    margin-top: -1px

.class-chat__badge, .class-chat__peer-unread
  display: inline-flex
  justify-content: center
  align-items: center
  min-width: 20px
  height: 20px
  padding: 0 5px
  border-radius: 11px
  background: #e35f66
  color: #fff
  font-size: 11px
  font-weight: 700
  font-variant-numeric: tabular-nums

.class-chat__badge
  position: absolute
  top: -5px
  right: -6px
  min-width: 23px
  height: 23px
  border: 2px solid #fff

.class-chat__panel
  position: fixed
  right: 28px
  bottom: 28px
  display: flex
  flex-direction: column
  width: unquote('min(560px, calc(100vw - 40px))')
  height: unquote('min(660px, calc(100dvh - 72px))')
  min-height: unquote('min(400px, calc(100dvh - 32px))')
  overflow: hidden
  background: #fff
  border: 1px solid #d9e5eb
  border-radius: 22px
  box-shadow: 0 24px 80px rgba(28, 53, 71, .2), 0 5px 18px rgba(28, 53, 71, .07)
  animation: class-chat-in .18s ease-out

  &.has-sidebar
    width: unquote('min(880px, calc(100vw - 40px))')

@keyframes class-chat-in
  from
    opacity: 0
    transform: translateY(8px)
  to
    opacity: 1
    transform: translateY(0)

.class-chat__top
  display: flex
  align-items: center
  justify-content: space-between
  flex: 0 0 auto
  gap: 16px
  padding: 16px 22px
  border-bottom: 1px solid #e9eff2
  background: linear-gradient(110deg, #f4f9f8, #fff 75%)
  touch-action: none
  user-select: none

  &[data-chat-panel-draggable="true"]
    cursor: grab

  .is-dragging &
    cursor: grabbing

  h2
    margin: 2px 0 0
    font-size: 19px
    font-weight: 700
    line-height: 1.3
    color: #263e4c

.class-chat__eyebrow
  color: #6b918a
  font-size: 10px
  font-weight: 600
  letter-spacing: 2px

.class-chat__icon-button
  display: inline-flex
  align-items: center
  justify-content: center
  flex: 0 0 auto
  width: 34px
  height: 34px
  margin: 0
  padding: 7px
  border: 0
  border-radius: 9px
  background: transparent
  color: #7c919e
  transition: color .15s, background .15s

  &:hover:not(:disabled)
    background: #edf3f5
    color: #3e7068

.class-chat__body
  display: flex
  flex: 1
  min-height: 0

.class-chat__sidebar
  display: none
  flex: 0 0 222px
  min-width: 0
  border-right: 1px solid #e7eef1
  background: #f7fafb
  flex-direction: column
  overflow: hidden

.class-chat__panel.has-sidebar .class-chat__sidebar
  display: flex

.class-chat__search
  display: flex
  align-items: center
  gap: 8px
  margin: 16px 14px 8px
  padding: 8px 10px
  color: #90a2ad
  border: 1px solid #e6edf1
  border-radius: 10px
  background: #fff

  svg
    width: 16px
    height: 16px

  input
    display: block
    min-width: 0
    width: 100%
    height: auto
    padding: 0
    margin: 0
    border: none
    outline: none
    box-shadow: none
    background: transparent
    color: #344e5f
    font-size: 12px

    &::placeholder
      color: #94a4ae

.class-chat__peers
  min-height: 0
  padding: 4px 8px 12px
  overflow-y: auto
  overscroll-behavior: contain

.class-chat__peer
  display: flex
  align-items: center
  gap: 10px
  width: 100%
  padding: 12px 10px
  border: 0
  border-radius: 12px
  background: transparent
  text-align: left
  color: #2f4654

  &:hover
    background: #eef4f5

  &.is-selected
    background: #e4efec

.class-chat__avatar, .class-chat__peer-avatar
  display: grid
  place-items: center
  flex: 0 0 36px
  width: 36px
  height: 36px
  overflow: hidden
  border-radius: 12px
  background: #e7eff2
  color: #6d8b9b
  font-size: 16px
  font-weight: 600

  img
    width: 100%
    height: 100%
    object-fit: cover

.class-chat__peer-copy
  flex: 1
  min-width: 0

  strong, span
    display: block
    overflow: hidden
    white-space: nowrap
    text-overflow: ellipsis

  strong
    font-size: 13px
    font-weight: 650

  span
    margin-top: 3px
    color: #8699a5
    font-size: 11px

.class-chat__peer-copy .class-chat__presence-dot
  display: inline-block
  width: 6px
  height: 6px
  margin: 0 0 1px 7px
  border-radius: 50%
  background: #bcc7ce
  vertical-align: middle

  &.is-online
    background: #64a98e

.class-chat__peer-unread
  min-width: 17px
  height: 17px
  font-size: 10px

.class-chat__peer-empty
  padding: 22px 10px
  color: #94a4af
  font-size: 12px
  text-align: center

.class-chat__conversation
  position: relative
  display: flex
  flex: 1
  flex-direction: column
  min-width: 0
  min-height: 0
  background: #fff

.class-chat__conversation-header
  display: flex
  align-items: center
  flex: 0 0 auto
  gap: 10px
  min-height: 69px
  padding: 12px 22px
  border-bottom: 1px solid #edf2f4

.class-chat__back
  display: none

.class-chat__peer-info
  position: relative
  flex: 1
  min-width: 0

  strong, span
    display: block
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  strong
    font-size: 14px
    font-weight: 650
    color: #293e4e

  span
    margin-top: 2px
    color: #99a8b1
    font-size: 10px

  &.can-switch-teacher strong::after
    content: '⌄'
    margin-left: 7px
    color: #849caa

.class-chat__teacher-picker
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 24px
  margin: 0
  padding: 0
  opacity: 0
  cursor: pointer

.class-chat__peer-info:focus-within strong
  text-decoration: underline
  text-decoration-color: #91bdb0
  text-underline-offset: 4px

.class-chat__quota
  flex-shrink: 0
  padding: 4px 7px
  border: 1px solid #e9eff2
  border-radius: 7px
  color: #a4b1b9
  font-size: 10px
  cursor: help

.class-chat__connection.has-presence::before
  content: ''
  display: inline-block
  width: 5px
  height: 5px
  margin: 0 5px 1px 0
  border-radius: 50%
  background: #bcc7ce
  vertical-align: middle

.class-chat__connection.has-presence.is-online::before
  background: #64a98e

.class-chat__messages
  flex: 1
  min-height: 0
  padding: 18px 22px
  overflow: auto
  overscroll-behavior: contain
  background: #fbfcfd
  scrollbar-width: thin
  scrollbar-color: #d5e1e6 transparent

.class-chat__empty
  display: flex
  height: 100%
  min-height: 120px
  flex-direction: column
  align-items: center
  justify-content: center
  gap: 10px
  color: #8195a1
  text-align: center

  strong
    margin-top: 6px
    color: #617987
    font-size: 14px
    font-weight: 600

  p
    max-width: 240px
    color: #9cabb4
    font-size: 12px
    line-height: 1.8

.class-chat__empty-icon
  display: grid
  place-items: center
  width: 52px
  height: 52px
  border-radius: 18px
  background: #edf4f3
  color: #8db2a9

  svg
    width: 27px
    height: 27px

.class-chat__time
  display: block
  margin: 6px 0 18px
  color: #a8b5bd
  font-size: 10px
  text-align: center

.class-chat__message
  position: relative
  display: flex
  align-items: flex-start
  gap: 9px
  margin-bottom: 18px

  .class-chat__avatar
    width: 30px
    height: 30px
    flex-basis: 30px
    border-radius: 10px
    font-size: 13px

  &.is-own
    flex-direction: row-reverse

    .class-chat__bubble
      background: #e5f1eb
      border-color: #d7e9df
      border-radius: 14px 4px 14px 14px

  &.has-receipt
    margin-bottom: 29px

.class-chat__receipt
  position: absolute
  right: 40px
  bottom: -17px
  color: #a7b4bd
  font-size: 10px
  line-height: 1.5

  &.is-read
    color: #83a193

.class-chat__bubble
  max-width: unquote('min(360px, calc(100% - 42px))')
  min-width: 0
  padding: 10px 13px
  border: 1px solid #e7edf1
  border-radius: 4px 14px 14px 14px
  background: #fff
  color: #344c5c
  box-shadow: 0 2px 4px rgba(36, 62, 78, .025)

.class-chat__text
  white-space: pre-wrap
  overflow-wrap: anywhere
  line-height: 1.7

.class-chat__image-link
  display: block
  margin: -5px -7px
  padding: 0
  border: 0
  border-radius: 9px
  background: transparent
  overflow: hidden
  cursor: zoom-in !important

.class-chat__image
  display: block
  max-width: 100%
  max-height: 220px
  border-radius: 9px
  object-fit: contain

.class-chat__image-error
  display: block
  padding: 15px 12px
  color: #91a3af
  font-size: 12px

.class-chat__lightbox
  position: fixed
  inset: 0
  width: 100%
  height: 100%
  height: 100dvh
  max-width: none
  max-height: none
  margin: 0
  padding: 64px 24px 24px
  border: 0
  background: transparent
  color: #f2f6fa
  overflow: hidden

  &[open]
    display: flex
    align-items: center
    justify-content: center

  &::backdrop
    background: rgba(15, 24, 35, .84)
    backdrop-filter: blur(5px)

.class-chat__lightbox-close
  position: absolute
  top: 16px
  right: 20px
  display: grid
  place-items: center
  width: 40px
  height: 40px
  padding: 8px
  border: 1px solid rgba(255, 255, 255, .16)
  border-radius: 50%
  background: rgba(255, 255, 255, .1)
  color: #fff
  transition: background .15s

  &:hover
    background: rgba(255, 255, 255, .2)

.class-chat__lightbox-figure
  display: flex
  flex-direction: column
  align-items: center
  gap: 14px
  max-width: 100%
  max-height: 100%
  margin: 0

.class-chat__lightbox-image
  display: block
  width: auto
  height: auto
  max-width: 100%
  max-height: calc(100vh - 120px)
  max-height: calc(100dvh - 120px)
  object-fit: contain
  border-radius: 10px
  box-shadow: 0 12px 48px rgba(0, 0, 0, .24)

.class-chat__lightbox-name
  max-width: 100%
  color: #d2dae3
  font-size: 12px
  line-height: 18px
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

.class-chat__lightbox-status
  padding: 32px 16px
  color: #d2dae3
  font-size: 14px
  text-align: center

.class-chat__file-link
  display: flex
  align-items: center
  gap: 12px
  width: 240px
  max-width: 100%
  padding: 4px 0
  text-decoration: none
  color: #40596a

  > span:last-child
    flex: 1
    min-width: 0

  strong
    display: block
    overflow-wrap: anywhere
    font-size: 13px
    font-weight: 600

  small
    display: block
    margin-top: 6px
    color: #8b9da8
    font-size: 10px

.class-chat__file-icon
  display: grid
  place-items: center
  flex: 0 0 38px
  height: 42px
  border: 1px solid #dce8ed
  border-radius: 9px
  background: rgba(255, 255, 255, .7)
  color: #7f9eaf

.class-chat__code-card
  display: block
  width: 276px
  max-width: 100%
  text-decoration: none
  color: #344e60

  > strong
    display: block
    margin: 5px 0 10px
    font-size: 14px
    line-height: 1.6
    overflow-wrap: anywhere

  pre
    padding: 8px 9px
    overflow: hidden
    border: 1px solid rgba(117, 145, 158, .13)
    border-radius: 7px
    background: rgba(255, 255, 255, .65)
    color: #75909c
    font: 11px/1.7 ui-monospace, SFMono-Regular, Consolas, monospace
    text-overflow: ellipsis
    white-space: pre

.class-chat__code-label
  font-size: 10px
  color: #81a295

.class-chat__code-action
  display: flex
  justify-content: space-between
  align-items: center
  margin-top: 10px
  padding-top: 9px
  border-top: 1px solid rgba(117, 145, 158, .13)
  color: #4f8677
  font-size: 11px

  svg
    width: 15px
    height: 15px

.class-chat__load-more
  display: block
  margin: -6px auto 16px
  padding: 5px 10px
  border: none
  border-radius: 8px
  color: #7e9aaa
  background: transparent
  font-size: 11px !important

.class-chat__new-message
  position: absolute
  right: 20px
  bottom: 174px
  padding: 7px 12px
  border: 1px solid #d3e4df
  border-radius: 20px
  background: #fff
  color: #45816f
  box-shadow: 0 3px 12px rgba(41, 88, 77, .12)
  font-size: 11px !important

.class-chat__feedback
  padding: 7px 20px
  background: #f1f7f5
  color: #5a8a7a
  font-size: 11px

  &.is-error
    color: #b16c4d
    background: #fff6ef

.class-chat__composer
  flex: 0 0 auto
  padding: 12px 18px 14px
  border-top: 1px solid #eaf0f3
  background: #fff

.class-chat__panel:not(.has-contact) .class-chat__composer
  opacity: .5

.class-chat__snapshot
  display: flex
  align-items: center
  gap: 8px
  width: 100%
  margin: 0 0 10px
  padding: 9px 12px
  border: 1px solid #d9e7f2
  border-radius: 10px
  background: #f2f7fc
  color: #4c80aa
  font-size: 12px !important
  font-weight: 600 !important
  text-align: left

  &:hover:not(:disabled)
    background: #eaf3fb
    border-color: #bcd5e8

  svg
    width: 17px
    height: 17px

.class-chat__snapshot-arrow
  margin-left: auto
  color: #8eafc8

.class-chat__input
  display: block
  width: 100%
  min-height: 54px
  max-height: 120px
  margin: 0
  padding: 5px 4px
  border: 0
  border-radius: 8px
  outline: none
  box-shadow: none
  background: transparent
  color: #344e5f
  line-height: 1.65 !important
  resize: none

  &::placeholder
    color: #a3b2ba

.class-chat .class-chat__input:focus-visible
  outline: 1px solid #d4e6df
  outline-offset: 1px

.class-chat__compose-tools, .class-chat__attachments
  display: flex
  align-items: center
  gap: 2px

.class-chat__compose-tools
  justify-content: space-between
  gap: 10px
  margin-top: 5px

.class-chat__keyboard-hint
  margin-left: 8px
  color: #a8b5bd
  font-size: 9px
  white-space: nowrap

.class-chat__send
  display: flex
  align-items: center
  justify-content: center
  gap: 8px
  flex-shrink: 0
  min-width: 82px
  height: 34px
  padding: 0 13px
  border: 1px solid #417c6f
  border-radius: 9px
  background: #4e8b7a
  color: #fff
  font-size: 12px !important
  font-weight: 600 !important

  &:hover:not(:disabled)
    background: #3e7a69

  svg
    width: 14px
    height: 14px

.class-chat__attachment
  display: flex
  align-items: center
  gap: 10px
  margin-bottom: 8px
  padding: 8px 10px
  border: 1px solid #e3ecef
  border-radius: 10px
  background: #f6f9fa
  font-size: 11px
  color: #6b8493

  > img
    width: 36px
    height: 36px
    border-radius: 6px
    object-fit: cover

  > span
    min-width: 0

  > span:nth-last-child(2)
    flex: 1

  strong, small
    display: block
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  strong
    font-weight: 500

  small
    margin-top: 2px
    color: #9baeb8

@media (max-width: 640px)
  .class-chat__panel, .class-chat__panel.has-sidebar
    right: 10px
    bottom: unquote('max(10px, env(safe-area-inset-bottom))')
    width: calc(100vw - 20px)
    height: calc(100dvh - 40px - env(safe-area-inset-bottom))
    border-radius: 18px

  .class-chat__sidebar
    flex: 1
    width: 100%
    border-right: 0

  .class-chat__panel.has-sidebar
    &:not(.show-conversation) .class-chat__conversation
      display: none

    &.show-conversation .class-chat__sidebar
      display: none

    &.show-conversation .class-chat__back
      display: inline-flex

  .class-chat__top
    padding: 13px 17px

  .class-chat__conversation-header
    padding: 10px 14px
    gap: 8px
    min-height: 61px

  .class-chat__messages
    padding: 15px 14px

  .class-chat__composer
    padding: 10px 12px 12px

  .class-chat__keyboard-hint
    display: none

  .class-chat__input
    font-size: 16px !important

  .class-chat__quota
    display: none

@media (prefers-reduced-motion: reduce)
  .class-chat__panel
    animation: none

  .class-chat__launcher, .class-chat__icon-button
    transition: none
