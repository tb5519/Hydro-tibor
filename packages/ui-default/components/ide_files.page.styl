.ide-files
  display flex
  align-items center
  position relative
  border 1px solid var(--ui-v2-border, #dce5ec)
  border-radius 9px
  color var(--ui-v2-text-muted, #526a7b)
  background var(--ui-v2-surface-muted, #f8fafc)
  font-size 13px
  button
    display inline-flex
    gap 6px
    align-items center
    justify-content center
    border 0
    background transparent
    color inherit
    min-height 34px
    padding 0 9px
    font inherit
    cursor pointer
    border-radius 8px
    &:hover
      background var(--ui-v2-border, #e6edf4)
    &:focus-visible
      outline 2px solid #669dba
      outline-offset -2px
    &:disabled
      opacity .5
      cursor wait
  &__mode
    border-right 1px solid var(--ui-v2-border, #dce5ec) !important
    color var(--ui-v2-accent, #477e72) !important
  &__notice
    position absolute
    top calc(100% + 10px)
    right 0
    width max-content
    max-width unquote('min(420px, 85vw)')
    background #f4fcf8
    color #34705c
    border 1px solid #cbe6d9
    border-radius 10px
    padding 10px 14px
    box-shadow 0 5px 20px #122a3414
    z-index 110
    &.is-error
      background #fff7ed
      border-color #f3d7b5
      color #925e2f
    button
      font-size 12px
      text-decoration underline
      min-height 24px

.ide-files-dialog
  box-sizing border-box
  width unquote('min(480px, calc(100vw - 32px))')
  max-height unquote('min(620px, calc(100dvh - 40px))')
  margin auto
  padding 24px
  border 1px solid #e1e9ef
  border-radius 22px
  background #fff
  color #293c50
  box-shadow 0 24px 90px #12273738
  font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif
  font-size 14px
  line-height 1.5
  &::backdrop
    background #172b4655
    backdrop-filter blur(4px)
  *, *:before, *:after
    box-sizing border-box
  header
    display flex
    gap 13px
    align-items center
    margin-bottom 22px
    h2
      margin 0
      color #263b50
      font-size 20px
      font-weight 650
    p
      margin 3px 0 0
      color #8493a2
      font-size 12px
  &__heading-icon
    display flex
    align-items center
    justify-content center
    height 44px
    width 44px
    border-radius 14px
    background #eaf5f0
    color #4c8776
    svg
      height 25px
      width 25px
  button
    cursor pointer
    border 1px solid #dde6ee
    border-radius 10px
    background #fff
    padding 8px 14px
    color #526a7b
    font inherit
    &:hover
      background #f2f7fa
    &:disabled
      opacity .55
      cursor wait
    &:focus-visible
      outline 2px solid #5b9b88
      outline-offset 2px
    &.is-primary
      background #3d7e6b
      border-color #3d7e6b
      color #fff
      padding-inline 26px
  &__close
    margin-left auto
    border 0 !important
    font-size 24px !important
    padding 0 9px !important
    color #8496a4 !important
  input
    display block
    width 100%
    border 1px solid #dce6ec
    border-radius 10px
    background #f8fafb
    height 44px
    padding 0 12px
    color #293c50
    font inherit
    box-shadow none
    margin 7px 0 0
    &:focus
      outline 2px solid #a5d1c4
      border-color #7aaf9e
  label
    font-size 13px
    font-weight 600
  footer
    display flex
    gap 9px
    align-items center
    justify-content flex-end
    padding-top 20px
    span
      color #8a9baa
      font-size 12px
      margin-right auto
  &__search
    display flex
    align-items center
    gap 14px
    margin-bottom 12px
    input
      margin 0
    span
      font-size 12px
      color #8a9baa
      white-space nowrap
  &__list
    max-height 330px
    overflow auto
    min-height 150px
  &__row
    display flex
    align-items center
    border-bottom 1px solid #eef3f6
    gap 4px
  &__file
    display flex
    align-items center
    text-align left
    border 0 !important
    gap 13px
    flex 1
    min-width 0
    padding 13px 8px !important
    > svg
      flex-shrink 0
      color #73a894
    > span
      min-width 0
    strong
      display block
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
      font-weight 550
      color #30485b
    small
      display block
      margin-top 3px
      color #8a9baa
      font-size 11px
  &__arrow
    margin-left auto
    color #8eaaa2
  &__delete
    border 0 !important
    padding 8px !important
    color #9cabb8 !important
    &:hover
      color #b76c6c !important
      background #fff4f3 !important
  &__empty
    color #8a9baa
    text-align center
    padding 35px 10px
    svg
      width 32px
      height 32px
      color #abc6b9
    p
      margin 12px 0
      font-size 13px
  &__error
    border-radius 8px
    padding 10px 12px
    background #fff4ed
    color #a2693d
    margin 12px 0 0
    font-size 12px
    button
      margin-left 8px
      padding 2px 6px

@media (max-width: 600px)
  .ide-files
    font-size 12px
    button
      padding 0 7px
    &__mode span
      display none
  .ide-files-dialog
    padding 20px
