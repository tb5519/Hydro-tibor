.user-profile-avatar
  border-radius: 50% !important

.user-profile-badge
  display: inline-block !important
  font-size: rem(12px) !important
  padding: rem(3px 4px) !important
  line-height: 1 !important

  &:hover
    text-decoration: none !important

for n in (1..21)
  .user-profile-bg--{n}
    background-image: url('backgrounds/' + n + '.jpg')

  .user-profile-bg--thumbnail-{n}
    background-image: url('backgrounds/thumbnail/' + n + '.jpg')

for key, _ in $badge-bg-color
  .badge--{key}
    background-color: $badge-bg-color[key] !important
    color: $badge-text-color[key] !important

// Display the uploaded badge artwork at its own shape, without a capsule or cropping.
.user-profile-badge[data-badge-icon-state='loading']
  // Reserve the label's slot without showing a text pill or an empty colored box.
  visibility: hidden !important
  pointer-events: none

  > [data-badge-icon-fallback]
    visibility: hidden !important

.user-profile-badge[data-badge-icon-state='ready']
  position: relative
  display: inline-flex !important
  align-items: center
  justify-content: center
  flex: 0 1 auto
  max-width: min(var(--badge-icon-max-width, 180px), 100%) !important
  height: var(--badge-icon-height, 26px)
  min-height: 0
  padding: 0 !important
  border: 0 !important
  border-radius: 0 !important
  background: transparent !important
  box-shadow: none !important
  overflow: visible !important
  vertical-align: middle

  > [data-badge-icon-fallback]
    display: none !important

  > img[data-badge-icon]
    display: block !important
    position: static !important
    width: auto !important
    height: var(--badge-icon-height, 26px) !important
    max-width: 100% !important
    margin: 0 !important
    padding: 0 !important
    border: 0 !important
    border-radius: 0 !important
    object-fit: contain
    object-position: center

  &:not(.ui-v2-user-detail-badge-row__selector)::after
    display: none !important

.user-profile-badge[data-badge-icon-state='ready'][data-badge-icon-reveal='fade']
  // Animate the artwork and its sweep together; cached nodes never get this flag.
  animation: badge-icon-reveal 260ms ease-out both

@keyframes badge-icon-reveal
  from
    opacity: 0
  to
    opacity: 1

img[data-badge-icon][hidden]
  display: none !important

// The white bitmap keeps the uploaded image's alpha. Only this local gradient
// moves, so CDN redirects never need CORS permission for an external mask.
.user-profile-badge > img[data-badge-icon-shine]
  display: none !important
  position: absolute !important
  inset: 0
  z-index: 1
  width: 100% !important
  height: 100% !important
  max-width: none !important
  margin: 0 !important
  padding: 0 !important
  border: 0 !important
  border-radius: 0 !important
  object-fit: contain
  object-position: center
  pointer-events: none
  user-select: none

@supports (mask-image: linear-gradient(white, transparent)) or (-webkit-mask-image: linear-gradient(white, transparent))
  .user-profile-badge[data-badge-icon-state='ready'] > img[data-badge-icon-shine]
    display: block !important
    filter: brightness(0) invert(1)
    opacity: .68
    -webkit-mask-image: linear-gradient(110deg, transparent 43%, rgba(0, 0, 0, .12) 46%, black 50%, rgba(0, 0, 0, .12) 54%, transparent 57%)
    mask-image: linear-gradient(110deg, transparent 43%, rgba(0, 0, 0, .12) 46%, black 50%, rgba(0, 0, 0, .12) 54%, transparent 57%)
    -webkit-mask-size: 300% 100%
    mask-size: 300% 100%
    -webkit-mask-repeat: no-repeat
    mask-repeat: no-repeat
    animation: badge-icon-sweep 4.8s ease-in-out infinite

@keyframes badge-icon-sweep
  0%, 44%
    -webkit-mask-position: 150% 0
    mask-position: 150% 0
  76%, 100%
    -webkit-mask-position: -50% 0
    mask-position: -50% 0

@media (prefers-reduced-motion: reduce)
  .user-profile-badge[data-badge-icon-reveal='fade']
    animation: none !important

  .user-profile-badge > img[data-badge-icon-shine]
    display: none !important
    animation: none !important

@media (max-width: 767px)
  .user-profile-badge[data-badge-icon-state='ready']
    max-width: min(132px, 100%) !important
