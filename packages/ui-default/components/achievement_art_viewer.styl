// A quiet, full-resolution inspection layer. The automatic achievement reveal
// keeps its own animation, sound and acknowledgement lifecycle.
.achievement-art-viewer
  --achievement-viewer-height: 100vh
  position: fixed
  inset: 0
  z-index: 100030
  display: grid
  place-items: center
  box-sizing: border-box
  width: 100%
  height: var(--achievement-viewer-height)
  max-width: none
  max-height: none
  margin: 0
  border: 0
  padding: 28px 24px
  padding-top: unquote('max(28px, env(safe-area-inset-top))')
  padding-bottom: unquote('max(24px, env(safe-area-inset-bottom))')
  overflow: hidden
  isolation: isolate
  color: #f8f3e8
  background: rgba(7, 16, 32, .91)
  backdrop-filter: blur(12px)
  -webkit-backdrop-filter: blur(12px)
  font-family: inherit
  text-align: center
  color-scheme: dark
  opacity: 0
  outline: none
  cursor: zoom-out
  transition: opacity .2s ease
  -webkit-tap-highlight-color: transparent

  *, *::before, *::after
    box-sizing: border-box

  &:not([open])
    display: none

  &::backdrop
    background: transparent

  [hidden]
    display: none !important

  &::before
    content: ''
    position: absolute
    inset: 0
    z-index: -1
    pointer-events: none
    background: radial-gradient(ellipse at 50% 36%, rgba(186, 148, 76, .13), transparent 48%), radial-gradient(ellipse at 18% 100%, rgba(57, 92, 153, .18), transparent 62%)

  &.is-visible
    opacity: 1

  &.is-leaving
    opacity: 0
    pointer-events: auto
    transition-duration: .18s

  &__ambient
    position: absolute
    inset: 0
    z-index: -1
    pointer-events: none

  &__content
    position: relative
    display: flex
    flex-direction: column
    align-items: center
    width: unquote('min(820px, 100%)')
    max-height: calc(var(--achievement-viewer-height) - 56px)
    min-height: 0
    transform: translateY(8px) scale(.985)
    opacity: 0
    transition: opacity .24s ease, transform .3s cubic-bezier(.2, .75, .25, 1)

  &.is-visible &__content
    transform: translateY(0) scale(1)
    opacity: 1

  &.is-leaving &__content
    transform: translateY(-5px) scale(.985)
    opacity: 0
    transition-duration: .18s

  &__art
    position: relative
    display: grid
    place-items: center
    flex: 0 1 auto
    width: unquote('min(680px, 100%)')
    height: unquote('min(560px, calc(var(--achievement-viewer-height) * .58))')
    min-height: 0
    margin: 0 0 22px
    user-select: none

    .achievement-art-viewer__image
      position: absolute
      inset: 0
      display: block
      min-width: 0
      min-height: 0
      width: 100%
      height: 100%
      max-width: 100%
      max-height: 100%
      object-fit: contain
      object-position: center
      opacity: 0
      transform: translateY(4px) scale(.94)
      filter: drop-shadow(0 14px 26px rgba(0, 0, 0, .23))
      transition: opacity .3s ease, transform .46s cubic-bezier(.16, .8, .25, 1)
      -webkit-user-drag: none

  &.is-ready &__image
    opacity: 1
    transform: translateY(0) scale(1)

  &.is-leaving &__image
    opacity: 0
    transform: scale(.98)
    transition-duration: .16s

  // A soft impression of the already-loaded thumbnail welcomes the reader.
  // All repeated motion uses opacity/transform; the small-image blur is static.
  &__welcome
    position: absolute
    inset: 0
    display: grid
    place-items: center
    pointer-events: none
    opacity: 1
    transition: opacity .36s ease

  &__aura
    position: absolute
    inset: 2% 9%
    border-radius: 50%
    background: radial-gradient(ellipse, rgba(214, 178, 105, .18), rgba(84, 125, 177, .09) 40%, transparent 69%)
    animation: achievement-art-aura 3.2s ease-in-out infinite

  &__silhouette
    position: absolute
    inset: 0
    display: block
    width: 100%
    height: 100%
    min-width: 0
    min-height: 0
    object-fit: contain
    object-position: center
    filter: blur(10px) saturate(.72)
    opacity: .3
    transform: scale(.88)
    animation: achievement-art-silhouette 3.2s ease-in-out infinite
    -webkit-user-drag: none

  &__ring
    position: absolute
    z-index: 1
    width: unquote('min(92%, 500px)')
    height: 84%
    max-height: 470px
    border-radius: 50%
    opacity: .95
    transform: scale(.92)
    transition: opacity .4s ease, transform .48s cubic-bezier(.12, .75, .25, 1)

    &::before, &::after
      content: ''
      position: absolute
      inset: 0
      border: 1px solid transparent
      border-radius: 50%

    &::before
      border-top-color: rgba(238, 203, 132, .96)
      border-right-color: rgba(222, 190, 126, .2)
      border-bottom-color: rgba(222, 190, 126, .18)
      transform: rotate(-28deg) scaleY(.54)
      box-shadow: 0 -2px 12px -3px rgba(237, 200, 132, .16)
      animation: achievement-art-orbit-gold 8s linear infinite

    &::after
      inset: 3% 7%
      border-top-color: rgba(122, 174, 221, .18)
      border-left-color: rgba(122, 174, 221, .4)
      border-bottom-color: rgba(146, 196, 239, .88)
      transform: rotate(30deg) scaleY(.6)
      box-shadow: 0 2px 11px -3px rgba(122, 174, 221, .12)
      animation: achievement-art-orbit-blue 11s linear infinite

  &__spark
    position: absolute
    z-index: 2
    width: 4px
    height: 4px
    border-radius: 50%
    background: #f0d59b
    box-shadow: 0 0 10px 2px rgba(225, 193, 125, .42)
    opacity: 0
    animation: achievement-art-spark 3s ease-in-out infinite

    &[data-index="0"]
      left: 24%
      top: 24%
      --spark-x: 38px
      --spark-y: 30px
      animation-delay: -.2s

    &[data-index="1"]
      left: 71%
      top: 20%
      --spark-x: -31px
      --spark-y: 38px
      animation-delay: -1.8s

    &[data-index="2"]
      left: 17%
      top: 58%
      --spark-x: 44px
      --spark-y: -9px
      animation-delay: -1.1s

    &[data-index="3"]
      left: 79%
      top: 63%
      --spark-x: -40px
      --spark-y: -21px
      animation-delay: -2.4s

    &[data-index="4"]
      left: 38%
      top: 84%
      --spark-x: 16px
      --spark-y: -40px
      animation-delay: -2.8s

    &[data-index="5"]
      left: 61%
      top: 78%
      --spark-x: -16px
      --spark-y: -36px
      background: #b7d6f1
      box-shadow: 0 0 9px 2px rgba(143, 186, 227, .32)
      animation-delay: -.7s

  &.is-ready &__welcome
    opacity: 0

  &.is-ready &__aura
    animation: achievement-art-bloom .48s ease-out both

  &.is-ready &__ring
    transform: scale(1.16)
    opacity: 0

  &.is-leaving &__welcome
    opacity: 0
    transition-duration: .16s

  &__copy
    flex: 0 0 auto
    width: unquote('min(620px, 100%)')
    min-width: 0

  &__eyebrow
    margin: 0 0 8px
    color: #cbb47e
    font-size: 10px
    font-weight: 500
    line-height: 1.6
    letter-spacing: .25em

  &__title
    margin: 0 0 12px
    color: #faf5e9
    font-size: unquote('clamp(23px, 3.4vw, 34px)')
    font-weight: 650
    line-height: 1.3
    letter-spacing: .08em
    overflow-wrap: anywhere
    text-shadow: 0 2px 18px rgba(212, 180, 110, .1)

  &__description
    max-width: 520px
    margin: 0 auto
    color: #bdc9d9
    font-size: 13px
    line-height: 1.8
    overflow-wrap: anywhere

  &__date
    display: block
    margin: 10px 0 0
    color: #9aaac0
    font-size: 11px
    line-height: 1.6
    font-variant-numeric: tabular-nums

  &__hint
    flex: 0 0 auto
    margin: 25px 0 0
    color: #aab8ca
    font-size: 11px
    line-height: 1.7
    letter-spacing: .06em
    user-select: none

    &::before
      content: ''
      display: block
      width: 42px
      height: 1px
      margin: 0 auto 14px
      background: linear-gradient(90deg, transparent, rgba(204, 177, 118, .6), transparent)

  &__status
    position: absolute
    inset: 0
    display: flex
    flex-direction: column
    align-items: center
    justify-content: center
    gap: 16px
    max-width: 350px
    margin: 0 auto
    padding: 24px
    color: #c0cbdb
    font-size: 13px
    line-height: 1.8
    text-align: center

  &.is-loading &__status
    inset: auto
    width: 1px
    height: 1px
    margin: -1px
    padding: 0
    overflow: hidden
    clip-path: inset(50%)
    white-space: nowrap

  &.is-error &__status
    color: #dfcda9

    &::before
      content: '✧'
      color: #baa479
      font-size: 36px
      line-height: 1

@supports (height: 100dvh)
  .achievement-art-viewer
    --achievement-viewer-height: 100dvh

@keyframes achievement-art-aura
  0%, 100%
    transform: scale(.92)
    opacity: .6
  50%
    transform: scale(1.04)
    opacity: 1

@keyframes achievement-art-silhouette
  0%, 100%
    transform: scale(.88)
    opacity: .28
  50%
    transform: scale(.92)
    opacity: .43

@keyframes achievement-art-orbit-gold
  from
    transform: rotate(-28deg) scaleY(.54)
  to
    transform: rotate(332deg) scaleY(.54)

@keyframes achievement-art-orbit-blue
  from
    transform: rotate(30deg) scaleY(.6)
  to
    transform: rotate(-330deg) scaleY(.6)

@keyframes achievement-art-spark
  0%, 100%
    transform: translate(0, 0) scale(.6)
    opacity: 0
  30%
    opacity: .95
  85%
    transform: translate(var(--spark-x), var(--spark-y)) scale(.2)
    opacity: 0

@keyframes achievement-art-bloom
  from
    transform: scale(.96)
    opacity: 1
  to
    transform: scale(1.25)
    opacity: 0

@media (max-width: 640px)
  .achievement-art-viewer
    padding-left: 20px
    padding-right: 20px

    &__art
      height: unquote('min(500px, calc(var(--achievement-viewer-height) * .52))')
      margin-bottom: 22px

    &__title
      margin-bottom: 10px
      font-size: 26px
      letter-spacing: .05em

    &__description
      max-width: 340px
      font-size: 12px
      line-height: 1.75

    &__hint
      margin-top: 22px
      font-size: 10px

// Fit a phone held sideways without shrinking the explanation to unreadable text.
@media (max-height: 520px) and (min-width: 560px)
  .achievement-art-viewer
    padding: 18px 28px
    padding-left: unquote('max(28px, env(safe-area-inset-left))')
    padding-right: unquote('max(28px, env(safe-area-inset-right))')

    &__content
      display: grid
      grid-template-columns: minmax(0, 1fr) minmax(0, .9fr)
      grid-template-rows: minmax(0, 1fr) auto
      gap: 0 24px
      max-height: calc(var(--achievement-viewer-height) - 36px)
      width: unquote('min(900px, 100%)')

    &__art
      width: 100%
      height: calc(var(--achievement-viewer-height) - 92px)
      margin: 0
      grid-row: 1 / 3

    &__copy
      align-self: center
      padding-top: 10px

    &__title
      font-size: 25px

    &__description
      font-size: 12px
      line-height: 1.7

    &__hint
      margin: 10px 0 0
      padding-bottom: 7px
      font-size: 10px

      &::before
        margin-bottom: 9px

@media (max-height: 570px) and (max-width: 559px)
  .achievement-art-viewer
    padding-top: 15px
    padding-bottom: 15px

    &__art
      height: calc(var(--achievement-viewer-height) * .42)
      margin-bottom: 15px

    &__eyebrow
      margin-bottom: 5px

    &__title
      margin-bottom: 7px
      font-size: 23px

    &__description
      font-size: 11px
      line-height: 1.6

    &__date
      margin-top: 6px
      font-size: 10px

    &__hint
      margin-top: 15px

      &::before
        margin-bottom: 8px

@media (prefers-reduced-motion: reduce)
  .achievement-art-viewer,
  .achievement-art-viewer__content,
  .achievement-art-viewer__image,
  .achievement-art-viewer__welcome,
  .achievement-art-viewer__ring
    transition: none !important
    transform: none !important

  .achievement-art-viewer__aura,
  .achievement-art-viewer__silhouette,
  .achievement-art-viewer__spark,
  .achievement-art-viewer__ring::before,
  .achievement-art-viewer__ring::after
    animation: none !important

  .achievement-art-viewer__spark
    opacity: .25
