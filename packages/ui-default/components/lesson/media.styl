.lesson-media
  position: fixed
  right: 22px
  bottom: 86px
  z-index: 2147483005
  box-sizing: border-box
  width: 360px
  max-width: calc(100vw - 16px)
  overflow: hidden
  border: 1px solid #34435b
  border-radius: 16px
  background: #111b2d
  color: #f8fafc
  box-shadow: 0 16px 48px rgba(15, 23, 42, .25)
  font-family: system-ui, -apple-system, sans-serif
  text-align: left

  &[hidden], [hidden]
    display: none !important

  *, *::before, *::after
    box-sizing: border-box

  &__header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 8px
    padding: 12px
    cursor: move
    touch-action: none
    user-select: none

    strong
      display: block
      margin-top: 2px
      font-size: 14px
      line-height: 1.4
      color: #f8fafc

  &__eyebrow
    font-size: 10px
    letter-spacing: .08em
    color: #a5b4fc

  &__peer
    font-size: 11px
    color: #cbd5e1

  &__grid
    display: grid
    grid-template-columns: 1fr 1fr
    gap: 6px
    padding: 0 8px

  &__tile
    position: relative
    display: grid
    place-items: center
    aspect-ratio: 4 / 3
    overflow: hidden
    border-radius: 10px
    background: #243044

    video, img
      position: absolute
      inset: 0
      width: 100%
      height: 100%
      max-width: none
      object-fit: cover

    video
      transform: scaleX(-1)

  &__placeholder
    padding: 16px
    font-size: 12px
    color: #cbd5e1
    text-align: center

  &__name
    position: absolute
    bottom: 5px
    left: 5px
    z-index: 1
    padding: 3px 6px
    border-radius: 5px
    background: rgba(17, 24, 39, .8)
    color: #f8fafc
    font-size: 11px
    line-height: 1.3

  &__status
    margin: 0
    padding: 8px 10px
    color: #cbd5e1
    font-size: 11px
    line-height: 1.6

  &__controls
    display: flex
    flex-wrap: wrap
    gap: 5px
    padding: 0 8px 8px

    button
      height: auto
      margin: 0
      padding: 7px 8px
      border: 1px solid #475569
      border-radius: 7px
      background: #263449
      color: #f8fafc
      font: inherit
      font-size: 11px
      line-height: 1.3
      cursor: pointer

      &:hover
        background: #344961

      &:focus-visible
        outline: 2px solid #a5b4fc
        outline-offset: 2px

      &:disabled
        opacity: .55
        cursor: wait

      &[aria-pressed="true"]
        background: #334779

      &.is-danger
        border-color: #dc2626
        background: #b91c1c

  &__pip-composite
    position: absolute
    width: 1px
    height: 1px
    opacity: 0
    pointer-events: none

@media (max-width: 520px)
  .lesson-media
    right: 8px
    bottom: 76px
    width: 320px

@media (prefers-reduced-motion: reduce)
  .lesson-media
    transition: none
