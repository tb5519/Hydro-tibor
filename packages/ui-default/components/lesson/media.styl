.lesson-media
  --lesson-dock-bottom: 86px
  position: fixed
  right: 22px
  bottom: var(--lesson-dock-bottom)
  z-index: 2147483005
  box-sizing: border-box
  display: flex
  flex-direction: column
  width: 220px
  max-width: calc(100vw - 16px)
  max-height: calc(100vh - var(--lesson-dock-bottom) - 8px)
  overflow: hidden
  border: 1px solid #34435b
  border-radius: 16px
  background: #111b2d
  color: #f8fafc
  box-shadow: 0 16px 48px rgba(15, 23, 42, .25)
  font-family: system-ui, -apple-system, sans-serif
  text-align: left

  &[hidden], [hidden]
    display: none !important

  *, *::before, *::after
    box-sizing: border-box

  &__header
    display: flex
    flex-shrink: 0
    align-items: center
    justify-content: space-between
    gap: 8px
    padding: 5px 8px
    cursor: move
    touch-action: none
    user-select: none

    strong
      margin-left: 6px
      font-size: 13px
      line-height: 1.4
      color: #f8fafc

  &__eyebrow
    font-size: 10px
    letter-spacing: .08em
    color: #a5b4fc

  &__peer
    font-size: 11px
    color: #cbd5e1

  &__grid
    display: grid
    grid-template-columns: minmax(0, 1fr)
    gap: 1px

  &__content
    min-height: 0
    overflow: auto
    flex: 1 1 auto
    scrollbar-width: thin

  &__tile
    position: relative
    display: grid
    place-items: center
    aspect-ratio: 16 / 9
    overflow: hidden
    background: #243044

    video, img, canvas
      position: absolute
      inset: 0
      width: 100%
      height: 100%
      max-width: none
      object-fit: cover

    video, .lesson-media__preview
      transform: scaleX(-1)

    img[data-lesson-remote-screen]
      object-fit: contain
      transform: none
      background: #0b1220

    &.is-compact
      height: 40px
      aspect-ratio: auto

      .lesson-media__name, .lesson-media__placeholder
        position: absolute
        left: 6px
        right: var(--controls-space, 6px)
        max-width: none
        padding: 0
        overflow: hidden
        line-height: 14px
        text-align: left
        text-overflow: ellipsis
        white-space: nowrap

      .lesson-media__name
        top: 4px
        bottom: auto
        background: transparent

      .lesson-media__placeholder
        bottom: 4px
        font-size: 10px

  &__beauty
    display: grid
    gap: 5px
    padding: 8px
    border: 1px solid #475569
    border-radius: 8px
    background: #1e293b

    label
      display: grid
      grid-template-columns: 26px 1fr 22px
      align-items: center
      gap: 5px
      color: #f8fafc
      font-size: 11px

    input
      min-width: 0
      width: 100%
      height: 18px
      margin: 0
      accent-color: #a5b4fc

    output
      text-align: right
      color: #cbd5e1

  &__beauty-title
    color: #e2e8f0
    font-size: 11px

  &__tile-controls
    position: absolute
    bottom: 5px
    right: 5px
    z-index: 4
    display: flex
    gap: 4px

  &__tile.is-screen &__name
    max-width: calc(100% - 42px)

  &__screen-consent
    margin: 6px 8px
    padding: 8px
    border: 1px solid #64748b
    border-radius: 8px
    background: #1e293b
    font-size: 11px
    line-height: 1.5

    strong
      display: block
      font-size: 12px

    p
      margin: 4px 0 6px
      color: #cbd5e1

  &__screen-actions
    display: flex
    gap: 5px
    flex-wrap: wrap

    button
      border: 1px solid #64748b
      border-radius: 6px
      background: #334155
      color: #f8fafc
      padding: 5px 7px
      font: inherit
      cursor: pointer

      &:first-child
        background: #4338ca

  &__screen-status
    font-size: 10px
    line-height: 1.5
    margin: 5px 10px
    color: #cbd5e1

  &__icon
    display: grid
    place-items: center
    width: 28px
    height: 28px
    padding: 5px
    margin: 0
    border: 1px solid #ffffff40
    border-radius: 7px
    background: #111827db
    color: #f8fafc
    cursor: pointer

    &[data-lesson-screen-toggle][aria-pressed="true"]
      background: #4338ca

    &[data-lesson-screen-stop]
      background: #7f1d1de8
      color: #fecaca

    svg
      width: 17px
      height: 17px
      fill: none
      stroke: currentColor
      stroke-width: 1.8
      stroke-linecap: round
      stroke-linejoin: round

    &[data-state="off"]
      color: #fecaca
      background: #7f1d1de8
      border-color: #f8717180

    &[data-state="on"] .lesson-media__icon-slash
      display: none

    &[aria-expanded="true"]
      background: #4338ca

    &:disabled
      opacity: .55
      cursor: wait

  button:focus-visible
    outline: 2px solid #a5b4fc
    outline-offset: 2px

  &__placeholder
    padding: 16px
    font-size: 12px
    color: #cbd5e1
    text-align: center

  &__name
    z-index: 2
    max-width: calc(100% - 90px)
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
    position: absolute
    bottom: 5px
    left: 5px
    z-index: 1
    padding: 3px 6px
    border-radius: 5px
    background: rgba(17, 24, 39, .8)
    color: #f8fafc
    font-size: 11px
    line-height: 1.3

  &__status
    margin: 0
    padding: 6px 10px
    color: #cbd5e1
    font-size: 11px
    line-height: 1.6

  &__controls
    position: relative
    z-index: 5
    flex-shrink: 0
    display: flex
    flex-wrap: wrap
    gap: 5px
    padding: 8px
    border-top: 1px solid #34435b
    background: #111827

    button
      height: auto
      margin: 0
      padding: 6px 8px
      border: 1px solid #475569
      border-radius: 7px
      background: #263449
      color: #f8fafc
      font: inherit
      font-size: 11px
      line-height: 1.3
      cursor: pointer

      &:hover
        background: #344961

      &:focus-visible
        outline: 2px solid #a5b4fc
        outline-offset: 2px

      &:disabled
        opacity: .55
        cursor: wait

      &[aria-pressed="true"]
        background: #334779

      &.is-danger
        border-color: #dc2626
        background: #b91c1c

  &__exit
    position: absolute
    inset: 0
    z-index: 20
    display: grid
    place-items: center
    padding: 14px
    background: #0f172aeb

  &__exit-card
    width: 100%
    padding: 16px 12px
    border: 1px solid #64748b
    border-radius: 12px
    background: #1e293b

    strong
      font-size: 16px

    p
      margin: 12px 0 18px
      color: #cbd5e1
      font-size: 12px
      line-height: 1.7

  &__exit-actions
    display: flex
    justify-content: flex-end
    gap: 8px

    button
      margin: 0
      padding: 6px 8px
      border: 1px solid #475569
      border-radius: 6px
      background: #263449
      color: #f8fafc
      font: inherit
      font-size: 11px
      line-height: 1.3
      cursor: pointer

      &.is-danger
        border-color: #dc2626
        background: #b91c1c

  &__pip-composite
    position: absolute
    width: 1px
    height: 1px
    opacity: 0
    pointer-events: none

@media (max-width: 520px)
  .lesson-media
    right: 8px
    --lesson-dock-bottom: 76px
    width: 220px

@media (max-height: 500px)
  .lesson-media
    --lesson-dock-bottom: 8px

@media (prefers-reduced-motion: reduce)
  .lesson-media
    transition: none
