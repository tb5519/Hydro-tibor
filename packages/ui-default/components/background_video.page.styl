[data-loop-background]
  position: relative
  overflow: hidden

  > .loop-background__video
    position: absolute
    inset: 0
    display: block
    width: 100%
    height: 100%
    object-fit: cover
    pointer-events: none
    opacity: 0
    transition: opacity .35s ease

  &.is-video-playing > .loop-background__video
    opacity: 1

[data-video-upload-status]
  min-height: 1.5em
  margin: 10px 0 0
  color: #527589
  font-size: 13px
  line-height: 1.6

  &.is-error
    color: #b95448

@media (prefers-reduced-motion: reduce)
  [data-loop-background] > .loop-background__video
    transition: none
    display: none
