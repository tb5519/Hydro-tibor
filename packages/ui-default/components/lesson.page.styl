@import './lesson/media.styl'

.lesson-picker, .lesson-reminder, .lesson-session, .lesson-home-card, .lesson-toast
  box-sizing border-box
  font-family var(--font-family, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif)
  font-size 14px
  line-height 1.5
  color #233750
  text-align left
  &[hidden]
    display none !important
  [hidden]
    display none !important
  button, input
    box-sizing border-box
    font inherit
  button
    cursor pointer
  button:disabled
    cursor not-allowed
    opacity .5
  button:focus-visible, input:focus-visible
    outline 3px solid #9cc8ff
    outline-offset 3px
  h2, h3, p
    margin 0

.lesson-picker, .lesson-reminder
  position fixed
  margin auto
  padding 0
  width unquote('min(620px, calc(100vw - 32px))')
  max-height calc(100vh - 40px)
  max-height calc(100dvh - 40px)
  border 1px solid #dce6f1
  border-radius 22px
  background #fff
  box-shadow 0 24px 100px rgba(17, 37, 64, .22)
  overflow auto
  overscroll-behavior contain
  &::backdrop
    background rgba(29, 45, 67, .36)
    backdrop-filter blur(3px)

.lesson-picker
  padding 26px
  &__header
    display flex
    justify-content space-between
    align-items center
    gap 16px
    margin-bottom 22px
    h2
      margin-top 4px
      font-size 26px
      font-weight 750
      letter-spacing -.6px
  &__modes
    display grid
    grid-template-columns 1fr 1fr
    gap 5px
    padding 5px
    margin-bottom 22px
    background #eef3f9
    border-radius 13px
  &__form
    display flex
    flex-direction column
    gap 14px
  &__selection
    color #567092
    font-size 12px
    margin-top -6px !important
  &__fields
    display grid
    grid-template-columns 1fr 145px
    gap 14px
  &__footer
    display flex
    align-items center
    justify-content space-between
    gap 12px
    padding-top 8px
    > span
      color #7a899e
      font-size 12px
  &__scheduled, &__history
    border-top 1px solid #e9eef5
    padding-top 20px
    margin-top 24px
    h3
      font-size 15px
      font-weight 700
      margin-bottom 10px

.lesson-history-item
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 14px 0
  & + &
    border-top 1px solid #edf1f6
  &__copy
    display flex
    flex-direction column
    gap 4px
    min-width 0
    strong
      color #2c4564
      font-size 13px
      overflow-wrap anywhere
    span
      color #7b8da5
      font-size 11px
    small
      color #ad7844
      font-size 11px
  &__actions
    display flex
    justify-content flex-end
    align-items center
    flex-wrap wrap
    gap 6px
    flex-shrink 0
    max-width 230px
    .lesson-button
      min-height 30px
      padding 5px 9px
      font-size 11px

.lesson-history-status
  padding 3px 7px
  border-radius 6px
  background #eef2f7
  color #7b8da5
  font-size 11px
  white-space nowrap
  &.is-open
    color #aa6d30
    background #fff4e7

.lesson-history-note
  color #8a9aaf
  font-size 11px
  padding-top 10px

.lesson-eyebrow
  color #5780ad
  font-size 12px
  font-weight 650
  letter-spacing 1px

.lesson-icon-button
  display flex
  align-items center
  justify-content center
  flex-shrink 0
  width 34px
  height 34px
  padding 0
  border 0
  border-radius 50%
  color #6d7d91
  background #f1f5fa
  font-size 24px !important

.lesson-mode
  border 0
  border-radius 9px
  padding 10px 14px
  background transparent
  color #718097
  font-weight 650 !important
  &.is-selected
    background white
    color #286be0
    box-shadow 0 2px 8px rgba(43, 74, 119, .09)

.lesson-field
  display flex
  flex-direction column
  gap 7px
  margin 0
  color #52667f
  font-size 13px
  font-weight 600
  input
    display block
    width 100%
    height 42px
    margin 0
    padding 10px 12px
    border 1px solid #dce5f1
    border-radius 10px
    background #fbfcfe
    color #223852
    box-shadow none
    font-weight 400
    &:focus
      border-color #7da8ef
      background white

.lesson-roster
  display grid
  grid-template-columns 1fr 1fr
  gap 8px
  max-height 205px
  overflow auto
  padding 3px
  margin -3px

.lesson-student
  display flex
  align-items center
  gap 10px
  min-width 0
  padding 10px
  border 1px solid #e4ebf4
  border-radius 12px
  background white
  text-align left
  &.is-selected
    border-color #4386ec
    background #f1f7ff
    box-shadow inset 0 0 0 1px #4386ec
  &__avatar
    display flex
    align-items center
    justify-content center
    flex-shrink 0
    width 34px
    height 34px
    border-radius 10px
    color #4a78bb
    background #edf4ff
    font-weight 700
  &__copy
    display flex
    flex-direction column
    min-width 0
    flex 1
    strong
      color #334d6c
      white-space nowrap
      overflow hidden
      text-overflow ellipsis
      font-size 14px
    small
      color #8492a6
      font-size 11px
  &__state
    color #8e9bad
    font-size 10px
    white-space nowrap
    &.is-online
      color #32946c
      &::before
        content '●'
        margin-right 4px
        font-size 8px

.lesson-button
  display inline-flex
  align-items center
  justify-content center
  flex-shrink 0
  min-height 36px
  padding 8px 14px
  margin 0
  border 1px solid #dce5ef
  border-radius 10px
  background #fff
  color #55708e
  font-weight 650 !important
  white-space nowrap
  &:hover:not(:disabled)
    background #f2f7ff
  &.is-primary
    background #3478eb
    border-color #3478eb
    color white
    box-shadow 0 3px 10px rgba(52, 120, 235, .14)
    &:hover:not(:disabled)
      background #2868d7
      border-color #2868d7
  &.is-danger
    color #b4555f
    border-color #f0d6da
    background #fff5f6

.lesson-text-button
  flex-shrink 0
  border 0
  padding 5px 7px
  background transparent
  color #7b8ca2
  font-size 12px !important
  &:hover:not(:disabled)
    color #326fd0

.lesson-error
  padding 10px 12px
  border-radius 9px
  color #a64954
  background #fff0f1
  font-size 13px

.lesson-empty
  grid-column 1 / -1
  padding 14px 0
  color #8a9aaf
  font-size 13px

.lesson-schedule-item
  display flex
  align-items center
  gap 10px
  min-width 0
  padding 12px 0
  & + &
    border-top 1px solid #edf1f6
  &__copy
    display flex
    flex 1
    min-width 0
    flex-direction column
    gap 3px
    strong
      color #2c4564
      font-size 13px
      font-weight 650
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
    span
      color #7b8da5
      font-size 12px
      line-height 1.6
  .lesson-button
    font-size 12px
    min-height 32px
    padding 6px 11px

.ui-pinned-contest.lesson-has-upcoming
  flex-wrap wrap
  align-items center
  gap 18px
  .ui-pinned-contest__main
    flex 1 1 250px
  .lesson-home-card
    flex 0 1 390px
    width 390px
    margin 0
    box-shadow none
    border 0
    border-left 1px solid #e4ecf6
    border-radius 0
    padding 0 0 0 22px

.lesson-home-card
  padding 16px 20px
  margin 0 0 18px
  background white
  border 1px solid #dce7f6
  border-radius 14px
  box-shadow 0 5px 18px rgba(39, 80, 138, .05)
  &__label
    color #437bc5
    font-size 12px
    font-weight 700
  &__zone
    display block
    color #97a5b7
    font-size 10px
    text-align right
    margin-top -6px
  .lesson-schedule-item
    padding 6px 0 12px
  .lesson-schedule-item__copy span
    color #597698
    font-size 12px

.lesson-reminder
  width unquote('min(410px, calc(100vw - 32px))')
  padding 32px
  text-align center
  &__icon
    display flex
    justify-content center
    align-items center
    width 66px
    height 66px
    margin 0 auto 18px
    color #3a7ee8
    background #eef5ff
    border-radius 22px
    font-size 35px
  h2
    font-size 25px
    font-weight 750
    color #263e60
  &__name
    margin-top 12px !important
    font-weight 600
    color #496581
  &__time
    margin-top 7px !important
    font-size 13px
    color #6c85a3
  &__note
    margin-top 20px !important
    font-size 12px
    color #8a9aaf
  &__actions
    display flex
    justify-content center
    gap 12px
    margin-top 24px
    > button
      flex 1
      padding 11px 12px
  .lesson-error
    margin-top 16px

.lesson-session
  display flex
  align-items center
  gap 10px
  position fixed
  left 50%
  bottom 15px
  transform translateX(-50%)
  z-index 2147483630
  max-width calc(100vw - 24px)
  padding 10px 12px 10px 16px
  border 1px solid #dce6f1
  border-radius 14px
  background rgba(255,255,255,.97)
  box-shadow 0 8px 36px rgba(37, 56, 83, .14)
  &__copy
    display flex
    flex-direction column
    min-width 100px
    max-width 300px
    strong
      font-size 13px
      overflow hidden
      white-space nowrap
      text-overflow ellipsis
    > span
      color #7b8da6
      font-size 11px
  .lesson-button
    font-size 12px
    padding 7px 11px
    min-height 32px
  &__modes
    display flex
    align-items center
    gap 4px
    padding 4px
    border-radius 9px
    background #eff4fb

.lesson-mode-button
  padding 6px 8px
  border 0
  border-radius 7px
  background transparent
  color #7b8fa8
  white-space nowrap
  font-size 11px !important
  &.is-selected
    color #316fd1
    background white
    box-shadow 0 1px 5px rgba(37, 66, 111, .07)

.lesson-toast
  position fixed
  top 24px
  left 50%
  z-index 2147483640
  transform translateX(-50%)
  max-width unquote('min(480px, calc(100vw - 32px))')
  padding 12px 18px
  border 1px solid #dbe6f4
  border-radius 12px
  background #fff
  box-shadow 0 8px 26px rgba(34, 55, 83, .12)

@media (max-width: 600px)
  .lesson-picker
    padding 20px
    &__fields
      grid-template-columns 1fr
    &__footer
      flex-direction column
      align-items stretch
      > span
        text-align center
  .lesson-roster
    grid-template-columns 1fr
  .lesson-history-item
    align-items flex-start
    flex-direction column
    &__actions
      max-width none
      justify-content flex-start
  .lesson-session
    flex-wrap wrap
    width calc(100vw - 24px)
    &__copy
      flex 1
      max-width none
    .lesson-button
      padding 7px 9px
  .ui-pinned-contest.lesson-has-upcoming .lesson-home-card
    flex-basis 100%
    width 100%
    border-left 0
    border-top 1px solid #e4ecf6
    padding 14px 0 0

html[data-mantine-color-scheme="dark"]
  .lesson-picker, .lesson-reminder, .lesson-home-card, .lesson-session, .lesson-toast
    background #202d40
    color #dce6f4
    border-color #3a4c67
    h2, h3, strong
      color #dce6f4
  .lesson-picker__modes, .lesson-icon-button
    background #2c3b51
  .lesson-mode.is-selected, .lesson-field input, .lesson-student, .lesson-button
    background #26374e
    border-color #3f5472
    color #c3d6f1
  .lesson-student.is-selected
    background #2d476a
  .lesson-button.is-primary
    background #397fe8
    color white
  .lesson-button.is-danger
    background #4c303f
    color #f5b7bd
