.teacher-assistant
  position: fixed
  z-index: 900
  width: 88px
  height: 44px
  font-family: var(--font-family, "PingFang SC", "Microsoft YaHei", sans-serif)
  font-size: 13px
  color: #34465c

  &, *
    box-sizing: border-box

  &[hidden], [hidden]
    display: none !important

  button, a
    -webkit-tap-highlight-color: transparent

  button
    font: inherit
    cursor: pointer

  button:focus-visible, a:focus-visible, summary:focus-visible, select:focus-visible
    outline: 3px solid #a9c6e6
    outline-offset: 3px

  svg
    display: block
    width: 20px
    height: 20px
    fill: none
    stroke: currentColor
    stroke-width: 1.65
    stroke-linecap: round
    stroke-linejoin: round

  &__toggle
    display: flex
    align-items: center
    justify-content: center
    gap: 7px
    width: 88px
    height: 44px
    margin: 0
    padding: 0
    border: 1px solid #dce4ed
    border-radius: 24px
    color: #6c8096
    background: #fffffff2
    box-shadow: 0 3px 14px #243e5c0c, 0 1px 2px #243e5c08
    touch-action: none
    user-select: none
    -webkit-user-select: none
    cursor: grab !important
    transition: color .18s ease, border-color .18s ease, box-shadow .18s ease

  &__toggle:hover, &.is-open &__toggle
    color: #416b9f
    border-color: #bdcfe2
    box-shadow: 0 5px 18px #243e5c14

  &.is-dragging &__toggle
    cursor: grabbing !important
    color: #416b9f
    box-shadow: 0 7px 22px #243e5c20

  &__mark
    display: grid
    place-items: center
    color: #7294ba

  &__label
    font-size: 12px
    font-weight: 600
    letter-spacing: .04em

  &__panel
    position: fixed
    width: 288px
    overflow-y: auto
    overscroll-behavior: contain
    padding: 20px 12px 10px
    border: 1px solid #e0e7ef
    border-radius: 20px
    background: #fff
    box-shadow: 0 16px 52px #2036511c, 0 3px 10px #20365108
    animation: teacher-assistant-appear .16s ease-out

  &__header
    display: flex
    align-items: flex-start
    justify-content: space-between
    gap: 12px
    padding: 0 8px 17px

  &__eyebrow
    display: block
    margin-bottom: 6px
    color: #93a3b6
    font-size: 10px
    font-weight: 650
    letter-spacing: .13em

  &__title
    margin: 0
    color: #2d4159
    font-size: 18px
    font-weight: 700
    line-height: 1.3

  &__close
    display: grid
    place-items: center
    width: 28px
    height: 28px
    padding: 0
    margin: -3px -3px 0 0
    border: 0
    border-radius: 9px
    color: #94a3b4
    background: transparent

    &:hover
      color: #526c88
      background: #f1f5f9

    svg
      width: 16px
      height: 16px

  &__links
    display: grid
    gap: 4px

  &__link
    display: flex
    align-items: center
    gap: 12px
    min-height: 65px
    padding: 10px
    border: 1px solid transparent
    border-radius: 13px
    color: #364d66
    text-decoration: none !important
    transition: background .15s ease

    &:hover
      color: #2d5b94
      background: #f4f7fb

  &__icon
    display: grid
    place-items: center
    flex: 0 0 38px
    width: 38px
    height: 38px
    border: 1px solid #e9eff6
    border-radius: 12px
    color: #6f8fb1
    background: #f3f7fc

  &__copy
    flex: 1
    min-width: 0

    strong
      display: block
      color: inherit
      font-size: 13px
      font-weight: 650
      line-height: 1.4

    > span
      display: block
      margin-top: 3px
      color: #8c9bac
      font-size: 11px
      line-height: 1.4

  &__arrow
    color: #b0bdcc
    font-size: 16px

  &__settings
    summary
      cursor: pointer
      list-style: none

      &::-webkit-details-marker
        display: none

    &[open] .teacher-assistant__chevron
      transform: rotate(180deg)

  &__setting-card
    display: grid
    gap: 7px
    margin: 0 6px 6px
    padding: 12px
    border: 1px solid #e3ebf3
    border-radius: 12px
    background: #f6f9fc

    label
      font-size: 12px
      font-weight: 650

    select
      width: 100%
      min-height: 36px
      padding: 0 8px
      border: 1px solid #d7e2ee
      border-radius: 8px
      background: #fff
      color: inherit
      font: inherit

    small
      color: #61768e
      font-size: 11px

      &.is-error
        color: #b34747

  &__footer
    display: flex
    align-items: center
    justify-content: space-between
    gap: 8px
    margin-top: 10px
    padding: 12px 8px 3px
    border-top: 1px solid #edf1f5
    color: #a0adbb
    font-size: 10px

  &__reset
    padding: 4px 0 4px 6px
    border: 0
    color: #8599b1
    background: none
    font-size: 10px !important

    &:hover
      color: #426c9d

  &__sr
    position: absolute
    width: 1px
    height: 1px
    padding: 0
    margin: -1px
    overflow: hidden
    clip-path: inset(50%)
    white-space: nowrap
    border: 0

html[data-mantine-color-scheme="dark"] .teacher-assistant
  &__toggle
    color: #afbdce
    border-color: #3a485a
    background: #263140f5
  &.is-open &__toggle, &.is-dragging &__toggle, &__toggle:hover
    color: #c4d7ed
    border-color: #617794
  &__mark
    color: #9cb9dc
  &__panel
    border-color: #38475a
    background: #202c3b
  &__title, &__link
    color: #dbe5f1
  &__link:hover, &__close:hover
    background: #2b3a4c
    color: #e7f0ff
  &__icon
    border-color: #3b4b5e
    background: #2b3a4c
    color: #9cb9dc
  &__footer
    border-color: #354355
  &__setting-card
    border-color: #3b4b5e
    background: #263446
    color: #dbe5f1
    select
      border-color: #4a5b70
      background: #202c3b
    small
      color: #acbed3
      &.is-error
        color: #f4a8a8

@keyframes teacher-assistant-appear
  from
    opacity: 0
    translate: 0 4px
  to
    opacity: 1
    translate: 0 0

@media (prefers-reduced-motion: reduce)
  .teacher-assistant__panel
    animation: none
  .teacher-assistant__toggle, .teacher-assistant__link
    transition: none

@media print
  .teacher-assistant
    display: none !important
