.achievement-reveal
  position: fixed
  inset: 0
  z-index: 100020
  display: grid
  place-items: center
  padding: 24px 16px
  box-sizing: border-box
  overflow: hidden
  color: #f8f2dc
  background: rgba(5, 10, 25, .94)
  backdrop-filter: blur(16px)
  opacity: 0
  transition: opacity .32s ease
  isolation: isolate
  outline: none

  &.is-visible
    opacity: 1

  &.is-leaving
    opacity: 0
    pointer-events: auto

  &::before
    content: ''
    position: absolute
    inset: 0
    z-index: -1
    background: radial-gradient(ellipse at 50% 36%, rgba(206, 162, 74, .17), transparent 55%), radial-gradient(ellipse at 80% 100%, rgba(46, 71, 127, .24), transparent 70%)

.achievement-reveal__sky
  position: absolute
  inset: 0
  overflow: hidden
  pointer-events: none

.achievement-reveal__star
  position: absolute
  left: var(--star-left)
  top: var(--star-top)
  width: 3px
  height: 3px
  border-radius: 50%
  background: #e5c681
  box-shadow: 0 0 12px rgba(255, 219, 130, .8)
  opacity: .5
  animation: achievement-star 4.8s ease-in-out infinite alternate
  animation-delay: unquote('calc(var(--star-index) * -.43s)')

.achievement-reveal__panel
  position: relative
  width: unquote('min(760px, 100%)')
  max-height: calc(100dvh - 48px)
  display: flex
  flex-direction: column
  align-items: center
  text-align: center
  transform: translateY(26px)
  opacity: 0
  transition: opacity .5s ease .1s, transform .65s cubic-bezier(.16, 1, .3, 1) .1s

  .is-visible &
    opacity: 1
    transform: translateY(0)

  .is-leaving &
    opacity: 0
    transform: translateY(-16px) scale(.97)
    transition: opacity .3s ease, transform .35s ease

.achievement-reveal__eyebrow
  flex-shrink: 0
  margin-bottom: 12px
  color: #cfb47a
  font-size: 11px
  font-weight: 600
  letter-spacing: .34em
  line-height: 1.6

.achievement-reveal__artwork
  flex-shrink: 0
  position: relative
  display: grid
  place-items: center
  width: unquote('min(340px, 52vw, 38dvh)')
  height: unquote('min(340px, 52vw, 38dvh)')
  margin: 14px 0 24px
  transform: scale(.65)
  filter: blur(10px)
  transition: transform 1s cubic-bezier(.16, 1, .3, 1), filter .8s ease

  .is-visible &
    transform: scale(1)
    filter: blur(0)

.achievement-reveal__orbit
  position: absolute
  inset: 7%
  border: 1px solid rgba(228, 191, 104, .46)
  border-radius: 50%
  box-shadow: 0 0 70px rgba(233, 184, 80, .12), inset 0 0 35px rgba(233, 184, 80, .08)
  animation: achievement-orbit 24s linear infinite

  &::before,
  &::after
    content: ''
    position: absolute
    inset: -13%
    border: 1px solid rgba(228, 191, 104, .16)
    transform: rotate(45deg)

  &::after
    inset: -5%
    border-style: dashed
    border-radius: 50%
    transform: rotate(15deg)

.achievement-reveal__image
  position: relative
  width: 100%
  height: 100%
  object-fit: contain
  filter: drop-shadow(0 18px 26px rgba(0, 0, 0, .45))

.achievement-reveal__fallback
  position: relative
  display: grid
  place-items: center
  width: 68%
  aspect-ratio: 1
  color: #f6d38a
  font-size: unquote('clamp(50px, 14vw, 124px)')
  text-shadow: 0 0 40px rgba(239, 182, 66, .5)

.achievement-reveal__title
  flex-shrink: 0
  margin: 0
  color: #fff2d1
  font-size: unquote('clamp(26px, 4vw, 40px)')
  font-weight: 700
  line-height: 1.25
  letter-spacing: .09em
  text-wrap: balance

.achievement-reveal__description
  margin: 14px 0 0
  max-width: 36em
  color: #b6c0d4
  font-size: 15px
  line-height: 1.6

.achievement-reveal__saved
  flex-shrink: 0
  margin: 24px 0 0
  color: #71839f
  font-size: 12px
  letter-spacing: .08em

.achievement-reveal__hint
  flex-shrink: 0
  margin-top: 16px
  color: #c8b990
  font-size: 12px
  line-height: 1.5
  letter-spacing: .06em
  opacity: .35
  transition: opacity .25s

  .is-ready &
    opacity: 1

.achievement-reveal--multiple
  .achievement-reveal__artwork
    width: unquote('min(160px, 26vw, 21dvh)')
    height: unquote('min(160px, 26vw, 21dvh)')
    margin: 6px 0 18px

  .achievement-reveal__title
    font-size: unquote('clamp(23px, 3vw, 32px)')

  .achievement-reveal__saved
    margin-top: 16px

.achievement-reveal__collection
  width: 100%
  min-height: 0
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 10px
  margin: 24px 0 0
  padding: 4px
  max-height: 30dvh
  overflow-y: auto
  overscroll-behavior: contain
  scrollbar-width: thin
  scrollbar-color: #8c7953 transparent
  list-style: none
  text-align: left

.achievement-reveal__tile
  display: flex
  align-items: center
  gap: 10px
  padding: 12px 10px
  border: 1px solid rgba(226, 199, 134, .15)
  border-radius: 12px
  background: rgba(213, 187, 123, .045)

.achievement-reveal__thumbnail
  flex: 0 0 48px
  width: 48px
  height: 48px
  display: grid
  place-items: center

  img
    width: 100%
    height: 100%
    object-fit: contain

  .achievement-reveal__fallback
    font-size: 32px

.achievement-reveal__tile-text
  min-width: 0
  display: flex
  flex-direction: column
  gap: 5px

.achievement-reveal__tile-name
  color: #ead9b1
  font-size: 13px
  line-height: 1.4

.achievement-reveal__tile-description
  color: #8e9ab0
  font-size: 10px
  line-height: 1.5

@keyframes achievement-orbit
  from
    transform: rotate(0)
  to
    transform: rotate(360deg)

@keyframes achievement-star
  from
    opacity: .18
    transform: scale(.7)
  to
    opacity: .7
    transform: scale(1.3)

@media (max-width: 40em)
  .achievement-reveal__collection
    grid-template-columns: repeat(2, minmax(0, 1fr))
    gap: 8px

  .achievement-reveal__thumbnail
    flex-basis: 36px
    width: 36px
    height: 36px

  .achievement-reveal__tile
    gap: 7px
    padding: 10px 7px

@media (max-height: 540px)
  .achievement-reveal
    padding: 12px 16px

  .achievement-reveal__panel
    max-height: calc(100dvh - 24px)

  .achievement-reveal__artwork
    width: 26dvh
    height: 26dvh
    margin: 0 0 10px

  .achievement-reveal__saved,
  .achievement-reveal__hint,
  .achievement-reveal__collection
    margin-top: 10px

@media (prefers-reduced-motion: reduce)
  .achievement-reveal,
  .achievement-reveal__panel,
  .achievement-reveal__artwork
    transition: none !important
    transform: none !important
    filter: none !important

  .achievement-reveal__orbit,
  .achievement-reveal__star
    animation: none !important
