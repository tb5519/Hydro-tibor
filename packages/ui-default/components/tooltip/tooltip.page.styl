.tooltip.drop-element
  pointer-events: none
  max-width: 100%
  max-height: 100vh
  // Include the gap and arrow in the box Tether measures and constrains.
  padding: 10px

  .drop-content
    transition: transform .1s ease-in-out
    background: #333
    color: #fff
    font-size: rem($font-size-small)
    padding: .7em 0.9em
    max-width: rem(250px)
    max-height: calc(100vh - 20px)
    overflow: hidden
    overflow-wrap: anywhere
    white-space: normal
    box-shadow: 1px 1px 4px rgba(#000, 0.3)
    line-height: 1
    position: relative
    transform: scale(.96)

  &:before
    content: ''
    display: block
    position: absolute
    width: 0
    height: 0
    border: 5px solid transparent
    pointer-events: none

  &.drop-after-open
    transition-delay: .4s

    .drop-content
      transition-delay: .4s

  &.drop-after-open .drop-content
    transform: scale(1) translateZ(0) !important

  // Arrows stay inside the measured padding, even at a viewport edge.
  &.drop-element-attached-bottom:before
    bottom: 0
    border-top-color: #333
  &.drop-element-attached-top:before
    top: 0
    border-bottom-color: #333
  &.drop-element-attached-center:before
    margin-left: -5px
    left: 50%
  &.drop-element-attached-left:before
    left: 10px
  &.drop-element-attached-right:before
    right: 10px

  &.drop-element-attached-middle.drop-element-attached-left:before
    top: 50%
    left: 0
    margin-top: -5px
    border-right-color: #333
  &.drop-element-attached-middle.drop-element-attached-right:before
    top: 50%
    right: 0
    margin-top: -5px
    border-left-color: #333

  &.drop-pinned:before
    display: none
