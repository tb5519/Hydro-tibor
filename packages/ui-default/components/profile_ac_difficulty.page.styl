.homepage-personal

  .profile-ac-difficulty
    margin-top: 18px
    padding: 20px 0 0
    overflow: hidden
    border-top: 1px solid #e4eaf3
    color: #263a53

    &, *
      box-sizing: border-box

    &__header
      display: flex
      align-items: center
      gap: 10px

      h2
        margin: 0
        font-size: 17px
        line-height: 1.5
        font-weight: 600
        letter-spacing: .02em
        color: #263a53

      p
        margin: 3px 0 0
        font-size: 11px
        line-height: 1.6
        color: #7a8ba1

    &__icon
      display: flex
      align-items: center
      justify-content: center
      flex: 0 0 36px
      width: 36px
      height: 36px
      border: 1px solid #dbe8fc
      border-radius: 12px
      background: #eaf2ff
      color: #4b7ecd

      svg
        width: 24px
        height: 24px

    &__summary
      display: flex
      align-items: center
      justify-content: space-between
      gap: 12px
      padding: 21px 0 19px
      margin-bottom: 14px
      border-bottom: 1px solid #eaf0f7

    &__summary-label
      font-size: 11px
      line-height: 1.5
      color: #7789a0

    &__total
      display: flex
      align-items: baseline
      gap: 7px
      margin-top: 3px
      font-variant-numeric: tabular-nums

      strong
        font-size: 35px
        line-height: 1.1
        font-weight: 650
        letter-spacing: -.04em
        color: #26466d

      span
        font-size: 12px
        color: #8392a5

    &__highest
      display: flex
      flex-direction: column
      align-items: center
      flex: 0 0 auto
      gap: 3px
      padding: 9px 13px
      border: 1px solid #e2e9f4
      border-radius: 12px
      background: rgba(#fff, .8)

      > span
        font-size: 10px
        color: #7f8ea3

      strong
        font-size: 20px
        line-height: 1.3
        font-weight: 600
        color: #5273a4

    &__summary-note
      max-width: 100px
      font-size: 11px
      line-height: 1.8
      text-align: right
      color: #8a99ad

    &__column-labels
      display: flex
      justify-content: space-between
      margin-bottom: 6px
      font-size: 10px
      line-height: 1.5
      color: #91a0b3

    &__levels
      margin: 0
      padding: 0
      list-style: none

    &__row
      --ac-difficulty-color: #5298ca
      display: flex
      align-items: center
      gap: 12px
      min-height: 31px
      font-variant-numeric: tabular-nums

      &[data-level='1']
        --ac-difficulty-color: #54a8b9
      &[data-level='2']
        --ac-difficulty-color: #4ba2c7
      &[data-level='3']
        --ac-difficulty-color: #548fd1
      &[data-level='4']
        --ac-difficulty-color: #647fd1
      &[data-level='5']
        --ac-difficulty-color: #7b79cc
      &[data-level='6']
        --ac-difficulty-color: #977bc2
      &[data-level='7']
        --ac-difficulty-color: #b182b4
      &[data-level='8']
        --ac-difficulty-color: #c18f83
      &[data-level='9']
        --ac-difficulty-color: #c59b58
      &[data-level='10']
        --ac-difficulty-color: #bb953f

    &__level
      display: flex
      align-items: baseline
      flex: 0 0 22px
      font-size: 12px
      font-weight: 600
      color: var(--ac-difficulty-color)

    &__track
      display: block
      flex: 1 1 0
      min-width: 0
      height: 5px
      overflow: hidden
      border-radius: 999px
      background: #edf2f8

      > span
        display: block
        height: 100%
        border-radius: inherit
        background: var(--ac-difficulty-color)

    &__count
      display: flex
      align-items: baseline
      justify-content: flex-end
      gap: 4px
      flex: 0 0 auto
      min-width: 42px
      font-size: 13px
      font-weight: 550
      color: #40556f

      small
        font-size: 10px
        font-weight: 400
        color: #98a4b4

    &__row.is-empty
      .profile-ac-difficulty__count
        color: #adb7c5

    &__unrated
      display: flex
      align-items: baseline
      justify-content: space-between
      gap: 10px
      padding: 11px 0 0
      margin-top: 9px
      border-top: 1px dashed #e2e9f3
      font-size: 11px
      line-height: 1.5
      color: #8898ac

      strong
        font-size: 13px
        font-weight: 550
        font-variant-numeric: tabular-nums
        color: #62758d
