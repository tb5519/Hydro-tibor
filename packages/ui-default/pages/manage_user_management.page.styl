@css {

  .student-management {
    display: grid;
    gap: 1rem;
  }
  .student-management__hero,
  .student-management__editor,
  .student-management__roster {
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
  }
  .student-management__hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 1.3rem;
    background: linear-gradient(135deg, #eff6ff 0%, #fff 55%, #fdf4ff 100%);
  }
  .student-management__hero h1,
  .student-management__editor h2,
  .student-management__roster h2 {
    margin: 0;
    color: #0f172a;
  }
  .student-management__hero h1 { font-size: 1.45rem; }
  .student-management__hero p {
    margin: .45rem 0 0;
    color: #64748b;
    font-size: .9rem;
    line-height: 1.55;
  }
  .student-management__count {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: .38rem .7rem;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: .82rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .student-management__success {
    border: 1px solid #bbf7d0;
    border-radius: 10px;
    padding: .7rem .85rem;
    background: #f0fdf4;
    color: #166534;
  }
  .student-management__editor { padding: 1.15rem 1.25rem; }
  .student-management__editor--inline { animation: student-management-editor-expand .2s ease-out; }
  .student-management__editor-heading,
  .student-management__roster-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: 1rem;
  }
  .student-management__editor-heading p,
  .student-management__roster-heading p {
    margin: .3rem 0 0;
    color: #64748b;
    font-size: .83rem;
  }
  .student-management__editor-avatar {
    width: 3.15rem;
    height: 3.15rem;
    border: 3px solid #e0ecff;
    border-radius: 50%;
    object-fit: cover;
  }
  .student-management__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem 1rem;
  }
  .student-management__form label { min-width: 0; }
  .student-management__form label > span {
    display: block;
    margin-bottom: .35rem;
    color: #475569;
    font-size: .84rem;
    font-weight: 700;
  }
  .student-management__form .textbox { width: 100%; }
  .student-management__level-hint { margin: .4rem 0 0; color: #64748b; font-size: .76rem; line-height: 1.5; }
  .student-note__level { display: inline-flex; align-items: center; margin-left: .45rem; padding: .12rem .42rem; border: 1px solid #dbeafe; border-radius: 6px; background: #eff6ff; color: #2563eb; font-size: .68rem; font-weight: 750; vertical-align: middle; white-space: nowrap; }
  .student-note__level--max { border-color: #ddd6fe; background: #f5f3ff; color: #7c3aed; }
  .student-management__form .student-management__wide { grid-column: 1 / -1; }
  .student-management__cpp-mode {
    grid-column: 1 / -1;
    min-width: 0;
    margin-top: .1rem;
  }
  .student-management__cpp-mode-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .75rem;
    flex-wrap: wrap;
  }
  .student-management__cpp-mode-title {
    color: #475569;
    font-size: .84rem;
    font-weight: 700;
  }
  .student-management__cpp-mode-hint {
    color: #64748b;
    font-size: .76rem;
    line-height: 1.45;
  }
  .student-management__cpp-mode-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .55rem;
    margin-top: .45rem;
  }
  .student-management__cpp-mode-choice {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: .45rem;
    min-width: 0;
    min-height: 4.85rem;
    border: 1px solid #d8e6fa;
    border-radius: 9px;
    padding: .55rem .6rem;
    background: linear-gradient(135deg, #f8fbff, #fdfefe);
    cursor: pointer;
    transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
  }
  .student-management__cpp-mode-choice:hover {
    border-color: #93c5fd;
    background: #f4f9ff;
    box-shadow: 0 5px 13px rgba(37, 99, 235, .08);
  }
  .student-management__cpp-mode-choice > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .student-management__cpp-mode-indicator {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    margin: .08rem 0 0 !important;
    border: 1px solid #b8cbe3;
    border-radius: 4px;
    color: transparent;
    background: #fff;
    font-size: .62rem;
    transition: color .16s ease, border-color .16s ease, background .16s ease;
  }
  .student-management__cpp-mode-choice > input:checked + .student-management__cpp-mode-indicator {
    border-color: #2563eb;
    color: #fff;
    background: #2563eb;
  }
  .student-management__cpp-mode-choice > input:focus-visible + .student-management__cpp-mode-indicator {
    outline: 3px solid rgba(37, 99, 235, .24);
    outline-offset: 2px;
  }
  .student-management__cpp-mode-choice > input:checked ~ .student-management__cpp-mode-copy strong { color: #1d4ed8; }
  .student-management__cpp-mode-copy {
    display: grid !important;
    gap: .12rem;
    min-width: 0;
    margin: 0 !important;
  }
  .student-management__cpp-mode-copy strong {
    color: #334155;
    font-size: .84rem;
  }
  .student-management__cpp-mode-copy small {
    color: #64748b;
    font-size: .72rem;
    font-weight: 400;
    line-height: 1.4;
  }
  .student-management__form-actions {
    display: flex;
    align-items: center;
    gap: .65rem;
    flex-wrap: wrap;
    margin-top: .25rem;
  }
  .student-management__hint {
    color: #64748b;
    font-size: .8rem;
    line-height: 1.5;
  }
  .student-management__password {
    margin-top: 1rem;
    border-top: 1px solid #edf2f7;
    padding-top: .85rem;
  }
  .student-management__password summary {
    color: #475569;
    cursor: pointer;
    font-size: .86rem;
    font-weight: 700;
  }
  .student-management__password-form {
    display: flex;
    align-items: flex-end;
    gap: .7rem;
    flex-wrap: wrap;
    margin-top: .85rem;
  }
  .student-management__password-form label { flex: 1 1 12rem; }
  .student-management__password-form label > span {
    display: block;
    margin-bottom: .35rem;
    color: #64748b;
    font-size: .8rem;
  }
  .student-management__password-form .textbox { width: 100%; }
  .student-management__roster { padding: 1.15rem 1.25rem 1.3rem; }
  .student-management__roster-heading { align-items: flex-start; }
  .student-management__roster-title {
    display: flex;
    align-items: center;
    gap: .7rem;
    flex-wrap: wrap;
  }
  .student-management__add-student {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .25rem;
    min-height: 1.72rem;
    border: 1px solid #2563eb;
    border-radius: 999px;
    padding: .27rem .55rem;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    box-shadow: 0 5px 12px rgba(37, 99, 235, .18);
    color: #fff;
    cursor: pointer;
    font-size: .74rem;
    font-weight: 800;
    line-height: 1;
    transition: box-shadow .16s ease, transform .16s ease;
  }
  .student-management__add-student:hover,
  .student-management__add-student:focus-visible {
    box-shadow: 0 8px 17px rgba(37, 99, 235, .27);
    outline: none;
    transform: translateY(-1px);
  }
  .student-management__domains-field {
    grid-column: 1 / -1;
    min-width: 0;
    margin: 0;
    border: 0;
    padding: 0;
  }
  .student-management__domains-row {
    display: flex;
    align-items: center;
    gap: .55rem;
    min-height: 2rem;
    flex-wrap: wrap;
  }
  .student-management__domains-label {
    flex: 0 0 auto;
    color: #475569;
    font-size: .84rem;
    font-weight: 700;
  }
  .student-management__domains {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: .65rem .7rem;
    padding: .3rem .25rem .2rem 0;
  }
  .student-management__domain-chip {
    position: relative;
    display: inline-flex;
    min-width: 0;
  }
  .student-management__domain-choice {
    position: relative;
    display: flex;
    align-items: center;
    gap: .35rem;
    min-width: 0;
    min-height: 1.9rem;
    border: 1px solid #d9e5f4;
    border-radius: 7px;
    padding: .24rem 1.05rem .24rem .42rem;
    background: #fbfdff;
    cursor: pointer;
    transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
  }
  .student-management__domain-choice:hover { border-color: #93c5fd; background: #f4f9ff; }
  .student-management__domain-choice > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .student-management__domain-check {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: .95rem;
    height: .95rem;
    flex: 0 0 auto;
    margin: 0 !important;
    border: 1px solid #b9cce3;
    border-radius: 4px;
    color: transparent;
    background: #fff;
    font-size: .59rem;
    transition: background .16s ease, border-color .16s ease, color .16s ease;
  }
  .student-management__domain-choice > input:checked + .student-management__domain-check {
    border-color: #2563eb;
    color: #fff;
    background: #2563eb;
  }
  .student-management__domain-choice > input:focus-visible + .student-management__domain-check { outline: 3px solid rgba(37, 99, 235, .24); outline-offset: 2px; }
  .student-management__domain-choice > input:checked ~ .student-management__domain-info { color: #1e40af; }
  .student-management__domain-info {
    display: inline !important;
    min-width: 0;
    margin: 0 !important;
    color: #475569;
  }
  .student-management__domain-info strong,
  .student-management__domain-info small {
    white-space: nowrap;
  }
  .student-management__domain-info strong { font-size: .76rem; }
  .student-management__domain-info small { margin-left: .2rem; color: #64748b; font-size: .67rem; font-weight: 400; }
  .student-management__domain-default {
    display: none !important;
    flex: 0 0 auto;
    align-items: center;
    margin: 0 0 0 auto !important;
    border-radius: 999px;
    margin-left: .05rem !important;
    padding: .1rem .24rem;
    color: #2563eb;
    background: #dbeafe;
    font-size: .58rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .student-management__domain-choice > input:checked ~ .student-management__domain-default { display: inline-flex !important; }
  .student-management__domain-remove {
    position: absolute;
    z-index: 1;
    top: -.48rem;
    right: -.4rem;
    display: inline-grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid #fecaca;
    border-radius: 50%;
    padding: 0;
    color: #b91c1c;
    background: #fff;
    box-shadow: 0 2px 6px rgba(127, 29, 29, .12);
    cursor: pointer;
    font-size: .9rem;
    font-weight: 700;
    line-height: 1;
    transition: background .16s ease, color .16s ease, transform .16s ease;
  }
  .student-management__domain-remove:hover,
  .student-management__domain-remove:focus-visible {
    color: #fff;
    background: #dc2626;
    outline: 2px solid rgba(220, 38, 38, .25);
    outline-offset: 2px;
    transform: scale(1.08);
  }
  .student-management__domain-add {
    display: inline-flex;
    align-items: center;
    gap: .2rem;
    min-height: 1.9rem;
    border: 1px dashed #93c5fd;
    border-radius: 8px;
    padding: .25rem .55rem;
    color: #1d4ed8;
    background: #f3f8ff;
    cursor: pointer;
    font-size: .75rem;
    font-weight: 750;
    transition: border-color .16s ease, background .16s ease;
  }
  .student-management__domain-add:hover,
  .student-management__domain-add:focus-visible {
    border-color: #2563eb;
    background: #dbeafe;
    outline: none;
  }
  .student-domain-dialog[hidden] { display: none; }
  .student-domain-dialog [hidden] { display: none !important; }
  .student-domain-dialog {
    position: fixed;
    z-index: 1010;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .student-domain-dialog__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(15, 23, 42, .54);
  }
  .student-domain-dialog__panel {
    position: relative;
    width: min(27rem, 100%);
    max-height: calc(100vh - 2rem);
    overflow: auto;
    border: 1px solid #bfdbfe;
    border-radius: 18px;
    padding: 1.3rem;
    background: linear-gradient(145deg, #fff, #f8fbff);
    box-shadow: 0 26px 65px rgba(15, 23, 42, .28);
    animation: student-create-dialog-enter .22s cubic-bezier(.22, 1, .36, 1);
  }
  .student-domain-dialog__icon {
    display: inline-grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 13px;
    color: #1d4ed8;
    background: #dbeafe;
    font-size: 1.2rem;
  }
  .student-domain-dialog.is-remove .student-domain-dialog__icon {
    color: #b91c1c;
    background: #fee2e2;
  }
  .student-domain-dialog__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid #e2e8f0;
    border-radius: 50%;
    color: #64748b;
    background: #fff;
    cursor: pointer;
  }
  .student-domain-dialog__close:hover,
  .student-domain-dialog__close:focus-visible { color: #1d4ed8; background: #eff6ff; outline: none; }
  .student-domain-dialog__title { margin: .8rem 0 .35rem; color: #0f172a; font-size: 1.2rem; }
  .student-domain-dialog__description { margin: 0; color: #475569; font-size: .88rem; line-height: 1.6; }
  .student-domain-dialog__selected {
    margin-top: 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: .7rem .8rem;
    color: #1e293b;
    background: #fff;
    font-size: .88rem;
    font-weight: 700;
  }
  .student-domain-dialog__selected small { margin-left: .4rem; color: #64748b; font-weight: 400; }
  .student-domain-dialog__field { display: grid; gap: .4rem; margin-top: 1rem; color: #334155; font-size: .85rem; font-weight: 700; }
  .student-domain-dialog__field select { width: 100%; }
  .student-domain-dialog__note {
    display: flex;
    align-items: flex-start;
    gap: .45rem;
    margin-top: 1rem;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    padding: .7rem .8rem;
    color: #475569;
    background: #f1f7ff;
    font-size: .78rem;
    line-height: 1.5;
  }
  .student-domain-dialog__error { margin: .8rem 0 0; color: #b91c1c; font-size: .82rem; line-height: 1.5; }
  .student-domain-dialog__actions { display: flex; justify-content: flex-end; gap: .55rem; margin-top: 1.2rem; }
  .student-domain-dialog__actions .button { margin: 0; }
  .student-domain-dialog__actions .button.student-domain-dialog__confirm.is-danger {
    border-color: #dc2626;
    background: #dc2626;
  }
  .student-domain-dialog__actions .button.student-domain-dialog__confirm.is-danger:hover,
  .student-domain-dialog__actions .button.student-domain-dialog__confirm.is-danger:focus-visible {
    border-color: #b91c1c;
    background: #b91c1c;
  }
  .student-domain-dialog__confirm:disabled { cursor: wait; opacity: .7; }
  .student-management__sort {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex: 0 0 auto;
  }
  .student-management__sort-direction {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    min-height: 2.25rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0;
    background: #fff;
    color: #2563eb;
    cursor: pointer;
    font-size: 1.05rem;
    font-weight: 800;
  }
  .student-management__sort-direction:hover,
  .student-management__sort-direction:focus-visible {
    border-color: #60a5fa;
    background: #eff6ff;
    outline: none;
  }
  .student-management__sort label {
    display: flex;
    align-items: center;
    gap: .45rem;
    color: #475569;
    font-size: .83rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .student-management__sort select {
    min-height: 2.25rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: .32rem .45rem;
    background: #fff;
    color: #334155;
  }
  .student-management__search {
    width: min(21rem, 100%);
    margin-bottom: 1rem;
  }
  .student-management__search .textbox { width: 100%; }
  .student-management__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .65rem;
  }
  .student-note-row {
    display: grid;
    gap: .65rem;
  }
  .student-note {
    position: relative;
    display: grid;
    grid-template-columns: minmax(11.5rem, 1.1fr) minmax(9rem, .75fr) minmax(17rem, 1.3fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 5.7rem;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, .35);
    border-radius: 10px;
    padding: .85rem 1rem;
    background: linear-gradient(90deg, #fff 0%, #f8fbff 100%);
    color: #334155;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(15, 23, 42, .08);
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  a.student-note,
  a.student-note:visited,
  a.student-note:hover,
  a.student-note:focus,
  a.student-note:focus-visible,
  a.student-note:active {
    text-decoration: none;
  }
  .student-note::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: #60a5fa;
    content: '';
  }
  .student-note:hover,
  .student-note:focus-visible {
    z-index: 1;
    border-color: #60a5fa;
    box-shadow: 0 12px 24px rgba(37, 99, 235, .17);
    color: #0f172a;
    outline: none;
    transform: translateY(-2px);
  }
  .student-note.is-selected {
    border: 2px solid #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .14), 0 12px 24px rgba(37, 99, 235, .18);
  }
  .student-note__head {
    display: flex;
    align-items: center;
    gap: .65rem;
    min-width: 0;
  }
  .student-note__avatar {
    width: 2.65rem;
    height: 2.65rem;
    flex: 0 0 auto;
    border: 2px solid #e0ecff;
    border-radius: 50%;
    object-fit: cover;
  }
  .student-note__name {
    overflow: hidden;
    color: #0f172a;
    font-size: 1rem;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .student-note__uname {
    overflow: hidden;
    margin-top: .1rem;
    color: #64748b;
    font-size: .78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .student-note__profile {
    display: grid;
    gap: .24rem;
    min-width: 0;
    color: #64748b;
    font-size: .78rem;
    line-height: 1.35;
  }
  .student-note__profile span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .student-note__activity {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .55rem;
    min-width: 0;
  }
  .student-note__metric {
    display: grid;
    gap: .12rem;
    min-width: 0;
  }
  .student-note__metric-label {
    color: #64748b;
    font-size: .72rem;
  }
  .student-note__metric-value {
    overflow: hidden;
    color: #1e293b;
    font-size: .8rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .student-note__metric-value strong {
    color: #2563eb;
    font-size: 1rem;
  }
  .student-note__metric-value small {
    color: #64748b;
    font-size: .71rem;
    font-weight: 400;
  }
  .student-note__edit {
    color: #2563eb;
    font-size: .77rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .student-management__empty {
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    padding: 2rem 1rem;
    color: #64748b;
    text-align: center;
  }
  .student-create-dialog[hidden] { display: none; }
  .student-create-dialog {
    position: fixed;
    z-index: 1000;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.2rem;
  }
  .student-create-dialog__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(15, 23, 42, .48);
    cursor: default;
  }
  .student-create-dialog__panel {
    position: relative;
    width: min(42rem, 100%);
    max-height: min(44rem, calc(100vh - 2.4rem));
    overflow: auto;
    border: 1px solid rgba(191, 219, 254, .9);
    border-radius: 18px;
    background: linear-gradient(145deg, #fff 0%, #f8fbff 100%);
    box-shadow: 0 28px 70px rgba(15, 23, 42, .28);
    animation: student-create-dialog-enter .22s cubic-bezier(.22, 1, .36, 1);
  }
  .student-create-dialog__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 1.25rem 1rem;
    border-bottom: 1px solid #e3edf9;
    background: linear-gradient(135deg, #eaf4ff, #fff 67%, #f9f1ff);
  }
  .student-create-dialog__eyebrow {
    margin: 0 0 .2rem;
    color: #2563eb;
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .student-create-dialog__header h2 { margin: 0; color: #0f172a; font-size: 1.28rem; }
  .student-create-dialog__header p:not(.student-create-dialog__eyebrow) { margin: .3rem 0 0; color: #64748b; font-size: .82rem; line-height: 1.45; }
  .student-create-dialog__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border: 1px solid #d7e2f0;
    border-radius: 50%;
    background: rgba(255, 255, 255, .8);
    color: #64748b;
    cursor: pointer;
    transition: color .16s ease, background .16s ease;
  }
  .student-create-dialog__close:hover,
  .student-create-dialog__close:focus-visible { color: #1d4ed8; background: #eff6ff; outline: none; }
  .student-create-dialog__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem 1rem;
    padding: 1.1rem 1.25rem 1.25rem;
  }
  .student-create-dialog__field { min-width: 0; }
  .student-create-dialog__field > span {
    display: block;
    margin-bottom: .35rem;
    color: #475569;
    font-size: .82rem;
    font-weight: 750;
  }
  .student-create-dialog__required { color: #dc2626; }
  .student-create-dialog__field .textbox { width: 100%; }
  .student-create-dialog__wide { grid-column: 1 / -1; }
  .student-create-dialog__tip {
    display: flex;
    align-items: flex-start;
    gap: .45rem;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    padding: .65rem .72rem;
    color: #466684;
    background: #f4f9ff;
    font-size: .78rem;
    line-height: 1.45;
  }
  .student-create-dialog__tip .icon { flex: 0 0 auto; color: #3b82f6; }
  .student-create-dialog__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: .6rem;
    flex-wrap: wrap;
    margin-top: .1rem;
  }
  body.student-create-dialog-open,
  body.student-domain-dialog-open { overflow: hidden; }
  @keyframes student-create-dialog-enter {
    from { opacity: 0; transform: translateY(.7rem) scale(.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes student-management-editor-expand {
    from { opacity: 0; transform: translateY(-.35rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 70em) {
    .student-note {
      grid-template-columns: minmax(11.5rem, 1fr) minmax(9rem, 1fr) auto;
    }
    .student-note__activity {
      grid-column: 1 / -2;
      border-top: 1px solid #e2e8f0;
      padding-top: .65rem;
    }
  }
  @media (max-width: 42em) {
    .student-management__hero { display: block; }
    .student-management__count { display: inline-block; margin-top: .75rem; }
    .student-management__form { grid-template-columns: 1fr; }
    .student-management__roster-heading { display: block; }
    .student-management__sort { width: 100%; margin-top: .8rem; }
    .student-management__sort label { flex: 1; }
    .student-management__sort select { flex: 1; min-width: 0; }
    .student-management__domains-row { align-items: flex-start; }
    .student-domain-dialog { padding: .65rem; }
    .student-domain-dialog__panel { padding: 1rem; }
    .student-domain-dialog__actions .button { flex: 1; }
    .student-management__cpp-mode-options { grid-template-columns: 1fr; }
    .student-create-dialog { padding: .65rem; }
    .student-create-dialog__form { grid-template-columns: 1fr; }
    .student-create-dialog__wide { grid-column: auto; }
    .student-note {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: .7rem;
    }
    .student-note__profile { grid-column: 2 / 3; }
    .student-note__activity {
      grid-column: 1 / -1;
      border-top: 1px solid #e2e8f0;
      padding-top: .65rem;
    }
  }


/* Student workspace: calm roster, persistent detail, explicit settings. */
.page--manage_user_management .main { background: #f4f7fa; }
.student-management { color: #24354b; gap: 24px; container: student-management / inline-size; }
.student-management [hidden] { display: none !important; }
.student-management button, .student-management input, .student-management select { font: inherit; }
.student-management button:focus-visible, .student-management a:focus-visible { outline: 3px solid #c7d9ed; outline-offset: 3px; }
.student-management__hero { padding: 12px 0 6px; border: 0; box-shadow: none; background: none; align-items: center; }
.student-management__hero h1 { font-size: 25px; font-weight: 650; letter-spacing: -.5px; }
.student-management__hero p { font-size: 13px; color: #8190a2; }
.student-management__hero .student-management__eyebrow { margin: 0 0 11px; font-size: 12px; font-weight: 600; color: #6390ba; letter-spacing: 1px; }
.student-management__add-student { padding: 10px 14px; border-radius: 8px; background: #fff; color: #3e78ad; border-color: #d4e1ed; box-shadow: none; font-size: 13px; white-space: nowrap; }
.student-management__workspace { display: grid; grid-template-columns: minmax(230px, .85fr) minmax(0, 1.65fr); gap: 20px; align-items: start; }
.student-management__roster { min-width: 0; padding: 20px 16px; border-radius: 12px; box-shadow: 0 3px 14px rgba(27,49,74,.025); }
.student-management__roster-heading { align-items: center; margin-bottom: 17px; }
.student-management__roster-heading h2 { font-size: 15px; font-weight: 600; color: #3a4f65; }
.student-management__count { padding: 4px 8px; font-size: 12px; color: #8196ab; background: #f0f5fa; border-radius: 5px; }
.student-management__search { display: block; width: 100%; margin-bottom: 11px; }
.student-management__search .textbox { padding: 10px 12px; border: 1px solid #dce5ee; border-radius: 7px; background: #fbfcfe; font-size: 13px; }
.student-roster-filters { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
.student-roster-filters label { min-width: 0; }
.student-roster-filters .textbox { width: 100%; padding: 8px 6px; font-size: 12px; color: #7b8ca1; border-color: #e0e7ef; border-radius: 6px; }
.student-management__sort { justify-content: space-between; width: 100%; margin: 13px 0 16px; }
.student-management__sort label { font-size: 12px; color: #9aa7b5; }
.student-management__sort select { border: 0; padding: 5px 2px; min-width: 0; font-size: 12px; background: none; color: #71869c; }
.student-management__sort-direction { width: 27px; height: 27px; border-color: #e5ebf1; font-size: 14px; color: #8097ac; }
.student-management__list { gap: 7px; max-height: calc(100vh - 330px); min-height: 180px; overflow-y: auto; overflow-anchor: none; scrollbar-width: thin; scrollbar-color: #d6e1eb transparent; padding: 2px; }
.student-note { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; min-height: 0; gap: 9px; padding: 13px 10px; border: 1px solid transparent; border-radius: 8px; background: #fff; box-shadow: none; }
.student-note::before { display: none; }
.student-note:hover, .student-note:focus-visible { transform: none; box-shadow: none; background: #f7fafd; border-color: #e4edf5; }
.student-note.is-selected { border: 1px solid #bfd3e6; box-shadow: none; background: #f0f6fc; }
.student-note__avatar { width: 34px; height: 34px; border: 0; border-radius: 10px; }
.student-note__identity { min-width: 0; }
.student-note__identity strong { display: block; color: #344b62; font-size: 13px; line-height: 1.6; overflow-wrap: anywhere; }
.student-note__identity > span { display: block; margin-top: 3px; color: #97a7b7; font-size: 11px; overflow-wrap: anywhere; }
.student-note__level { margin: 0; align-self: start; padding: 3px 5px; font-size: 11px; font-weight: 500; border-color: #dfe8f1; color: #7792ad; background: #fff; }
.student-note__domains { grid-column: 2 / -1; color: #8a9bae; font-size: 11px; line-height: 1.7; overflow-wrap: anywhere; }
.student-note__summary { grid-column: 1 / -1; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 5px; padding-top: 7px; border-top: 1px solid #edf1f6; color: #97a6b5; font-size: 11px; line-height: 1.5; }
.student-note__summary i { font-style: normal; color: #bbc6d0; padding: 0 3px; }
.student-note__quiz { color: #9eacb9; }
.student-note__quiz.is-enabled { color: #4f927a; }
.student-detail-host { min-width: 0; scroll-margin-top: 85px; }
.student-detail-host[aria-busy='true'] { opacity: .65; cursor: progress; }
.student-management__editor { padding: 24px; border-radius: 12px; box-shadow: 0 3px 14px rgba(27,49,74,.025); min-height: 550px; }
.student-management__editor-heading { margin-bottom: 22px; }
.student-management__editor-heading h2 { font-size: 20px; font-weight: 600; }
.student-management__editor-heading p { font-size: 12px; color: #94a2b2; }
.student-management__editor-avatar { width: 44px; height: 44px; border: 0; border-radius: 12px; }
.student-editor-tabs { display: flex; gap: 5px; margin-bottom: 24px; padding-bottom: 8px; border-bottom: 1px solid #e6edf4; }
.student-editor-tabs button { border: 0; padding: 10px 13px; border-radius: 7px; color: #8998a9; background: none; cursor: pointer; font-size: 13px; white-space: nowrap; }
.student-editor-tabs button[aria-selected='true'] { color: #3877ac; background: #ecf4fc; font-weight: 600; }
.student-editor-tabs button[data-student-tab='daily'][aria-selected='true'] { color: #387f69; background: #ebf6f0; }
.student-management__form { display: block; }
.student-editor-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 16px; }
.student-editor-panel__intro { grid-column: 1 / -1; margin: 0 0 3px; color: #8b9aad; font-size: 12px; line-height: 1.8; }
.student-management__form label > span { color: #61768b; font-size: 13px; font-weight: 500; }
.student-management__form .textbox { font-size: 13px; border: 1px solid #dce5ee; padding: 10px 12px; border-radius: 7px; }
.student-management__form-actions { margin-top: 24px; padding-top: 20px; border-top: 1px solid #e9eef4; gap: 10px; }
.student-management__form-actions .button { font-size: 12px; border-radius: 7px; }
.student-management__form-actions .student-management__hint { display: block; flex-basis: 100%; font-size: 12px; line-height: 1.8; color: #9aa7b5; }
.student-management__domains-field { padding: 0 0 20px; margin: 0 0 3px; border: 0; border-bottom: 1px dashed #e2eaf2; background: none; }
.student-management__domains-row { align-items: flex-start; gap: 10px; }
.student-management__domains-label { flex-basis: 100%; font-size: 12px; color: #8497aa; }
.student-management__domain-choice { border-radius: 6px; padding: 8px 26px 8px 9px; box-shadow: none; background: #fbfdff; }
.student-management__domain-info strong { font-size: 12px; font-weight: 500; }
.student-management__domain-info small { font-size: 11px; }
.student-management__domain-add { padding: 9px; font-size: 12px; }
.student-management__cpp-mode-options { grid-template-columns: minmax(0, 1fr); gap: 9px; }
.student-management__cpp-mode-choice { min-height: 0; padding: 13px; background: #fcfdff; }
.student-management__cpp-mode-title { font-size: 13px; font-weight: 500; }
.student-management__cpp-mode-hint { color: #97a6b5; font-size: 12px; }
.student-management__cpp-mode-copy strong { font-size: 13px; }
.student-management__cpp-mode-copy small { font-size: 12px; color: #8b9caf; }
.student-management__password { margin-top: 23px; padding-top: 20px; border-top: 1px solid #e9eef4; }
.student-management__password summary { font-size: 12px; color: #93a1b1; }
.student-management__password-form label > span { font-size: 12px; }
.student-management__password-form .textbox { font-size: 13px; padding: 10px; border-radius: 7px; }
.student-editor-feedback, .student-daily-feedback { margin: 0 0 18px; padding: 11px 13px; border: 1px solid #cfe5da; border-radius: 7px; background: #f2f9f5; color: #52866e; font-size: 12px; line-height: 1.8; }
.student-editor-feedback.is-error, .student-daily-feedback.is-error { border-color: #ead1ca; background: #fff8f5; color: #af7568; }
.student-editor-welcome { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: linear-gradient(150deg, #fff 40%, #f8fbfd); }
.student-editor-welcome > .icon { color: #aac1d5; font-size: 35px; margin-bottom: 22px; }
.student-editor-welcome h2 { font-size: 20px; font-weight: 500; color: #657c94; }
.student-editor-welcome p { margin: 16px 0 25px; color: #99a8b8; line-height: 1.9; font-size: 13px; }
.student-editor-welcome > span:last-child { font-size: 12px; color: #a7b4c2; }
.student-management__empty { padding: 28px 12px; font-size: 12px; color: #9aa9b7; }
.student-management__empty strong { font-size: 14px; color: #788fa4; font-weight: 500; }
.student-text-button { padding: 5px 0; border: 0; color: #5387b4; background: none; font-size: 12px; cursor: pointer; }
.student-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
.student-daily-overview { padding: 17px; border: 1px solid #dcebe3; border-radius: 9px; background: #f7fbf9; }
.student-daily-toggle { display: flex !important; align-items: center; justify-content: space-between; gap: 15px; margin: 0; cursor: pointer; }
.student-daily-toggle strong { display: block; color: #406b5a; font-size: 14px; font-weight: 600; }
.student-daily-toggle small { display: block; margin-top: 7px; color: #8fa399; font-size: 12px; line-height: 1.8; }
.student-daily-toggle input { width: 17px; height: 17px; flex: 0 0 17px; accent-color: #438c71; }
.student-daily-summary { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 16px; padding-top: 14px; border-top: 1px solid #e4eee8; color: #88a093; font-size: 12px; }
.student-daily-summary strong { font-size: 17px; font-weight: 600; color: #4f836b; margin-right: 4px; }
.student-daily-global { display: flex !important; align-items: center; justify-content: space-between; gap: 12px; padding: 19px 0; color: #7b91a3; font-size: 12px; }
.student-daily-global input { width: 65px; }
.student-daily-domain { padding: 17px; margin-bottom: 13px; border: 1px solid #e0e8ef; border-radius: 9px; }
.student-daily-domain > summary { display: flex; align-items: center; gap: 10px; list-style: none; cursor: pointer; }
.student-daily-domain > summary::-webkit-details-marker { display: none; }
.student-daily-domain > summary strong { flex: 1; color: #546e85; font-size: 14px; font-weight: 600; }
.student-daily-domain > summary > span { color: #a0aebc; font-size: 12px; }
.student-daily-domain > summary > i { font-size: 14px; color: #97aabd; font-style: normal; }
.student-daily-domain[open] > summary > i { transform: rotate(180deg); }
.student-daily-domain-fields { border: 0; padding: 17px 0 0; margin: 0; min-width: 0; }
.student-daily-domain-fields:disabled { opacity: .5; }
.student-daily-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.student-daily-field { display: block; color: #8193a6; font-size: 12px; }
.student-daily-field > span { display: block; margin-bottom: 8px; }
.student-daily-field .textbox, .student-daily-global .textbox { width: 100%; padding: 8px 10px; border-radius: 6px; border-color: #dce5ee; font-size: 13px; }
.student-daily-global .textbox { width: 65px; }
.student-daily-help { margin: 12px 0 0; color: #94a5b5; font-size: 12px; line-height: 1.8; }
.student-daily-help.is-warning { color: #b18551; }
.student-daily-tags { margin-top: 18px; }
.student-daily-tags > label { display: block; margin-bottom: 8px; color: #8193a6; font-size: 12px; }
.student-daily-tags > input { width: 100%; padding: 7px 9px; font-size: 12px; border: 1px solid #e3eaf1; border-radius: 5px; }
.student-daily-tag-list { display: flex; flex-wrap: wrap; gap: 6px; max-height: 136px; overflow-y: auto; margin-top: 9px; }
.student-daily-tag-list label { display: inline-flex !important; align-items: center; gap: 5px; margin: 0; border: 1px solid #e3eaf0; border-radius: 5px; padding: 5px 7px; color: #8195a9; font-size: 12px; cursor: pointer; }
.student-daily-tag-list label:has(input:checked) { color: #497ca6; border-color: #c0d6e9; background: #f1f7fc; }
.student-daily-tag-list input { margin: 0; accent-color: #5689b5; width: 12px; height: 12px; }
.student-daily-tag-list small { color: #a6b3be; font-size: 11px; }
.student-daily-points { margin-top: 16px; }
.student-daily-points summary { color: #8b9eaf; cursor: pointer; font-size: 12px; }
.student-daily-points-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 13px; }
.student-daily-points-grid label { color: #94a5b4; font-size: 11px; }
.student-daily-points-grid input { width: 100%; padding: 6px; border: 1px solid #dfe8ef; border-radius: 5px; margin-top: 5px; color: #687f94; font-size: 12px; }
.student-daily-save { justify-content: space-between; align-items: center; }
.student-daily-save > span { font-size: 12px; color: #9aaab8; flex: 1; }
.student-daily-save .primary { background: #438d74; border-color: #438d74; }
.student-daily-history { margin-top: 25px; border-top: 1px solid #e7edf3; padding-top: 20px; }
.student-daily-history h3 { margin: 0 0 16px; color: #72879b; font-size: 14px; font-weight: 500; }
.student-daily-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; margin-bottom: 18px; }
.student-daily-stats div { padding: 12px 8px; border-radius: 7px; background: #f6f9fc; text-align: center; }
.student-daily-stats strong { display: block; font-size: 18px; color: #657f97; font-weight: 500; }
.student-daily-stats span { display: block; margin-top: 6px; color: #9aabba; font-size: 11px; }
.student-daily-history details { padding: 10px 0; border-bottom: 1px solid #edf1f5; color: #8295a7; font-size: 12px; }
.student-daily-history summary { cursor: pointer; }
.student-daily-history ul { padding-left: 18px; font-size: 12px; line-height: 1.9; color: #94a4b4; }
.student-daily-history li { margin: 8px 0; overflow-wrap: anywhere; }
.student-create-dialog-open, .student-domain-dialog-open { overflow: hidden; }
@media (max-width: 1150px) {
  .student-management__workspace { grid-template-columns: minmax(220px, .9fr) minmax(0, 1.4fr); gap: 14px; }
  .student-management__editor { padding: 20px 16px; }
  .student-management__roster { padding: 18px 12px; }
  .student-editor-panel { grid-template-columns: 1fr; }
  .student-management__cpp-mode, .student-editor-panel__intro { grid-column: 1; }
  .student-daily-fields { grid-template-columns: 1fr; }
}
@media (max-width: 900px) {
  .student-management__workspace { grid-template-columns: minmax(0, 1fr); }
  .student-management__list { max-height: 310px; min-height: 0; }
  .student-management__editor { min-height: 360px; scroll-margin-top: 85px; }
  .student-editor-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .student-daily-fields { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 560px) {
  .student-management__hero { display: flex; align-items: flex-start; gap: 15px; }
  .student-management__hero h1 { font-size: 20px; }
  .student-management__hero p:last-child { font-size: 12px; }
  .student-management__add-student { padding: 8px 10px; font-size: 12px; }
  .student-management__roster-heading { display: flex; }
  .student-management__count { margin: 0; }
  .student-note { grid-template-columns: 34px minmax(0, 1fr) auto; }
  .student-management__sort { margin-top: 12px; }
  .student-editor-tabs button { flex: 1; padding: 10px 8px; font-size: 12px; }
  .student-editor-panel { grid-template-columns: 1fr; }
  .student-daily-domain { padding: 14px 12px; }
  .student-daily-summary { gap: 8px 12px; }
  .student-daily-points-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (prefers-reduced-motion: reduce) { .student-management *, .student-management *::before { animation: none !important; transition: none !important; } }

.student-daily-subtabs { display: flex; gap: 18px; margin: -5px 0 22px; }
.student-daily-subtabs button { padding: 5px 0 8px; border: 0; border-bottom: 2px solid transparent; background: none; font-size: 13px; color: #8296a7; cursor: pointer; }
.student-daily-subtabs button[aria-pressed='true'] { border-bottom-color: #519680; color: #46816d; font-weight: 600; }
.student-daily-history { margin: 0; border: 0; padding: 0; }
.student-daily-date-tools { display: flex; align-items: flex-end; gap: 12px; margin-bottom: 22px; }
.student-daily-date-tools > select { width: 175px; border-radius: 6px; padding: 8px 10px; color: #71889c; border-color: #dce5ee; font-size: 12px; }
.student-daily-history-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 22px; }
.student-daily-history-stats > div { border: 1px solid #e5edf3; border-radius: 8px; background: #f9fbfd; padding: 16px 13px; }
.student-daily-history-stats small { display: block; color: #8ca0b0; font-size: 12px; }
.student-daily-history-stats strong { display: block; color: #52788f; font-size: 24px; font-weight: 550; margin-top: 9px; }
.student-daily-report-filters { display: flex; gap: 7px; margin-bottom: 18px; flex-wrap: wrap; }
.student-daily-report-filters button { padding: 7px 10px; font-size: 12px; color: #8498a9; border: 1px solid #e4ebf1; border-radius: 6px; background: #fff; cursor: pointer; }
.student-daily-report-filters button[aria-pressed='true'] { border-color: #bcd5e7; color: #487999; background: #eff6fb; }
.student-daily-history .student-daily-question { margin-bottom: 10px; padding: 0; border: 1px solid #e1e9f0; border-radius: 8px; }
.student-daily-question > summary { display: flex; align-items: center; gap: 10px; padding: 14px 12px; list-style: none; }
.student-daily-question > summary::-webkit-details-marker { display: none; }
.student-daily-question > summary::after { content: '⌄'; color: #96aaba; }
.student-daily-question[open] > summary::after { transform: rotate(180deg); }
.student-daily-question > summary strong { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 13px; line-height: 1.7; font-weight: 500; color: #597286; }
.student-daily-question > summary small { font-size: 12px; white-space: nowrap; color: #91a3b3; }
.student-quiz-status { font-size: 11px; padding: 4px 6px; border-radius: 4px; white-space: nowrap; }
.student-quiz-status.is-correct { color: #4d9272; background: #edf7f1; }
.student-quiz-status.is-wrong { color: #ae796a; background: #fcf1ec; }
.student-quiz-status.is-unanswered { color: #97a5b2; background: #f2f5f8; }
.student-daily-question-body { padding: 0 16px 17px; border-top: 1px solid #edf1f5; }
.student-daily-question-body > .student-daily-help { margin: 14px 0; }
.student-quiz-content { overflow-wrap: anywhere; color: #4d6276; font-size: 14px; line-height: 1.85; min-width: 0; }
.student-quiz-content img { max-width: 100%; height: auto; }
.student-quiz-content pre { overflow-x: auto; white-space: pre; font-size: 13px; }
.student-quiz-content p:last-child { margin-bottom: 0; }
.student-quiz-option { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px; border: 1px solid #e4ebf1; border-radius: 6px; padding: 10px; margin-top: 9px; }
.student-quiz-option > strong { color: #91a1af; line-height: 1.85; }
.student-quiz-option > .student-quiz-content { flex: 1; min-width: 80px; }
.student-quiz-option > small { color: #8e9fad; font-size: 11px; line-height: 2.2; }
.student-quiz-option.is-answer { border-color: #c8dfd4; background: #f6fbf8; }
.student-quiz-option.is-answer > small { color: #5c9079; }
.student-quiz-option.is-selected:not(.is-answer) { border-color: #e7cdbf; background: #fff9f5; }
.student-quiz-answer { font-size: 12px; line-height: 1.8; color: #71889d; padding-top: 15px; }
.student-daily-question-body h4 { font-size: 12px; color: #8194a5; margin: 18px 0 8px; font-weight: 500; }
.student-daily-report-empty { padding: 45px 15px; text-align: center; border: 1px dashed #e0e8f0; border-radius: 8px; color: #94a6b5; font-size: 12px; line-height: 1.8; }
.student-daily-report-empty strong { display: block; font-size: 14px; color: #768da1; font-weight: 500; margin-bottom: 10px; }
.student-daily-domain-switch { display: flex; align-items: center; gap: 7px; margin-top: 16px; color: #719188; font-size: 12px; }
.student-daily-domain-switch input { accent-color: #4c9079; }
.student-daily-domain > summary::after { content: '⌄'; color: #96aaba; }
.student-daily-domain[open] > summary::after { transform: rotate(180deg); }
.student-daily-summary.is-warning { color: #a87c4f; }
.student-note__today { display: block; grid-column: 2 / -1; font-size: 11px; color: #7d98a9; }
@media (max-width: 560px) {
  .student-daily-date-tools { flex-wrap: wrap; }
  .student-daily-date-tools > select { width: 100%; }
  .student-daily-history-stats { gap: 6px; }
  .student-daily-history-stats > div { padding: 12px 8px; }
  .student-daily-history-stats strong { font-size: 20px; }
  .student-daily-question > summary { gap: 6px; padding: 12px 8px; }
  .student-daily-question-body { padding: 0 10px 13px; }
}


.page--manage_user_management .student-management,
.page--manage_user_management .student-management *,
.page--manage_user_management .student-management *::before,
.page--manage_user_management .student-management *::after { box-sizing: border-box; }
.student-management__breadcrumb { display: flex; align-items: center; gap: 12px; margin: 0; font-size: 13px; color: #a8b5c0; }
.student-management__breadcrumb a { color: #8499aa; }
.student-management__breadcrumb a:hover { color: #497da6; }
.student-management__workspace { grid-template-columns: minmax(220px, .68fr) minmax(0, 1.6fr); gap: 16px; }
.student-management__search .textbox { width: 100%; min-width: 0; }
.student-daily-date-tools { display: grid; grid-template-columns: minmax(140px, 1fr) minmax(180px, 1fr) auto; align-items: end; }
.student-daily-refresh { height: 38px; padding: 0 12px; border: 1px solid #dce5ee; border-radius: 6px; background: #fff; color: #62849c; font-size: 12px; cursor: pointer; white-space: nowrap; }
.student-daily-refresh:hover:not(:disabled) { background: #f4f8fb; border-color: #bfd3e2; }
.student-daily-refresh:disabled { color: #9fadb8; cursor: wait; }
.student-daily-date-tools > select { width: 100%; height: 38px; margin-bottom: 0; }
.student-daily-date-tools .student-daily-field { margin-bottom: 0; }
.student-daily-date-tools input { height: 38px; margin-bottom: 0; }
[data-daily-report][aria-busy='true'] { opacity: .5; }
@media (max-width: 900px) { .student-management__workspace { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 560px) {
  .student-daily-date-tools { grid-template-columns: minmax(0, 1fr); }
  .student-daily-refresh { justify-self: start; }
}
@container student-management (max-width: 780px) {
  .student-management__hero h1 { font-size: 22px; }
  .student-management__editor { padding: 20px 16px; }
  .student-management__roster { padding: 18px 12px; }
  .student-editor-panel, .student-daily-fields { grid-template-columns: minmax(0, 1fr); }
  .student-management__cpp-mode, .student-editor-panel__intro { grid-column: 1; }
  .student-editor-tabs { gap: 2px; }
  .student-editor-tabs button { padding: 10px 9px; }
  .student-daily-date-tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .student-daily-refresh { justify-self: start; }
  .student-daily-points-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@container student-management (max-width: 660px) {
  .student-management__workspace { grid-template-columns: minmax(0, 1fr); }
  .student-management__list { max-height: 260px; min-height: 0; }
}
@container student-management (max-width: 420px) {
  .student-daily-date-tools { grid-template-columns: minmax(0, 1fr); }
}
}

.student-daily-catalog-tools { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin: 0 0 16px; }
.student-daily-catalog-tools .student-daily-refresh { flex: none; }
.student-daily-catalog-status { flex: 1; min-width: 160px; margin: 0; color: #8395a6; font-size: 12px; line-height: 1.7; }
.student-daily-catalog-status.is-error { color: #af7568; }
