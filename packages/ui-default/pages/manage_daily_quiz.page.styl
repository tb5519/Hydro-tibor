.daily-quiz-dashboard
  --dqd-ink: #18324b
  --dqd-muted: #6b7f92
  --dqd-line: #e5edf3
  --dqd-blue: #2673bf
  --dqd-teal: #168a82
  color: var(--dqd-ink)
  font-size: 14px
  line-height: 1.6
  padding: 24px
  border: 1px solid #e6edf3
  border-radius: 18px
  background: linear-gradient(150deg, #f4f9fc 0%, #f8fafc 48%, #f2f8f7 100%)

  *, *::before, *::after
    box-sizing: border-box

  [hidden]
    display: none !important

  h1, h2, h3, h4, p
    margin: 0

  h1
    font-size: 28px
    font-weight: 700
    letter-spacing: 1px
    line-height: 1.35

  button, input, select
    font: inherit

  button, a, input, select, summary
    &:focus-visible
      outline: 3px solid #88bdec
      outline-offset: 3px

  button
    cursor: pointer
    &:disabled
      opacity: .42
      cursor: default

  input, select
    height: 38px
    min-width: 0
    border: 1px solid #d4e1eb
    border-radius: 8px
    background: #fff
    color: var(--dqd-ink)

  input
    padding: 0 10px

  select
    padding: 0 28px 0 11px

  .dqd-header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 20px
    margin-bottom: 22px

  .dqd-eyebrow
    color: var(--dqd-teal)
    font-size: 11px
    font-weight: 700
    letter-spacing: 2px
    margin-bottom: 5px

  .dqd-subtitle
    color: var(--dqd-muted)
    font-size: 13px
    margin-top: 9px

  .dqd-button
    display: inline-flex
    align-items: center
    justify-content: center
    gap: 6px
    min-height: 38px
    padding: 0 12px
    border: 1px solid #d4e1eb
    border-radius: 8px
    color: #34536c
    background: #fff
    font-size: 13px
    font-weight: 600
    line-height: 1.3
    white-space: nowrap
    transition: border-color .15s, background .15s
    &:hover:not(:disabled)
      border-color: #80aed2
      background: #f5faff

  .dqd-button--quiet
    flex: 0 0 auto
    color: var(--dqd-blue)
    border-color: #cbdeee
    background: rgba(255, 255, 255, .7)

  .dqd-button--today
    color: var(--dqd-blue)
    border-color: #d5e5f3
    background: #edf6ff

  .dqd-button--small
    min-height: 31px
    padding: 0 10px
    font-size: 12px

  .dqd-controls
    display: flex
    align-items: flex-end
    flex-wrap: wrap
    gap: 16px 22px
    padding: 17px 18px
    border: 1px solid var(--dqd-line)
    border-radius: 12px
    background: rgba(255, 255, 255, .8)

  .dqd-field
    display: flex
    flex-direction: column
    gap: 7px
    margin: 0
    > span
      color: var(--dqd-muted)
      font-size: 12px
      font-weight: 600
    select
      width: 180px
      max-width: 100%

  .dqd-date-group
    display: flex
    align-items: center
    gap: 6px
    input
      width: 148px
    > .dqd-button:not(.dqd-button--today)
      min-width: 32px
      padding: 0 8px
      font-size: 21px

  .dqd-timezone
    padding-bottom: 8px
    color: #8a9baa
    font-size: 11px

  .dqd-mastery-note
    flex: 1
    min-width: 200px
    max-width: 490px
    padding-bottom: 7px
    color: #8398a9
    font-size: 12px
    line-height: 1.8

  .dqd-paused
    color: #99a9b5
    font-size: 10px

  .dqd-learning-host
    margin-top: 4px

  .dqd-notice
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 9px 14px
    margin-top: 15px
    padding: 11px 14px
    border: 1px solid #ccdfed
    border-radius: 9px
    background: #eef7ff
    color: #366486
    font-size: 13px
    &.is-error
      color: #9b4438
      background: #fff4f0
      border-color: #f3d7cb

  .dqd-metrics
    display: grid
    grid-template-columns: repeat(4, minmax(0, 1fr))
    gap: 12px
    margin: 18px 0 22px

  .dqd-metric
    min-width: 0
    padding: 17px 16px 15px
    border: 1px solid var(--dqd-line)
    border-radius: 12px
    background: #fff
    box-shadow: 0 3px 12px rgba(30, 64, 89, .025)

  .dqd-metric-label
    color: #5a7286
    font-size: 12px
    font-weight: 600

  .dqd-metric-value
    display: flex
    align-items: baseline
    flex-wrap: wrap
    gap: 7px
    margin: 7px 0 6px
    font-variant-numeric: tabular-nums
    line-height: 1.3
    strong
      color: var(--dqd-ink)
      font-size: 30px
      font-weight: 700
      letter-spacing: -.5px
    span
      color: #8699a8
      font-size: 12px

  .dqd-metric--teal .dqd-metric-value strong
    color: #177f7c

  .dqd-metric--blue .dqd-metric-value strong
    color: #2f77b5

  .dqd-metric--amber .dqd-metric-value strong
    color: #ab7939

  .dqd-metric-note
    color: #8494a2
    font-size: 11px
    line-height: 1.7

  .dqd-roster
    overflow: hidden
    border: 1px solid var(--dqd-line)
    border-radius: 13px
    background: #fff
    box-shadow: 0 6px 20px rgba(30, 64, 89, .035)

  .dqd-roster-header
    display: flex
    align-items: center
    justify-content: space-between
    flex-wrap: wrap
    gap: 16px
    padding: 21px 19px 17px
    h2
      font-size: 17px
      font-weight: 700
    p
      margin-top: 5px
      color: var(--dqd-muted)
      font-size: 12px

  .dqd-search
    width: 220px
    font-size: 12px
    &::placeholder
      color: #93a3b1

  .dqd-tabs
    display: flex
    gap: 4px
    overflow-x: auto
    padding: 0 14px
    border-bottom: 1px solid var(--dqd-line)
    scrollbar-width: thin

  .dqd-tab
    display: inline-flex
    align-items: center
    gap: 6px
    flex: 0 0 auto
    padding: 12px 10px 11px
    border: 0
    border-bottom: 2px solid transparent
    color: #6b8093
    background: transparent
    font-size: 12px
    font-weight: 600
    &[aria-pressed='true']
      color: var(--dqd-blue)
      border-bottom-color: var(--dqd-blue)
      .dqd-tab-count
        color: var(--dqd-blue)
        background: #eaf3fb

  .dqd-tab-count
    min-width: 20px
    border-radius: 5px
    padding: 0 5px
    background: #f1f4f7
    color: #8594a2
    font-size: 10px
    font-variant-numeric: tabular-nums
    line-height: 19px

  .dqd-table
    width: 100%
    border-collapse: collapse
    table-layout: fixed
    th
      padding: 12px 11px
      background: #f8fafc
      color: #7c8f9f
      font-size: 11px
      font-weight: 600
      text-align: left
      white-space: nowrap
      &:first-child
        width: 28%
        padding-left: 19px
      &:nth-child(2)
        width: 24%
      &:nth-child(3)
        width: 15%
      &:nth-child(4)
        width: 11%
      &:nth-child(5)
        width: 8%
      &:last-child
        width: 14%
    td
      padding: 17px 11px
      border-top: 1px solid #eff3f6
      vertical-align: middle
      font-size: 12px
    .dqd-student-cell
      padding-left: 19px
    .dqd-student-row:hover > td
      background: #fbfdff
    .dqd-student-row.is-expanded > td
      background: #f5faff

  .dqd-identity
    display: flex
    align-items: center
    gap: 9px

  .dqd-avatar
    position: relative
    display: inline-flex
    align-items: center
    justify-content: center
    flex: 0 0 34px
    width: 34px
    height: 34px
    overflow: hidden
    border: 1px solid #e1ecf2
    border-radius: 11px
    background: #edf5f8
    color: #6c92a6
    font-size: 13px
    font-weight: 600
    img
      position: absolute
      width: 100%
      height: 100%
      inset: 0
      object-fit: cover

  .dqd-name
    min-width: 0
    strong
      display: block
      color: #29445b
      font-size: 13px
      font-weight: 600
      overflow-wrap: anywhere
    small
      display: block
      margin-top: 2px
      color: #8a9ba9
      font-size: 10px
      overflow-wrap: anywhere
    .dqd-domain-names
      color: #728998
      line-height: 1.45

  .dqd-progress-label
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 5px 8px

  .dqd-status, .dqd-answer-status
    display: inline-block
    flex: 0 0 auto
    border-radius: 5px
    padding: 2px 7px
    background: #eef2f6
    color: #8393a0
    font-size: 10px
    font-weight: 600
    line-height: 1.7
    white-space: nowrap
    &.is-completed, &.is-correct
      background: #e9f6f1
      color: #25816d
    &.is-inProgress
      background: #eaf3ff
      color: #3a78b4
    &.is-notStarted, &.is-noQuestions
      background: #fff5e7
      color: #ab7a37
    &.is-wrong
      background: #fff0e9
      color: #b87049

  .dqd-progress-numbers
    color: #8495a3
    font-size: 10px
    white-space: nowrap

  .dqd-progress-track
    height: 4px
    max-width: 132px
    overflow: hidden
    margin-top: 8px
    border-radius: 4px
    background: #edf2f5
    span
      display: block
      height: 100%
      border-radius: inherit
      background: #70bab0

  .dqd-last-time
    display: block
    margin-top: 5px
    color: #9aacb8
    font-size: 10px

  .dqd-outcomes, .dqd-number
    font-variant-numeric: tabular-nums
    font-weight: 600

  .dqd-correct
    color: #268675

  .dqd-wrong
    color: #b66d43

  .dqd-divider
    margin: 0 6px
    color: #b7c2cb
    font-weight: 400

  .dqd-detail-toggle
    padding: 5px 0
    border: 0
    background: transparent
    color: var(--dqd-blue)
    font-size: 11px
    white-space: nowrap

  .dqd-roster-footer
    display: flex
    align-items: center
    flex-wrap: wrap
    justify-content: space-between
    gap: 8px 14px
    padding: 15px 19px
    border-top: 1px solid var(--dqd-line)
    color: #728797
    font-size: 11px

  .dqd-scope-note
    color: #91a0ac

  .dqd-empty
    padding: 42px 20px
    color: #516e84
    text-align: center
    strong
      font-size: 15px
      font-weight: 600
    p
      margin: 8px 0 14px
      color: #8a9ba9
      font-size: 13px

  .dqd-table .dqd-detail-row > td
    padding: 0

  .dqd-detail-panel
    padding: 20px
    border-top: 1px solid #e2edf5
    background: #f5f9fc

  .dqd-detail-header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 12px
    h3
      color: #31516b
      font-size: 14px
      font-weight: 600

  .dqd-link
    color: var(--dqd-blue)
    font-size: 12px
    white-space: nowrap
    text-decoration: none
    &:hover
      text-decoration: underline

  .dqd-detail-summary
    margin-top: 9px
    color: #8395a4
    font-size: 11px

  .dqd-detail-message
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 12px
    padding: 22px 0 9px
    color: #7990a3
    font-size: 13px
    &.is-error
      color: #a15743

  .dqd-answer-filters
    display: flex
    gap: 7px
    margin: 16px 0 12px

  .dqd-answer-filter
    border: 1px solid #dce7ef
    border-radius: 6px
    padding: 5px 10px
    background: #fff
    color: #758b9c
    font-size: 11px
    &[aria-pressed='true']
      border-color: #aecde6
      color: #3475ad
      background: #edf6fd

  .dqd-question
    overflow: hidden
    margin-top: 9px
    border: 1px solid #dfe9f1
    border-radius: 9px
    background: #fff
    summary
      display: flex
      align-items: center
      gap: 9px
      padding: 13px 15px
      color: #31516b
      cursor: pointer
      list-style: none
      &::-webkit-details-marker
        display: none
      &::after
        content: '+'
        flex: 0 0 auto
        color: #86a0b3
        font-size: 16px
      strong
        flex: 1
        min-width: 0
        font-size: 13px
        font-weight: 600
        overflow-wrap: anywhere
      > small
        color: #97a7b3
        font-size: 10px
        white-space: nowrap
    &[open] summary::after
      content: '−'

  .dqd-question-body
    padding: 3px 16px 17px

  .dqd-question-meta
    margin-bottom: 13px
    color: #96a6b3
    font-size: 11px

  .dqd-markdown
    min-width: 0
    color: #40566a
    font-size: 13px
    line-height: 1.85
    overflow-wrap: anywhere
    p
      margin: 0 0 10px
      &:last-child
        margin-bottom: 0
    pre
      max-width: 100%
      overflow-x: auto
      margin: 10px 0
      padding: 12px
      border: 1px solid #e3eaf0
      border-radius: 6px
      background: #f7f9fb
      font-size: 12px
      white-space: pre
    img
      max-width: 100%
      height: auto
    table
      display: block
      overflow-x: auto
      table-layout: auto
      width: auto
      th, td
        width: auto
        min-width: 70px
        padding: 7px 10px
        font-size: 12px

  .dqd-option
    display: flex
    align-items: flex-start
    gap: 10px
    padding: 10px 12px
    margin-top: 8px
    border: 1px solid #e7edf3
    border-radius: 7px
    background: #fbfcfd
    .dqd-markdown
      flex: 1
    &.is-answer
      border-color: #bcded4
      background: #f2faf6
    &.is-selected:not(.is-answer)
      border-color: #efd7c8
      background: #fff8f3

  .dqd-option-letter
    flex: 0 0 17px
    padding-top: 2px
    color: #6e8da0
    font-size: 12px

  .dqd-option-labels
    display: flex
    flex-direction: column
    gap: 3px
    flex: 0 0 auto
    padding-top: 3px
    color: #8093a1
    small
      font-size: 10px

  .dqd-answers
    display: flex
    flex-wrap: wrap
    gap: 7px 22px
    margin-top: 14px
    color: #6f8292
    font-size: 12px
    font-weight: 600

  .dqd-analysis
    margin-top: 15px
    padding: 13px 15px
    border-radius: 7px
    background: #f2f6fa
    h4
      margin-bottom: 7px
      color: #56728a
      font-size: 12px
      font-weight: 600

@media screen and (max-width: 1100px)
  .daily-quiz-dashboard
    padding: 18px
    .dqd-metrics
      grid-template-columns: repeat(2, minmax(0, 1fr))
    .dqd-timezone
      flex-basis: 100%
      padding: 0
      margin-top: -7px
    .dqd-table
      th, td
        padding-left: 8px
        padding-right: 8px
    .dqd-avatar
      display: none

@media screen and (max-width: 640px)
  .daily-quiz-dashboard
    padding: 15px 12px
    border-radius: 12px
    h1
      font-size: 25px
    .dqd-header
      align-items: flex-start
      gap: 10px
      margin-bottom: 18px
    .dqd-subtitle
      font-size: 12px
    .dqd-header > .dqd-button
      min-height: 32px
      padding: 0 9px
      margin-top: 5px
      font-size: 11px
    .dqd-controls
      gap: 13px
      padding: 14px 12px
    .dqd-field
      width: 100%
      select
        width: 100%
    .dqd-date-group
      input
        flex: 1
        width: 0
    .dqd-timezone
      margin-top: 0
      font-size: 10px
    .dqd-metrics
      gap: 8px
      margin: 13px 0 17px
    .dqd-metric
      padding: 13px 12px
    .dqd-metric-value strong
      font-size: 27px
    .dqd-metric-note
      font-size: 10px
    .dqd-roster-header
      padding: 16px 13px 14px
      gap: 12px
      p
        font-size: 11px
    .dqd-search
      width: 100%
    .dqd-tabs
      gap: 0
      padding: 0 7px
    .dqd-tab
      gap: 5px
      padding-left: 7px
      padding-right: 7px
      font-size: 11px
    .dqd-tab-count
      min-width: 18px
      padding: 0 4px
    .dqd-table, .dqd-table tbody
      display: block
      width: 100%
    .dqd-table thead
      display: none
    .dqd-table .dqd-student-row
      display: grid
      grid-template-columns: repeat(3, minmax(0, 1fr))
      gap: 12px 9px
      padding: 15px 14px
      border-top: 1px solid var(--dqd-line)
      > td
        display: block
        border: 0
        padding: 0
        min-width: 0
        background: transparent
      > .dqd-student-cell
        grid-column: 1 / 3
        grid-row: 1
      > .dqd-action-cell
        grid-column: 3
        grid-row: 1
        align-self: center
        text-align: right
      > .dqd-progress-cell
        grid-column: 1 / 4
        grid-row: 2
      > .dqd-outcomes, > .dqd-number
        &::before
          display: block
          content: attr(data-label)
          margin-bottom: 3px
          color: #95a5b2
          font-size: 10px
          font-weight: 400
      &.is-expanded
        background: #f5faff
    .dqd-avatar
      display: inline-flex
    .dqd-last-time
      margin-top: 5px
    .dqd-progress-track
      max-width: 100%
    .dqd-table .dqd-detail-row
      display: block
      > td
        display: block
        width: 100%
    .dqd-detail-panel
      padding: 16px 12px
    .dqd-detail-header
      align-items: flex-start
      h3
        font-size: 12px
    .dqd-detail-summary
      font-size: 10px
    .dqd-question summary
      flex-wrap: wrap
      padding: 11px 10px
      gap: 7px
      strong
        font-size: 12px
      > small
        display: none
    .dqd-question-body
      padding: 3px 10px 13px
    .dqd-option
      flex-wrap: wrap
      gap: 7px
      padding: 9px
    .dqd-option-labels
      width: 100%
      flex-direction: row
      padding-left: 24px
    .dqd-markdown
      font-size: 12px
    .dqd-roster-footer
      padding: 12px 14px
    .dqd-scope-note
      flex-basis: 100%
      font-size: 10px

@media (prefers-reduced-motion: reduce)
  .daily-quiz-dashboard .dqd-button
    transition: none
