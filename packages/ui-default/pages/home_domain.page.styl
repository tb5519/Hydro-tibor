.page--home_domain
  .domain-auto-star
    display: inline-flex
    align-items: center
    gap: 4px
    margin-left: 10px
    padding: 3px 8px
    border-radius: 6px
    background: #edf4ff
    color: #4473b8
    font-size: 12px
    white-space: nowrap

  .col--icon
    width: 60px
    line-height: 1

    img
      border-radius: 50%

  .col--role
    width: rem(160px)
    border-left: 1px solid $table-border-color

  .col--action
    width: rem(200px)

  +mobile()
    .col--icon, .col--role
      display: none
