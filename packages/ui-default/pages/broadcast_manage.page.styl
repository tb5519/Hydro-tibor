.broadcast-admin
  --broadcast-accent: #0f766e
  --broadcast-ink: #173343
  color: #334155
  margin-bottom: 28px
  font-size: 14px

  [hidden]
    display: none !important

  button, input
    font: inherit

  button
    cursor: pointer
    &:disabled
      cursor: default
      opacity: .5

  button:focus-visible, input:focus-visible, [contenteditable]:focus-visible
    outline: 3px solid #99ddd2
    outline-offset: 3px

  &__hero
    display: flex
    align-items: flex-start
    gap: 18px
    padding: 28px
    border: 1px solid #d9ebe6
    border-radius: 20px
    background: linear-gradient(120deg, #edf8f3, #f3f8fd)
    h1
      color: var(--broadcast-ink)
      font-size: 28px
      font-weight: 700
      margin: 8px 0 10px
      line-height: 1.25
    p
      margin: 0
      color: #526878
      line-height: 1.7

  &__hero-icon
    display: flex
    align-items: center
    justify-content: center
    width: 48px
    height: 48px
    flex: 0 0 48px
    border-radius: 15px
    color: var(--broadcast-accent)
    background: #fff
    font-size: 24px
    box-shadow: 0 4px 16px rgba(15, 118, 110, .08)

  &__eyebrow
    font-size: 12px
    color: #4c726e
    letter-spacing: .08em

  &__overview
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 12px
    margin: 18px 2px
    font-size: 12px
    color: #64748b

  &__status
    display: inline-flex
    align-items: center
    gap: 6px
    padding: 5px 10px
    border-radius: 20px
    background: #e9edf1
    color: #526173
    &:before
      content: ''
      width: 6px
      height: 6px
      border-radius: 50%
      background: currentColor
    &.is-live
      color: #147466
      background: #e0f3e9

  &__updated
    margin-left: auto

  &__message
    margin: 0 0 16px
    border: 1px solid #d1e6f4
    border-radius: 12px
    padding: 12px 16px
    background: #f0f7fd
    line-height: 1.7
    &.is-success
      color: #126255
      background: #edf9f2
      border-color: #c5e7d5
    &.is-error
      color: #9c3138
      background: #fff3f2
      border-color: #f4d0cb

  &__form
    background: #fff
    border: 1px solid #e1e8ef
    border-radius: 18px
    padding: 26px
    box-shadow: 0 8px 28px rgba(30, 54, 76, .035)

  &__field + &__field
    margin-top: 24px

  &__label-row
    display: flex
    align-items: center
    justify-content: space-between
    gap: 10px
    margin-bottom: 10px
    label
      font-weight: 600
      color: var(--broadcast-ink)
    span
      color: #8794a4
      font-size: 12px

  &__title
    box-sizing: border-box
    width: 100%
    height: 48px
    padding: 0 14px
    border: 1px solid #dce4ec
    border-radius: 10px
    color: var(--broadcast-ink)
    background: #fff
    &::placeholder
      color: #98a4b4

  &__editor-shell
    border: 1px solid #dce4ec
    border-radius: 12px
    &:focus-within
      border-color: #75b5aa
      box-shadow: 0 0 0 3px rgba(15, 118, 110, .05)

  &__toolbar
    display: flex
    flex-wrap: wrap
    padding: 8px
    gap: 5px 0
    border-bottom: 1px solid #e4eaf0
    border-radius: 12px 12px 0 0
    background: #f8fafb
    button
      min-width: 32px
      min-height: 34px
      border: 0
      padding: 6px 8px
      border-radius: 6px
      background: transparent
      color: #476075
      font-size: 12px
      &:hover, &[aria-pressed=true]
        background: #e0f0eb
        color: var(--broadcast-accent)

  &__toolbar-group
    display: inline-flex
    align-items: center
    padding: 0 5px
    border-right: 1px solid #dfe6ed
    &:last-child
      border-right: 0

  &__editor
    position: relative
    box-sizing: border-box
    min-height: 320px
    max-height: 650px
    overflow-y: auto
    padding: 22px
    outline: none
    &:empty:before
      content: attr(data-placeholder)
      color: #a0aaba
      pointer-events: none
    &[aria-invalid=true]
      box-shadow: inset 0 0 0 1px #d47474

  &__editor-footer
    display: flex
    justify-content: space-between
    flex-wrap: wrap
    gap: 6px
    padding: 10px 16px
    border-top: 1px solid #edf0f4
    color: #8491a1
    font-size: 11px

  &__link-panel
    padding: 12px 18px
    border-bottom: 1px solid #dce4ec
    background: #eef7f4
    label
      display: block
      font-size: 12px
      margin-bottom: 7px
    > div
      display: flex
      gap: 6px
    input
      min-width: 0
      flex: 1
      border: 1px solid #cbdbd5
      border-radius: 6px
      padding: 8px
    button
      padding: 6px 10px
      border: 1px solid #cbdbd5
      border-radius: 6px
      background: #fff
    small
      display: block
      font-size: 11px
      color: #688178
      margin-top: 8px

  &__notice
    display: flex
    gap: 9px
    color: #65788b
    margin: 22px 0
    font-size: 12px
    line-height: 1.8
    .icon
      margin-top: 2px
      color: #5d8f91
    p
      margin: 0
    strong
      font-weight: 500
      color: #3a6870

  &__actions, &__action-buttons
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 10px

  &__actions
    justify-content: space-between
    padding-top: 20px
    border-top: 1px solid #edf0f4

  &__button
    display: inline-flex
    justify-content: center
    align-items: center
    min-height: 42px
    padding: 9px 17px
    border: 1px solid #d9e1e8
    border-radius: 9px
    color: #4c6074
    background: #fff
    font-weight: 500
    line-height: 1.5
    &:hover:not(:disabled)
      border-color: #91b7ae
      background: #f2f8f6
    &.is-primary
      background: #0f766e
      color: #fff
      border-color: #0f766e
      &:hover:not(:disabled)
        background: #0a625c
    &.is-danger
      color: #a63e41
      border-color: #ebc8c7
      background: #fff8f7

  &__draft-state
    color: #94a0af
    font-size: 11px
    &.is-dirty
      color: #99712f

  &__pause
    display: flex
    flex-wrap: wrap
    justify-content: space-between
    gap: 16px
    align-items: center
    padding: 22px 5px
    color: #748394
    font-size: 12px
    strong
      font-weight: 500
      color: #53677a
    p
      margin: 6px 0 0
      line-height: 1.7
    > button
      background: transparent
      border: 0
      color: #976267
      padding: 10px 0 10px 10px

  &__pause-confirm
    width: 100%
    border-top: 1px solid #e3e7ed
    padding-top: 14px
    p
      margin: 0 0 12px

.broadcast-rich-content
  color: #394e60
  font-size: 16px
  line-height: 1.8
  overflow-wrap: anywhere
  p, div, ul, ol, blockquote, table
    margin: 0 0 1em
  h1, h2, h3, h4
    color: #173343
    font-weight: 650
    line-height: 1.4
    margin: 1.15em 0 .65em
  h1
    font-size: 26px
  h2
    font-size: 22px
  h3, h4
    font-size: 18px
  ul, ol
    padding-left: 1.6em
  ul
    list-style: disc
  ol
    list-style: decimal
  li
    margin: .35em 0
  blockquote
    padding: 12px 18px
    border-left: 3px solid #54a799
    border-radius: 0 10px 10px 0
    background: #eff8f4
    color: #426b64
  a
    color: #0f766e
    text-decoration: underline
    text-underline-offset: 3px
  img
    max-width: 100%
    height: auto
    border-radius: 12px
  table
    border-collapse: collapse
    width: 100%
  th, td
    padding: 8px 12px
    border: 1px solid #dbe5e8
  > :first-child
    margin-top: 0
  > :last-child, blockquote > :last-child, li > :last-child
    margin-bottom: 0

.broadcast-preview
  box-sizing: border-box
  width: 680px
  max-width: calc(100vw - 32px)
  max-height: 90vh
  max-height: unquote('min(820px, 90dvh)')
  padding: 0
  border: 0
  border-radius: 24px
  background: #fff
  color: #334155
  box-shadow: 0 28px 100px rgba(15, 23, 42, .24)
  overflow-y: auto
  &::backdrop
    background: rgba(15, 23, 42, .5)
    backdrop-filter: blur(5px)
  &[open]
    display: flex
    flex-direction: column
  &__top
    display: flex
    justify-content: space-between
    align-items: center
    padding: 15px 24px
    color: #84909d
    font-size: 12px
    button
      display: flex
      align-items: center
      justify-content: center
      width: 32px
      height: 32px
      border: 0
      border-radius: 50%
      color: #6b7d8b
      background: #f2f5f7
      font-size: 22px
  &__heading
    padding: 16px 36px 22px
    background: linear-gradient(120deg, #f1f9f5, #f5f9fc)
    h2
      margin: 14px 0 8px
      color: #173343
      font-size: 26px
      font-weight: 700
      line-height: 1.4
      overflow-wrap: anywhere
    p
      margin: 0
      color: #7c8d9b
      font-size: 12px
  &__badge
    display: inline-block
    border-radius: 18px
    background: #e0f1e9
    color: #147466
    padding: 5px 10px
    font-size: 11px
  &__body
    min-height: 100px
    padding: 28px 36px
    overflow-y: auto
  &__footer
    display: flex
    align-items: center
    justify-content: space-between
    gap: 18px
    padding: 20px 36px
    border-top: 1px solid #edf1f4
    small
      color: #94a0ac
      font-size: 11px
      line-height: 1.6
    button
      min-width: 110px
      flex-shrink: 0

@media (max-width: 640px)
  .broadcast-admin
    &__hero
      padding: 20px 18px
      gap: 12px
      h1
        font-size: 24px
    &__hero-icon
      width: 38px
      height: 38px
      flex-basis: 38px
      font-size: 20px
    &__updated
      flex-basis: 100%
      margin-left: 0
    &__form
      padding: 18px 14px
    &__editor
      padding: 16px
      min-height: 280px
    &__toolbar
      padding: 6px 2px
    &__toolbar-group
      padding: 0 3px
    &__action-buttons
      width: 100%
      button
        flex: 1
        padding-left: 10px
        padding-right: 10px
    &__label-row span
      font-size: 11px
  .broadcast-preview
    border-radius: 18px
    &__heading, &__body
      padding: 22px
    &__heading h2
      font-size: 22px
    &__footer
      padding: 18px 22px
      flex-wrap: wrap
      button
        width: 100%

@media (prefers-reduced-motion: reduce)
  .broadcast-admin *, .broadcast-preview *
    transition: none !important
