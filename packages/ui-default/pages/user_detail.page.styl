@import '~vj/components/tab/var.inc.styl'

.page--user_detail

  .profile-header
    position: relative
    background-position: center center
    background-size: cover
    min-height: rem(270px)
    padding-bottom: rem($tab-item-height + $tab-item-shadow-size + 20px)

    +mobile()
      padding-bottom: rem($tab-item-height-mobile)

  .profile-header__content
    position: relative
    padding: rem($section-gap-v) rem($section-gap-h) 0

    .media__left
      padding-right: rem(30px)

    +mobile()
      .media, .media__left, .media__body
        display: block

      .media__left
        text-align: center

        img
          display: inline-block

      .media__body
        margin-top: rem(20px)

  .profile-header__contact-bar
    position: absolute
    right: rem($section-gap-h + 5px)
    top: rem($section-gap-v + 20px)
    color: #FFF
    text-align: right

    +below(rupture.hd-cutoff)
      position: relative
      right: 0
      top: 0
      text-align: left
      margin: rem(15px 0)

  .profile-header__contact-item
    vertical-align: top
    color: rgba(#FFF, 0.8)
    margin-left: rem(10px)

    +below(rupture.hd-cutoff)
      margin-left: 0
      margin-right: rem(15px)

    &:hover
      color: rgba(#FFF, 1)
      text-decoration: none

    &.badge--su
      background-color: rgba(#FFF, 0.8) !important
      color: rgba(#000, 0.8) !important

    &.badge--mod
      background-color: rgba(#FFF, 0.8) !important
      color: rgba(#000, 0.8) !important

  .profile-header__main
    h1
      line-height: 40px
      color: #FFF

    p
      line-height: 30px
      color: #FFF

    small
      color: rgba(#FFF, 0.8)

  .profile-header__edit
    display: inline-flex
    align-items: center
    gap: 7px
    padding: 6px 12px
    margin-top: -6px
    border: 1px solid rgba(#FFF, .4)
    border-radius: 8px
    background: rgba(#FFF, .12)
    font-size: 13px
    line-height: 20px

    &:hover, &:focus-visible
      background: rgba(#FFF, .24)
      color: #FFF

    &:focus-visible
      outline: 2px solid #FFF
      outline-offset: 3px

  .profile-content
    position: relative
    z-index: 2
    margin-top: rem(-($tab-item-height + $tab-item-shadow-size))

    +mobile()
      margin-top: rem(-($tab-item-height-mobile))

    .section__tabs
      padding-top: rem($tab-item-height + $tab-item-shadow-size)

      +mobile()
        padding-top: rem($tab-item-height-mobile)
  #rating-placeholder
    width: auto
    height: 600px

  .profile-ac-difficulty
    padding: 22px 20px 16px
    overflow: hidden
    border: 1px solid #e4eaf3
    border-radius: 18px
    background: linear-gradient(155deg, #f7faff 0, #fff 180px)
    box-shadow: 0 6px 24px rgba(34, 64, 112, .045)
    color: #263a53

    &, *
      box-sizing: border-box

    &__header
      display: flex
      align-items: center
      gap: 10px

      h2
        margin: 0
        font-size: 17px
        line-height: 1.5
        font-weight: 600
        letter-spacing: .02em
        color: #263a53

      p
        margin: 3px 0 0
        font-size: 11px
        line-height: 1.6
        color: #7a8ba1

    &__icon
      display: flex
      align-items: center
      justify-content: center
      flex: 0 0 36px
      width: 36px
      height: 36px
      border: 1px solid #dbe8fc
      border-radius: 12px
      background: #eaf2ff
      color: #4b7ecd

      svg
        width: 24px
        height: 24px

    &__summary
      display: flex
      align-items: center
      justify-content: space-between
      gap: 12px
      padding: 21px 0 19px
      margin-bottom: 14px
      border-bottom: 1px solid #eaf0f7

    &__summary-label
      font-size: 11px
      line-height: 1.5
      color: #7789a0

    &__total
      display: flex
      align-items: baseline
      gap: 7px
      margin-top: 3px
      font-variant-numeric: tabular-nums

      strong
        font-size: 35px
        line-height: 1.1
        font-weight: 650
        letter-spacing: -.04em
        color: #26466d

      span
        font-size: 12px
        color: #8392a5

    &__highest
      display: flex
      flex-direction: column
      align-items: center
      flex: 0 0 auto
      gap: 3px
      padding: 9px 13px
      border: 1px solid #e2e9f4
      border-radius: 12px
      background: rgba(#fff, .8)

      > span
        font-size: 10px
        color: #7f8ea3

      strong
        font-size: 20px
        line-height: 1.3
        font-weight: 600
        color: #5273a4

    &__summary-note
      max-width: 100px
      font-size: 11px
      line-height: 1.8
      text-align: right
      color: #8a99ad

    &__column-labels
      display: flex
      justify-content: space-between
      margin-bottom: 6px
      font-size: 10px
      line-height: 1.5
      color: #91a0b3

    &__levels
      margin: 0
      padding: 0
      list-style: none

    &__row
      --ac-difficulty-color: #5298ca
      display: flex
      align-items: center
      gap: 12px
      min-height: 31px
      font-variant-numeric: tabular-nums

      &[data-level='1']
        --ac-difficulty-color: #54a8b9
      &[data-level='2']
        --ac-difficulty-color: #4ba2c7
      &[data-level='3']
        --ac-difficulty-color: #548fd1
      &[data-level='4']
        --ac-difficulty-color: #647fd1
      &[data-level='5']
        --ac-difficulty-color: #7b79cc
      &[data-level='6']
        --ac-difficulty-color: #977bc2
      &[data-level='7']
        --ac-difficulty-color: #b182b4
      &[data-level='8']
        --ac-difficulty-color: #c18f83
      &[data-level='9']
        --ac-difficulty-color: #c59b58
      &[data-level='10']
        --ac-difficulty-color: #bb953f

    &__level
      display: flex
      align-items: baseline
      flex: 0 0 22px
      font-size: 12px
      font-weight: 600
      color: var(--ac-difficulty-color)

    &__track
      display: block
      flex: 1 1 0
      min-width: 0
      height: 5px
      overflow: hidden
      border-radius: 999px
      background: #edf2f8

      > span
        display: block
        height: 100%
        border-radius: inherit
        background: var(--ac-difficulty-color)

    &__count
      display: flex
      align-items: baseline
      justify-content: flex-end
      gap: 4px
      flex: 0 0 auto
      min-width: 42px
      font-size: 13px
      font-weight: 550
      color: #40556f

      small
        font-size: 10px
        font-weight: 400
        color: #98a4b4

    &__row.is-empty
      .profile-ac-difficulty__count
        color: #adb7c5

    &__unrated
      display: flex
      align-items: baseline
      justify-content: space-between
      gap: 10px
      padding: 11px 0 0
      margin-top: 9px
      border-top: 1px dashed #e2e9f3
      font-size: 11px
      line-height: 1.5
      color: #8898ac

      strong
        font-size: 13px
        font-weight: 550
        font-variant-numeric: tabular-nums
        color: #62758d

    &__footnote
      margin: 13px 0 0
      font-size: 10px
      line-height: 1.7
      color: #96a3b4
