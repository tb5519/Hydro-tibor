.chat-snapshot
  max-width: 1460px
  margin: 12px auto 32px
  color: #25374b
  &__header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 24px
    margin-bottom: 24px
    h1
      margin: 8px 0 10px
      font-size: clamp(24px, 3vw, 34px)
      font-weight: 700
    p
      color: #768797
      font-size: 14px
      span
        padding: 0 6px
  &__eyebrow
    color: #398278
    font-size: 13px
    letter-spacing: .08em
  &__link
    display: inline-flex
    gap: 16px
    white-space: nowrap
    border: 1px solid #dbe5ed
    border-radius: 12px
    background: white
    padding: 12px 18px
    color: #32786f
    text-decoration: none
  &__grid
    display: grid
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr)
    gap: 22px
    align-items: start
  &__card
    min-width: 0
    background: #fff
    border: 1px solid #dfe7ef
    border-radius: 18px
    overflow: hidden
    box-shadow: 0 8px 30px rgba(35, 58, 82, .035)
  &__bar
    display: flex
    align-items: center
    gap: 12px
    padding: 18px 22px
    border-bottom: 1px solid #e9eef3
    h2
      margin: 0
      font-size: 16px
      font-weight: 600
    > span
      color: #8a98a7
      font-size: 13px
    button
      margin-left: auto
      padding: 6px 10px
      border: 0
      border-radius: 8px
      color: #32786f
      background: #edf6f3
      font-size: 12px
      cursor: pointer
  &__statement
    padding: 24px
    overflow-wrap: anywhere
    img
      max-width: 100%
  &__code
    margin: 0
    padding: 24px
    min-height: 200px
    max-height: calc(100vh - 280px)
    overflow: auto
    background: #f8fafc
    font-family: var(--code-font-family, monospace)
    font-size: 15px
    line-height: 1.8
    white-space: pre
    code
      color: #243b53
      font: inherit
      border: 0
      background: none
      padding: 0
  &__empty
    color: #8795a3
    padding: 32px 24px
  @media (max-width: 850px)
    &__grid
      grid-template-columns: 1fr
    &__header
      align-items: flex-start
      flex-wrap: wrap
    &__code
      max-height: none
