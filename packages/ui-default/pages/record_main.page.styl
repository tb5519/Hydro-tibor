.page--record_main
  // The site reduces rem on narrow screens; keep record text comfortably readable.
  .record-list
    color: #334155

  .record-list__header
    display: flex
    align-items: center
    justify-content: space-between
    flex-wrap: wrap
    gap: rem(12px)
    margin: rem(3px) 0 rem(20px)

  .record-list__heading
    display: flex
    align-items: center
    gap: rem(13px)

    h1
      margin: 0
      color: #263e5e
      font-size: 28px
      font-weight: 750
      line-height: 1.3

  .record-list__scope
    color: #617c9d
    background: #e5edf7
    border-radius: rem(5px)
    font-size: 14px
    line-height: 1.4
    padding: rem(4px) rem(8px)

  .record-list__context
    max-width: 50%
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
    color: #6783a6
    font-size: 15px

  .record-list__filters
    display: grid
    grid-template-columns: repeat(6, minmax(0, 1fr)) auto
    align-items: end
    gap: rem(12px)
    margin: 0 0 rem(16px)
    padding: rem(17px) rem(20px)
    background: #fff
    border: 1px solid #e0e7f0
    border-radius: rem(12px)

  .record-list__field
    display: block
    min-width: 0
    margin: 0

    > span:first-child
      display: block
      margin-bottom: rem(7px)
      color: #647993
      font-size: 14px
      line-height: 1.4

    .textbox, .select
      box-sizing: border-box
      width: 100%
      height: 42px
      margin: 0
      padding: 0 rem(9px)
      border: 1px solid #dfe6ef
      border-radius: rem(7px)
      background: #fff
      color: #405572
      box-shadow: none
      font-size: 15px

    .textbox::placeholder
      color: #8494a9

    .textbox:focus, .select:focus
      border-color: #8db3e6
      outline: none
      box-shadow: 0 0 0 2px rgba(85, 140, 214, .10)

    .autocomplete-container
      display: block !important
      margin: 0 !important
      vertical-align: top

    .autocomplete-wrapper
      box-sizing: border-box
      align-items: center
      flex-wrap: nowrap
      height: 42px !important
      min-height: 0
      padding: 0
      overflow: hidden
      border: 1px solid #dfe6ef
      border-radius: rem(7px)
      background: #fff
      outline: none
      box-shadow: none

      &:hover
        border-color: #b8c9df

      &.focused, &:focus-within
        border-color: #8db3e6
        outline: none
        box-shadow: 0 0 0 2px rgba(85, 140, 214, .10)

      input
        box-sizing: border-box
        width: 100%
        min-width: 0
        height: 100%
        margin: 0
        padding: 0 rem(9px)
        border: 0
        border-radius: rem(6px)
        background: transparent
        color: #405572
        outline: none
        box-shadow: none
        font-family: inherit
        font-size: 15px

        &::placeholder
          color: #8494a9

  .record-list__filter-actions
    display: flex
    align-items: center
    gap: rem(12px)
    min-height: 42px
    white-space: nowrap

    .button
      display: inline-flex
      align-items: center
      gap: rem(5px)
      height: 42px
      margin: 0
      padding: 0 rem(13px)
      border: 0
      border-radius: rem(7px)
      background: #3e7cce
      box-shadow: none
      font-size: 15px
      line-height: 1

    .button:hover
      background: #306bb7

  .record-list__reset
    color: #657e9b
    font-size: 14px

  .record-list__content
    overflow: hidden
    border: 1px solid #e0e7f0
    border-radius: rem(12px)
    background: #fff

  .record-list__table-wrap
    overflow-x: auto

  .record-list [hidden]
    display: none !important

  .record_main__table
    width: 100%
    min-width: 1120px
    table-layout: fixed
    border: 0
    color: #51647d
    font-size: 15px

    thead th
      height: rem(48px)
      padding: rem(10px) rem(17px)
      border: 0
      border-bottom: 1px solid #e8edf4
      background: #f8fafc
      color: #647993
      font-size: 14px
      font-weight: 600
      white-space: nowrap

    tbody td
      padding: rem(18px) rem(17px)
      border: 0
      border-bottom: 1px solid #edf1f6
      line-height: 1.6
      vertical-align: middle

    tbody tr, tbody tr:nth-child(even)
      background: #fff

    tbody tr:hover
      background: #f8fbff

    tbody tr:last-child td
      border-bottom: 0

    .col--problem-name
      color: #2d435f
      overflow-wrap: anywhere

      > a
        color: inherit
        font-size: 16px

      > a:hover
        color: #3577cd

      b
        color: #70849e
        font-size: 14px
        font-weight: 500

    .col--problem-name:has(.form--inline)
      position: relative
      padding-bottom: rem(40px)

    .form--inline
      position: absolute
      left: rem(17px)
      bottom: rem(9px)
      display: flex
      gap: rem(10px)
      margin: 0
      font-size: 0

      button
        color: #75869c !important
        font-size: 13px
        font-weight: 400

      button:hover
        color: #a55353 !important

    .user-profile-name
      color: #4d6685
      font-size: 15px
      overflow-wrap: anywhere

    .record-status--text
      font-size: 15px
      font-weight: 500

    .record-status--icon
      font-size: 14px

  .col--status
    width: 198px
    position: relative

  .col--submit-at
    width: 140px
    text-align: right

  &.nojs .col--submit-at
    width: 160px

  .col--submit-by
    width: 140px
    text-align: left

  .col--time, .col--memory
    width: 96px
    text-align: right
    font-variant-numeric: tabular-nums

  .col--lang
    width: 105px
    text-align: center

  .col--status__text
    position: relative
    z-index: 2

  .col--status__progress-container
    position: absolute
    left: 0
    top: 0
    width: 100%
    height: 100%
    z-index: 1

  .col--status__progress
    position: absolute
    left: 0
    top: 0
    height: 100%
    background: #fff9e6

  .record-list--self
    .col--submit-by
      display: none

    .record_main__table
      min-width: 960px

  .record-main__homework-tag
    display: inline-block
    margin-left: rem(6px)
    padding: rem(2px) rem(5px)
    border-radius: rem(3px)
    color: #528773
    background: #eff7f2
    font-size: 13px
    line-height: 1.2
    vertical-align: middle

    &:hover
      color: #246b4e
      background: #e4f1e9
      text-decoration: none

  .record-list__empty
    padding: rem(55px) rem(20px)
    text-align: center

    > .icon
      color: #bccce0
      font-size: rem(28px)

    h2
      margin: rem(14px) 0 rem(8px)
      color: #58728f
      font-size: 20px
      font-weight: 600

    p
      margin: 0
      color: #75869c
      font-size: 15px
      line-height: 1.7

    a
      display: inline-block
      margin-top: rem(15px)
      color: #4a83ce
      font-size: 15px

  .record-list__pagination
    display: flex
    align-items: center
    justify-content: center
    gap: rem(22px)
    margin: rem(20px) 0
    font-size: 14px

  .record-list__page-link
    color: #597da8

  .record-list__page-number
    color: #75869c

  .record-list__statistics
    margin-top: rem(25px)
    color: #657e9b
    font-size: 14px

    summary
      cursor: pointer

    dl
      display: flex
      flex-wrap: wrap
      gap: rem(22px)
      margin-top: rem(15px)

    dd
      margin: rem(4px) 0 0
      color: #527295

  .record-list a:focus-visible, .record-list button:focus-visible
    outline: 2px solid #8db3e6
    outline-offset: 3px

  @media (max-width: 1100px)
    .record-list__filters
      grid-template-columns: repeat(3, minmax(0, 1fr))

    .record-list__filter-actions
      grid-column: 1 / -1
      justify-content: flex-end

  +mobile()
    .record-list__header
      margin-bottom: rem(15px)

    .record-list__heading h1
      font-size: 25px

    .record-list__context
      max-width: 100%

    .record-list__filters
      grid-template-columns: repeat(2, minmax(0, 1fr))
      gap: rem(12px)
      padding: rem(15px)

    .record-list__empty
      padding: rem(42px) rem(18px)
