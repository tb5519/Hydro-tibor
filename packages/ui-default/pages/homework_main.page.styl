.page--homework_main
  .homework-hub
    overflow visible
    border 1px solid #dfe8f3
    border-radius 20px
    background #fff
    box-shadow 0 10px 32px rgba(37, 65, 103, .045)
    color #304c6a

    [hidden]
      display none !important

    .button
      margin 0
      border-radius 10px
      font-size 14px
      height 40px
      line-height 38px

    a
      text-decoration none

  .homework-hub__hero
    display flex
    align-items center
    justify-content space-between
    gap 20px
    padding 28px 30px 25px
    background linear-gradient(110deg, #f4f9ff, #fff 70%)
    border-radius 20px 20px 0 0
    border-bottom 1px solid #e7eef7

    h1
      margin 0
      font-size 28px
      line-height 1.4
      font-weight 750
      color #1b3557

    p
      margin 6px 0 0
      color #7b8fa7
      font-size 14px

    .homework-hub__eyebrow
      margin 0 0 5px
      color #6593d3
      font-size 10px
      letter-spacing 2px
      font-weight 800

    .homework-hub__create
      flex-shrink 0
      padding 0 20px
      box-shadow 0 4px 12px rgba(49, 122, 214, .14)

  .homework-hub__body
    padding 24px 30px 30px

  .homework-admin__nav
    display flex
    gap 6px
    width fit-content
    margin-bottom 24px
    padding 5px
    border-radius 12px
    background #f0f5fb
    transition opacity .16s ease, transform .16s ease

  a.homework-admin__nav-link
    display flex
    align-items center
    gap 9px
    padding 11px 22px
    border-radius 9px
    color #7d91aa
    font-size 14px
    font-weight 650
    white-space nowrap

    &:hover
      color #317bc5

    &.is-active
      color #2d77c4
      background #fff
      box-shadow 0 2px 7px rgba(37, 78, 129, .08)

    &.is-loading
      opacity .6
      cursor progress

  .homework-admin__content
    min-width 0
    transition opacity .16s ease, transform .16s ease

  .is-homework-view-leaving
    opacity 0
    transform translateY(5px)
    pointer-events none

  .is-homework-view-entering
    animation homework-view-in .25s ease both

  .homework-toolbar
    display flex
    align-items center
    justify-content space-between
    flex-wrap wrap
    gap 14px
    margin-bottom 18px

  .homework-filters
    display flex
    align-items center
    gap 6px
    flex-wrap wrap

    button
      display flex
      align-items center
      gap 7px
      min-height 36px
      padding 7px 12px
      color #8193a8
      background transparent
      border 1px solid transparent
      border-radius 9px
      cursor pointer
      font-size 13px
      line-height 20px
      font-weight 650
      transition background .15s ease, color .15s ease

      span
        font-size 11px
        font-weight 700
        opacity .8

      &:hover
        color #347dc5
        background #f6faff

      &.is-active
        border-color #d5e6f9
        background #edf6ff
        color #2c7bc7

  .homework-search
    display flex
    align-items center
    gap 10px
    width 275px
    min-width 0
    margin 0
    padding 0 13px
    border 1px solid #dfe8f2
    border-radius 9px
    background #fafcfe
    color #9badc1

    &:focus-within
      border-color #80b4ee
      box-shadow 0 0 0 3px rgba(69, 144, 224, .08)

    input
      width 100%
      min-width 0
      height 38px
      padding 0
      outline 0
      border 0
      box-shadow none
      background transparent
      color #3c5774
      font-size 13px

      &::placeholder
        color #9aabbe

  .homework-list-note
    display flex
    justify-content space-between
    gap 10px
    margin 0 0 12px
    color #8d9db1
    font-size 12px
    line-height 1.6

  .homework-roster, .homework-assignment-list, .homework-hub__list
    display grid
    gap 10px
    list-style none
    margin 0
    padding 0

  .homework-roster__card, .homework-assignment
    border 1px solid #e0e9f4
    border-radius 12px
    background #fff
    transition border-color .15s ease

    &:has([aria-expanded="true"])
      border-color #b9d5f2

  .homework-roster__student
    display grid
    grid-template-columns 42px minmax(120px, 1fr) minmax(140px, 210px) 110px 16px
    align-items center
    width 100%
    gap 20px
    padding 17px 20px
    border 0
    border-radius 12px
    color inherit
    background transparent
    cursor pointer
    text-align left

    &:hover, &[aria-expanded="true"]
      background #f8fbff

  .homework-roster__avatar
    width 42px
    height 42px
    border-radius 12px
    object-fit cover
    border 1px solid #e9eef5

  .homework-roster__identity
    display grid
    gap 5px
    min-width 0

  .homework-roster__name, .homework-assignment__title, .homework-hub__title
    display block
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    color #294868
    font-size 15px
    font-weight 750

  .homework-roster__meta, .homework-assignment__meta, .homework-hub__meta
    color #8a9db2
    font-size 12px

  .homework-roster__progress
    display grid
    gap 8px

  .homework-roster__progress-caption, .homework-hub__progress-caption
    display flex
    align-items center
    justify-content space-between
    gap 16px
    color #8b9db2
    font-size 12px

    strong
      color #4589cd
      font-size 13px
      font-weight 750

  .homework-meter
    display block
    width 100%
    height 5px
    border-radius 999px
    background #edf2f8
    overflow hidden

    > span
      display block
      height 100%
      border-radius inherit
      background linear-gradient(90deg, #4f95e9, #7cbeee)
      box-shadow 0 0 7px rgba(88, 161, 236, .2)

  .is-done .homework-meter > span
    background linear-gradient(90deg, #47af98, #80d4b9)

  .homework-status
    justify-self end
    padding 6px 10px
    border-radius 7px
    color #af7e42
    background #fff7ec
    font-size 12px
    font-weight 650
    white-space nowrap

    &.is-done
      color #419a7c
      background #edf8f3

  .homework-chevron
    color #a0b3c9
    font-size 12px
    transition transform .18s ease

  [aria-expanded="true"] .homework-chevron
    transform rotate(180deg)

  .homework-roster__details
    padding 20px
    border-top 1px solid #edf2f7

  .homework-detail-label
    display block
    margin 0 0 10px
    color #7a91aa
    font-size 12px
    font-weight 650

  .homework-roster__assignments
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 10px
    margin 0
    padding 0
    list-style none

  a.homework-roster__assignment
    display grid
    grid-template-columns minmax(0, 1fr) auto
    gap 10px 14px
    padding 13px 15px
    border 1px solid #e6edf6
    border-radius 9px
    background #fbfdff

    &:hover
      border-color #a7caee
      background #f5faff

    .homework-meter
      grid-column 1 / -1
      height 4px

  .homework-roster__assignment-title
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    color #466785
    font-size 13px
    font-weight 650

  .homework-roster__assignment-score
    color #8da3bb
    font-size 12px

    span
      margin-left 9px
      color #6d9ecf

  .homework-roster__done-note
    margin 0
    color #4a9a7e
    font-size 13px

  .homework-completed-fold
    margin-top 17px
    padding-top 14px
    border-top 1px solid #eef2f6

    summary
      display list-item
      color #7b9b8c
      font-size 12px
      cursor pointer

      span
        margin-left 8px
        color #a0b2a9
        font-size 11px

    ul
      display grid
      grid-template-columns repeat(2, minmax(0, 1fr))
      gap 8px
      list-style none
      margin 12px 0 0
      padding 0

    a
      display flex
      align-items center
      gap 8px
      padding 10px 12px
      color #6c8e7e
      background #f7fbf9
      border-radius 7px
      font-size 12px

      span:nth-child(2)
        flex 1
        overflow hidden
        text-overflow ellipsis
        white-space nowrap

  .homework-category
    display flex
    align-items center
    gap 10px
    margin 0
    color #7d93ac
    font-size 13px

    select
      min-width 170px
      max-width 280px
      height 40px
      margin 0
      padding 0 34px 0 12px
      border 1px solid #dfe8f2
      border-radius 9px
      color #456280
      background-color #fafcfe

  .homework-assignment-search
    display flex
    gap 8px

  .homework-assignment__trigger
    display grid
    grid-template-columns 42px minmax(0, 1fr) 160px 16px
    align-items center
    gap 18px
    width 100%
    padding 18px 20px
    border 0
    border-radius 12px
    background transparent
    cursor pointer
    text-align left

    &:hover, &[aria-expanded="true"]
      background #f8fbff

  .homework-assignment__icon, .homework-hub__icon
    display flex
    align-items center
    justify-content center
    width 42px
    height 42px
    border-radius 12px
    color #5c94d5
    background #edf5ff
    font-size 18px

  .homework-assignment__content
    display grid
    gap 7px
    min-width 0

  .homework-assignment__completion
    display grid
    gap 9px
    text-align right
    color #8b9fb7
    font-size 12px

    strong
      color #417cba
      font-size 15px

  .homework-assignment__details
    display grid
    grid-template-columns minmax(0, 1fr) minmax(230px, 320px)
    gap 24px
    padding 20px
    border-top 1px solid #edf2f7

  .homework-student-chips
    display flex
    flex-wrap wrap
    gap 7px

    a
      display flex
      gap 12px
      padding 6px 9px
      border 1px solid #e1eaf5
      border-radius 6px
      color #5e7e9e
      font-size 12px

      &:hover
        border-color #a5c9ef
        color #357bc4

      span
        color #a8b9ca

  .homework-assignment__none
    color #98aabd
    font-size 12px

  .homework-assignment__completed
    margin 14px 0 0
    color #79a18d
    font-size 12px
    line-height 1.8

  .homework-assignment__quick-add
    margin 0

    > div
      display flex
      gap 8px

    .textbox
      width 100%
      min-width 0
      height 38px
      margin 0
      border-radius 8px
      font-size 12px

    .button
      flex-shrink 0
      height 38px
      line-height 36px
      font-size 12px

  .homework-assignment__links
    display flex
    justify-content flex-end
    gap 18px
    margin-top 14px
    font-size 12px

    a
      color #6396c8

  .homework-hub__card
    display grid
    grid-template-columns 48px minmax(0, 1fr) auto
    align-items center
    gap 20px
    padding 22px
    border 1px solid #e0e9f4
    border-radius 13px
    background #fff
    transition border-color .15s ease, box-shadow .15s ease

    &:hover
      border-color #a2c9f0
      box-shadow 0 6px 18px rgba(41, 105, 177, .06)

    .homework-hub__icon
      width 48px
      height 48px
      border-radius 14px

    &.is-done
      .homework-hub__icon
        color #52a388
        background #eff9f4

      .homework-hub__continue
        color #73a28d
        background #f1f9f5

  .homework-hub__content
    display grid
    gap 10px
    min-width 0

    .homework-hub__title
      font-size 16px

  .homework-hub__continue
    margin-left 16px
    padding 11px 15px
    border-radius 9px
    color #4d89c8
    background #edf5ff
    font-size 13px
    font-weight 650
    white-space nowrap

  .homework-hub__empty
    display grid
    justify-items center
    gap 10px
    padding 56px 20px
    text-align center
    color #93a5b9
    font-size 13px

    > .icon
      display flex
      justify-content center
      align-items center
      width 54px
      height 54px
      margin-bottom 8px
      border-radius 18px
      color #87add8
      background #f0f6fd
      font-size 23px

    strong
      color #5b7896
      font-size 15px
      font-weight 650

    p
      margin 0
      line-height 1.8

    &.is-success > .icon
      color #65af93
      background #eef9f4

  .homework-text-button
    padding 5px
    border 0
    background transparent
    color #548fcd
    cursor pointer
    font-size 13px

  button:focus-visible, a:focus-visible, summary:focus-visible
    outline 3px solid rgba(77, 152, 236, .4)
    outline-offset 3px

  .pager
    margin 24px 0 0

  @media (max-width: 900px)
    .homework-roster__student
      gap 14px
      grid-template-columns 42px minmax(110px, 1fr) minmax(100px, 150px) 90px 12px

    .homework-roster__assignments
      grid-template-columns 1fr

    .homework-hub__hero, .homework-hub__body
      padding-left 22px
      padding-right 22px

  @media (max-width: 640px)
    .homework-hub__hero
      padding 20px 16px
      align-items flex-start

      h1
        font-size 24px

      p:not(.homework-hub__eyebrow)
        max-width 210px
        font-size 12px
        line-height 1.6

      .homework-hub__create
        margin-top 12px
        padding 0 11px
        font-size 12px
        height 36px
        line-height 34px

    .homework-hub__body
      padding 18px 14px 22px

    .homework-admin__nav
      width auto
      display grid
      grid-template-columns repeat(2, minmax(0, 1fr))
      margin-bottom 18px

    a.homework-admin__nav-link
      padding 10px 12px
      justify-content center
      font-size 13px

    .homework-toolbar
      gap 12px

    .homework-search
      width 100%

    .homework-list-note
      flex-wrap wrap
      font-size 11px

    .homework-roster__student
      grid-template-columns 38px minmax(0, 1fr) auto 12px
      gap 8px 12px
      padding 15px 13px

    .homework-roster__avatar
      width 38px
      height 38px
      grid-row 1

    .homework-roster__progress
      grid-row 2
      grid-column 2 / 4
      gap 5px

    .homework-roster__meta
      font-size 10px

    .homework-status
      grid-column 3
      grid-row 1
      font-size 10px
      padding 5px 7px

    .homework-roster__student .homework-chevron
      grid-column 4
      grid-row 1

    .homework-roster__details
      padding 15px 13px

    .homework-completed-fold ul
      grid-template-columns 1fr

    .homework-assignment-search
      width 100%

    .homework-category, .homework-category select
      width 100%
      max-width none

    .homework-assignment__trigger
      grid-template-columns 38px minmax(0, 1fr) 12px
      gap 10px 12px
      padding 15px 13px

    .homework-assignment__completion
      grid-column 2
      grid-row 2
      text-align left
      gap 6px

    .homework-assignment__trigger .homework-chevron
      grid-row 1
      grid-column 3

    .homework-assignment__details
      grid-template-columns 1fr
      gap 18px
      padding 16px

    .homework-hub__card
      grid-template-columns 38px minmax(0, 1fr)
      gap 12px
      padding 16px

      .homework-hub__icon
        width 38px
        height 38px
        border-radius 11px

    .homework-hub__content .homework-hub__title
      font-size 14px

    .homework-hub__continue
      grid-column 2
      justify-self start
      margin-left 0
      padding 8px 11px
      font-size 12px

    .homework-hub__empty
      padding 36px 12px

  @media (prefers-reduced-motion: reduce)
    .homework-admin__nav, .homework-admin__content
      transition none

    .is-homework-view-entering
      animation none

@keyframes homework-view-in
  from
    opacity 0
    transform translateY(6px)
  to
    opacity 1
    transform translateY(0)
