.achievement-manage, .achievement-wall, .achievement-preview
  --achievement-ink: #29364d
  --achievement-muted: #69798e
  --achievement-line: #e5eaf1
  --achievement-paper: #ffffff
  --achievement-soft: #f5f7fa
  --achievement-gold: #9c7836
  --achievement-tint: #fbf6e9
  color: var(--achievement-ink)
  font-family: inherit
  *, *::before, *::after
    box-sizing: border-box
  [hidden]
    display: none !important
  button, input, select
    font: inherit
  button, select
    cursor: pointer
  button:disabled, input:disabled
    cursor: wait
    opacity: .55
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible
    outline: 3px solid #6e9de4
    outline-offset: 3px

.achievement-sound
  margin-bottom: 22px
  padding: 19px 20px 16px
  border: 1px solid var(--achievement-line)
  border-radius: 12px
  background: var(--achievement-soft)
  &__heading
    display: flex
    align-items: flex-start
    gap: 12px
    h2
      display: flex
      align-items: center
      flex-wrap: wrap
      gap: 10px
      font-size: 16px
      font-weight: 650
      span
        padding: 2px 7px
        border-radius: 5px
        color: var(--achievement-gold)
        background: var(--achievement-tint)
        font-size: 10px
        font-weight: 400
    p
      margin-top: 4px !important
      color: var(--achievement-muted)
      font-size: 11px
      line-height: 1.8
  &__mark
    display: grid
    flex: 0 0 35px
    height: 35px
    place-items: center
    border: 1px solid var(--achievement-line)
    border-radius: 10px
    color: var(--achievement-gold)
    background: var(--achievement-paper)
    font-size: 24px
    line-height: 1
  &__file-row
    display: flex
    align-items: center
    justify-content: space-between
    flex-wrap: wrap
    gap: 12px 20px
    margin: 19px 0 16px
  &__file
    min-width: 0
    flex: 1 1 230px
    > span
      display: block
      overflow: hidden
      text-overflow: ellipsis
      white-space: nowrap
      color: var(--achievement-ink)
      font-size: 12px
    small
      display: block
      margin-top: 4px
      color: var(--achievement-muted)
      font-size: 10px
      line-height: 1.6
  &__actions
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 9px
    form
      margin: 0
    .achievement-manage__upload
      margin: 0
  &__button
    min-height: 33px
    padding: 6px 11px
    border: 1px solid var(--achievement-line)
    border-radius: 7px
    color: var(--achievement-ink)
    background: var(--achievement-paper)
    font-size: 12px !important
    line-height: 1.5
    &[aria-pressed=true]
      border-color: #c5ab76
      color: var(--achievement-gold)
      background: var(--achievement-tint)
    &:disabled
      cursor: default
    &--save
      color: #fff
      border-color: #405d85
      background: #405d85
  &__settings
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 14px 24px
    margin: 0
    padding-top: 16px
    border-top: 1px solid var(--achievement-line)
  &__enabled
    display: inline-flex
    align-items: center
    gap: 8px
    margin: 0
    color: var(--achievement-ink)
    font-size: 12px
    cursor: pointer
    input
      width: 15px
      height: 15px
      margin: 0
      accent-color: #5777a4
  &__volume
    display: flex
    align-items: center
    gap: 10px
    flex: 1 1 180px
    max-width: 220px
    margin: 0
    color: var(--achievement-muted)
    font-size: 11px
    > span
      white-space: nowrap
    input
      width: 100%
      min-width: 65px
      height: 18px
      margin: 0
      padding: 0
      accent-color: #5777a4
      cursor: pointer
    output
      flex: 0 0 34px
      text-align: right
      font-variant-numeric: tabular-nums
  &__save
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 10px
    margin-left: auto
    > span
      color: var(--achievement-muted)
      font-size: 10px
  &__status
    margin-top: 12px !important
    color: #366b55
    font-size: 11px
    &.is-error
      color: #a44343

.achievement-manage
  padding: 28px
  border: 1px solid var(--achievement-line)
  border-radius: 18px
  background: var(--achievement-paper)
  line-height: 1.6
  h1, h2, h3, p
    margin: 0
  &__header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 16px
    padding-bottom: 24px
  &__back
    display: inline-block
    color: var(--achievement-muted)
    font-size: 12px
    margin-bottom: 22px
    text-decoration: none
    &:hover
      color: var(--achievement-gold)
  &__eyebrow
    color: var(--achievement-gold)
    font-size: 11px
    letter-spacing: 2px
    font-weight: 600
    margin-bottom: 6px !important
  h1
    display: flex
    align-items: center
    gap: 12px
    font-size: 28px
    font-weight: 700
    letter-spacing: 1px
    span
      padding: 2px 9px
      border: 1px solid #e9dcc2
      border-radius: 7px
      color: var(--achievement-gold)
      background: var(--achievement-tint)
      font-size: 12px
      letter-spacing: 0
  &__intro
    color: var(--achievement-muted)
    font-size: 13px
    margin-top: 9px !important
  &__hero-mark
    display: grid
    place-items: center
    flex: 0 0 96px
    height: 96px
    margin-top: 20px
    color: #b29455
    font-size: 64px
    background: radial-gradient(circle, #f8edd2 0, #faf7ef 44%, transparent 70%)
    text-shadow: 0 5px 20px #ddc99d
  &__note
    display: flex
    align-items: flex-start
    gap: 12px
    padding: 15px 17px
    border: 1px solid #e9e3d4
    border-radius: 11px
    background: var(--achievement-tint)
    font-size: 12px
    p
      display: grid
      gap: 3px
    strong
      color: var(--achievement-ink)
      font-weight: 600
    p > span
      color: var(--achievement-muted)
  &__note-mark
    color: var(--achievement-gold)
    font-size: 26px
    line-height: 1.2
  &__toolbar
    display: flex
    align-items: center
    gap: 12px
    margin-top: 25px
  &__search
    display: flex
    align-items: center
    gap: 9px
    flex: 1 1 auto
    min-width: 0
    padding: 0 12px
    border: 1px solid var(--achievement-line)
    border-radius: 9px
    background: var(--achievement-soft)
    color: var(--achievement-muted)
    &:focus-within
      border-color: #8faed7
    input
      width: 100%
      min-width: 0
      height: 41px
      color: var(--achievement-ink)
      background: transparent
      border: 0
      font-size: 13px
      &:focus-visible
        outline: none
  &__image-filter
    display: flex
    align-items: center
    gap: 8px
    flex: 0 0 auto
    color: var(--achievement-muted)
    font-size: 12px
    > span
      white-space: nowrap
    select
      width: auto
      height: 41px
      border: 1px solid var(--achievement-line)
      border-radius: 9px
      padding: 0 27px 0 12px
      color: var(--achievement-ink)
      background-color: var(--achievement-paper)
  &__filters
    display: flex
    flex-wrap: wrap
    gap: 7px
    margin: 16px 0 12px
    button
      display: inline-flex
      align-items: center
      gap: 6px
      padding: 7px 10px
      border: 1px solid transparent
      border-radius: 7px
      background: var(--achievement-soft)
      color: var(--achievement-muted)
      font-size: 12px
      line-height: 1.4
      transition: background .15s, color .15s
      span
        font-size: 10px
        opacity: .7
      &:hover
        color: var(--achievement-ink)
      &[aria-pressed=true]
        background: #eaf0fa
        color: #375e94
        border-color: #d6e1f2
  &__results
    display: flex
    align-items: center
    justify-content: space-between
    gap: 10px
    padding: 7px 0 18px
    color: var(--achievement-muted)
    font-size: 11px
  &__status
    padding: 10px 14px
    margin-bottom: 16px !important
    border-radius: 8px
    color: #366b55
    background: #eef8f1
    font-size: 12px
    &.is-error
      color: #a44343
      background: #fff2f1
  &__group
    margin-top: 24px
    &:first-of-type
      margin-top: 4px
    > h2
      display: flex
      align-items: center
      gap: 9px
      margin-bottom: 12px
      color: var(--achievement-ink)
      font-size: 15px
      font-weight: 600
      &::before
        content: ''
        width: 3px
        height: 14px
        border-radius: 3px
        background: #c8ad74
      span
        margin-left: 1px
        font-size: 11px
        font-weight: 400
        color: var(--achievement-muted)
  &__grid
    display: grid
    grid-template-columns: repeat(3, minmax(0, 1fr))
    gap: 14px
  &__card
    min-width: 0
    overflow: hidden
    border: 1px solid var(--achievement-line)
    border-radius: 12px
    background: var(--achievement-paper)
    transition: border-color .2s, box-shadow .2s
    &:hover, &:focus-within
      border-color: #c9d5e4
      box-shadow: 0 5px 18px rgba(30, 50, 80, .045)
    &[aria-busy=true]
      border-color: #9cb6da
  &__art
    position: relative
    display: flex
    align-items: center
    justify-content: center
    height: 140px
    background: radial-gradient(ellipse at 50% 55%, #f5f0e5, #fafbfc 74%)
    img
      display: block
      width: 112px
      height: 112px
      object-fit: contain
      filter: drop-shadow(0 7px 9px rgba(45, 55, 75, .12))
  &__placeholder
    font-size: 56px
    color: #d2c9b4
    text-shadow: 0 4px 18px rgba(199, 180, 137, .12)
  &__image-state
    position: absolute
    top: 10px
    left: 10px
    border-radius: 5px
    padding: 2px 6px
    color: #888474
    background: rgba(255, 255, 255, .8)
    font-size: 10px
    letter-spacing: .3px
  &__card.has-image &__image-state
    color: #5b7c69
  &__preview
    position: absolute
    right: 9px
    bottom: 9px
    border: 1px solid #e0e5eb
    border-radius: 5px
    padding: 4px 7px
    background: rgba(255, 255, 255, .9)
    color: #53677f
    font-size: 11px
  &__card-body
    padding: 13px 13px 14px
    border-top: 1px solid var(--achievement-line)
    h3
      font-size: 15px
      font-weight: 650
      letter-spacing: .5px
    > p:first-of-type
      min-height: 36px
      margin-top: 5px
      font-size: 11px
      line-height: 1.6
      color: var(--achievement-muted)
    form
      display: inline-block
      margin: 10px 4px 0 0
  &__upload
    position: relative
    display: inline-flex
    align-items: center
    gap: 5px
    min-height: 32px
    overflow: hidden
    border: 1px solid #dbe4f0
    border-radius: 6px
    padding: 4px 9px
    color: #41628f
    background: #f4f7fc
    font-size: 11px
    cursor: pointer
    &:hover
      background: #eaf0fa
      border-color: #bdcee4
    &:focus-within
      outline: 3px solid #6e9de4
      outline-offset: 2px
    input
      position: absolute
      inset: 0
      width: 100%
      height: 100%
      opacity: 0
      cursor: pointer
  &__remove
    padding: 6px 0
    border: 0
    color: var(--achievement-muted)
    background: transparent
    font-size: 10px
    &:hover
      color: #b45a5a
  &__card-status
    margin-top: 8px !important
    font-size: 11px
    color: #477a60
    &.is-error
      color: #b35454
  &__empty
    padding: 64px 16px
    text-align: center
    > span
      color: #9dafc6
      font-size: 42px
    h2
      font-size: 17px
      font-weight: 600
    p
      margin: 8px 0 20px
      font-size: 12px
      color: var(--achievement-muted)
    button
      padding: 7px 13px
      border: 1px solid var(--achievement-line)
      border-radius: 7px
      background: var(--achievement-soft)
      color: var(--achievement-ink)
      font-size: 12px

.achievement-preview
  width: 480px
  max-width: calc(100vw - 32px)
  max-height: calc(100vh - 32px)
  padding: 28px
  overflow-y: auto
  border: 1px solid var(--achievement-line)
  border-radius: 18px
  background: var(--achievement-paper)
  text-align: center
  box-shadow: 0 24px 100px rgba(7, 15, 30, .3)
  &::backdrop
    background: rgba(16, 27, 47, .65)
    backdrop-filter: blur(7px)
  &__close
    position: absolute
    right: 13px
    top: 9px
    width: 32px
    height: 32px
    border: 0
    border-radius: 50%
    color: var(--achievement-muted)
    background: var(--achievement-soft)
    font-size: 23px !important
  &__art
    display: grid
    place-items: center
    min-height: 200px
    margin: 8px 0 24px
    border-radius: 12px
    background: radial-gradient(ellipse, var(--achievement-tint), var(--achievement-paper) 70%)
    img
      display: block
      max-width: 100%
      width: 300px
      height: 300px
      max-height: 45vh
      object-fit: contain
  &__eyebrow
    margin: 0 0 7px !important
    color: var(--achievement-gold)
    font-size: 11px
    letter-spacing: 2px
  h2
    font-size: 24px
    font-weight: 650
    margin: 0 0 10px
  > p:last-child
    color: var(--achievement-muted)
    font-size: 13px
    line-height: 1.6

// Hydro's base label:not(...) rule otherwise turns these inline controls into blocks.
.achievement-manage label.achievement-manage__search,
.achievement-manage label.achievement-manage__image-filter,
.achievement-manage label.achievement-sound__volume
  display: flex

.achievement-manage label.achievement-manage__upload,
.achievement-manage label.achievement-sound__enabled
  display: inline-flex

.achievement-wall
  position: relative
  margin: 18px 0 24px
  border: 1px solid var(--achievement-line)
  border-radius: 13px
  padding: 18px 15px 14px
  background: linear-gradient(160deg, var(--achievement-paper), var(--achievement-soft))
  &__header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 6px
    h2
      margin: 0
      font-size: 16px
      font-weight: 650
      letter-spacing: 1px
      span
        color: #b09357
        padding-right: 3px
  &__count
    white-space: nowrap
    color: var(--achievement-muted)
    font-size: 11px
    letter-spacing: .5px
    font-variant-numeric: tabular-nums
    strong
      display: inline-block
      min-width: 2ch
      text-align: right
      color: var(--achievement-gold)
      font-size: 16px
      &.is-counting
        animation: achievement-wall-count-rise .12s ease-out both
  &__intro
    margin: 8px 0 15px
    color: var(--achievement-muted)
    font-size: 10px
    letter-spacing: .3px
  &__grid
    display: grid
    grid-template-columns: repeat(4, minmax(0, 1fr))
    align-content: start
    gap: 8px
    padding: 4px
    margin: 0 -4px
  &__item
    position: relative
    display: flex
    align-items: center
    justify-content: center
    min-width: 0
    width: 100%
    aspect-ratio: 1
    border: 1px solid transparent
    border-radius: 9px
    padding: 3px
    background: transparent
    transition: transform .2s, background .2s, border-color .2s
    &.is-entering
      animation: achievement-wall-item-enter .18s cubic-bezier(.2, .75, .3, 1) both
    img
      display: block
      width: 100%
      height: 100%
      object-fit: contain
      filter: drop-shadow(0 3px 4px rgba(44, 60, 89, .13))
    &:hover, &.is-active
      transform: translateY(-2px)
      border-color: #e8dbbe
      background: var(--achievement-tint)
  &__hint
    margin: 14px 0 0
    color: var(--achievement-muted)
    font-size: 10px
    text-align: center
    line-height: 1.6
  &__empty
    padding: 25px 0 14px
    text-align: center
    > span
      display: block
      margin-bottom: 14px
      color: #c5b17f
      font-size: 46px
    strong
      display: block
      color: var(--achievement-ink)
      font-size: 11px
      font-weight: 500
    p
      margin: 9px 0 0
      color: var(--achievement-muted)
      font-size: 10px
      line-height: 1.9
  &__tooltip
    position: fixed
    z-index: 12000
    width: 228px
    max-width: calc(100vw - 24px)
    padding: 15px 17px
    border: 1px solid #d7c799
    border-radius: 11px
    background: #243149
    color: #f5f2e9
    box-shadow: 0 12px 32px rgba(15, 27, 48, .22)
    line-height: 1.6
    strong
      display: block
      margin: 5px 0
      font-size: 16px
      font-weight: 600
      letter-spacing: .5px
    p
      margin: 0
      color: #d4deed
      font-size: 12px
    small
      display: block
      margin-top: 10px
      padding-top: 8px
      border-top: 1px solid rgba(226, 232, 241, .15)
      color: #a6b6d0
      font-size: 10px
  &__tooltip-eyebrow
    color: #ddc794
    font-size: 10px
    letter-spacing: 1px

// Keep the heading visible; only ready tiles take up room in the growing grid.
.hasjs .achievement-wall [data-achievement-pending]
  display: none

.hasjs .achievement-wall [data-achievement-grid-empty]
  padding: 0
  margin: 0

@keyframes achievement-wall-item-enter
  from
    opacity: 0
    transform: translateY(6px) scale(.88)
  to
    opacity: 1
    transform: translateY(0) scale(1)

@keyframes achievement-wall-count-rise
  from
    opacity: .55
    transform: translateY(2px)
  to
    opacity: 1
    transform: translateY(0)

.homepage-personal .achievement-wall
  margin: 18px 0 0
  padding: 20px 0 0
  border: 0
  border-top: 1px solid var(--achievement-line)
  border-radius: 0
  background: none
  &__grid
    grid-template-columns: repeat(auto-fill, minmax(54px, 1fr))
    gap: 8px
  &__header h2
    font-size: 17px

.badge-manage__achievements
  display: flex
  align-items: center
  justify-content: space-between
  gap: 16px
  padding: 17px 19px
  margin-bottom: 16px
  border: 1px solid #e5dcbd
  border-radius: 12px
  background: linear-gradient(110deg, #fffcf2, #f8f9ff)
  color: #6b6559
  text-decoration: none
  transition: border-color .2s
  &:hover
    border-color: #c9af76
  strong
    display: block
    color: #55452e
    font-size: 16px
  span > span
    display: block
    margin-top: 5px
    font-size: 13px
  > span:last-child
    font-size: 24px
  &:focus-visible
    outline: 3px solid #6e9de4
    outline-offset: 3px

.theme--dark
  .achievement-manage, .achievement-wall, .achievement-preview
    --achievement-ink: #e2eaf4
    --achievement-muted: #a4b1c4
    --achievement-line: #344155
    --achievement-paper: #202b3b
    --achievement-soft: #273447
    --achievement-gold: #d3b979
    --achievement-tint: #363529
  .achievement-manage__note
    border-color: #514c3a
  .achievement-manage__art
    background: radial-gradient(ellipse at 50% 55%, #3b3a33, #263244 74%)
  .achievement-manage__placeholder
    color: #8c8165
  .achievement-manage__hero-mark
    background: radial-gradient(circle, #4b4635 0, #2e3440 44%, transparent 70%)
  .achievement-manage__filters button[aria-pressed=true]
    color: #bad0ef
    background: #354d70
    border-color: #48678f
  .achievement-manage__upload
    color: #b5c9e8
    background: #2d405a
    border-color: #456083
  .achievement-manage__status
    color: #b4d9c3
    background: #294138
  .achievement-manage__card-status
    color: #a3ceb6
    &.is-error
      color: #efabab
  .achievement-sound__status
    color: #a3ceb6
    &.is-error
      color: #efabab
  .badge-manage__achievements
    background: linear-gradient(110deg, #39392f, #293448)
    border-color: #615638
    color: #c4c3b9
    strong
      color: #e6d3a5

@media (max-width: 1000px)
  .achievement-manage
    padding: 21px
  .achievement-manage__grid
    grid-template-columns: repeat(2, minmax(0, 1fr))
  .achievement-wall
    padding: 16px 11px 12px
  .achievement-wall__grid
    gap: 5px
    grid-template-columns: repeat(3, minmax(0, 1fr))

@media (max-width: 640px)
  .achievement-sound
    padding: 16px 13px
  .achievement-sound__mark
    display: none
  .achievement-sound__file-row
    gap: 12px
  .achievement-sound__file
    flex-basis: 100%
  .achievement-sound__settings
    gap: 13px
  .achievement-sound__enabled
    flex-basis: 100%
  .achievement-sound__volume
    max-width: none
  .achievement-sound__save
    justify-content: flex-end
    flex-basis: 100%
  .achievement-manage
    padding: 17px 14px
    border-radius: 12px
  .achievement-manage h1
    font-size: 25px
  .achievement-manage__hero-mark
    display: none
  .achievement-manage__toolbar
    flex-wrap: wrap
  .achievement-manage__search
    flex-basis: 100%
  .achievement-manage__image-filter
    width: 100%
    justify-content: flex-end
  .achievement-manage__grid
    gap: 10px
  .achievement-manage__art
    height: 125px
  .achievement-manage__art img
    width: 96px
    height: 96px
  .achievement-manage__card-body
    padding: 12px 10px
  .achievement-manage__card-body h3
    font-size: 14px
  .achievement-manage__card-body form
    margin-right: 0
  .achievement-wall
    padding: 20px 17px 16px
  .achievement-wall__grid
    grid-template-columns: repeat(5, minmax(0, 1fr))
    gap: 9px

@media (max-width: 360px)
  .achievement-manage__grid
    grid-template-columns: minmax(0, 1fr)
  .achievement-wall__grid
    grid-template-columns: repeat(4, minmax(0, 1fr))

@media (prefers-reduced-motion: reduce)
  .achievement-wall, .achievement-wall__item, .achievement-manage__card
    transition: none
  .achievement-wall__item.is-entering, .achievement-wall__count strong.is-counting
    animation: none
  .achievement-wall__item:hover, .achievement-wall__item.is-active
    transform: none
